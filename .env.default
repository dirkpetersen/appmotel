# Let's Encrypt configuration
USE_LETSENCRYPT=no       # yes or no
LETSENCRYPT_EMAIL=""      # optional, for expiry notices (example.com addresses are rejected)
LETSENCRYPT_MODE="http"  # or "dns" for Route53
BASE_DOMAIN="apps.yourdomain.edu"

# AWS Route53 configuration (only needed for DNS-01 challenge)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_HOSTED_ZONE_ID=""

# Who may run appmo / control the appmotel user without a password (applied by
# `sudo bash install.sh`). User names, %groups (comma or space separated), or
# ALL for every user on the machine. Unset keeps an existing ALL grant, else "apps".
# ALL lets any local user act as appmotel (deploy apps, read app secrets): use it
# only on machines where every login is trusted.
# The group appmotel-ops is always an operator too: sudo usermod -aG appmotel-ops <user>
# OPERATOR_USERS="apps"

# Listen on one IP only for ports 80 and 443 (for example on a server with a
# second NIC for storage). Unset: all addresses, but an IP that traefik.yaml
# already binds to is kept. Apply with: appmo self-update
# APPMOTEL_BIND_IP="192.0.2.40"

# Chat webhook (Slack format; Mattermost, Rocket.Chat and Google Chat work too)
# for deploys, failed updates, rollbacks, crash loops and expiring certificates.
# An app's own NOTIFY_WEBHOOK_URL in its .env wins; isolated apps can only use
# their own, they cannot read this file.
# NOTIFY_WEBHOOK_URL="https://hooks.slack.com/services/..."
# Warn this many days before a TLS certificate expires (default 14)
# TLS_EXPIRY_WARN_DAYS=14

# Timezone (auto-detected during install, or set manually)
# Examples: America/Los_Angeles, America/New_York, Europe/London, Asia/Tokyo
TZ="UTC"
