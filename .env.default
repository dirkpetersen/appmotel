# Let's Encrypt configuration
USE_LETSENCRYPT=no       # yes or no
LETSENCRYPT_EMAIL="your-email@example.com"
LETSENCRYPT_MODE="http"  # or "dns" for Route53
BASE_DOMAIN="apps.yourdomain.edu"

# AWS Route53 configuration (only needed for DNS-01 challenge)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_HOSTED_ZONE_ID=""

# Who may run appmo / control the appmotel user without a password (applied by
# `sudo bash install.sh`). User names, %groups (comma or space separated), or
# ALL for every user on the machine. Unset keeps an existing ALL grant, else "apps".
# ALL lets any local user act as appmotel (deploy apps, read app secrets): use it
# only on machines where every login is trusted.
# OPERATOR_USERS="apps"

# Timezone (auto-detected during install, or set manually)
# Examples: America/Los_Angeles, America/New_York, Europe/London, Asia/Tokyo
TZ="UTC"
