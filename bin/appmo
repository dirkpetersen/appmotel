#!/usr/bin/env bash

# -----------------------------------------------------------------------------
# Script Name: appmo
# Description: CLI tool for managing Appmotel applications
# -----------------------------------------------------------------------------

set -o errexit
set -o nounset
set -o pipefail
IFS=$'\n\t'

# -----------------------------------------------------------------------------
# Function: cleanup_temp_files
# Description: Remove all tracked temp files on exit
# -----------------------------------------------------------------------------
cleanup_temp_files() {
  # Clean by PID-scoped pattern rather than a tracked array: create_temp_file
  # is always called via $(...), so an array append would only mutate the
  # subshell's copy and the parent would have nothing to clean. $$ is the
  # main shell PID even inside command substitutions, so the pattern is safe.
  rm -f /tmp/appmo."$$".* 2>/dev/null || true
}
trap cleanup_temp_files EXIT

# -----------------------------------------------------------------------------
# Function: create_temp_file
# Description: Create a temp file that cleanup_temp_files removes on exit
# -----------------------------------------------------------------------------
create_temp_file() {
  local prefix="${1:-tmp}"
  mktemp "/tmp/appmo.$$.${prefix}.XXXXXX"
}

# Constants
readonly APPMOTEL_USER="appmotel"
readonly APPMOTEL_HOME="/home/${APPMOTEL_USER}"
readonly APPMOTEL_CONFIG_DIR="${APPMOTEL_HOME}/.config/appmotel"
readonly APPMOTEL_ENV_FILE="${APPMOTEL_CONFIG_DIR}/.env"
readonly TRAEFIK_DYNAMIC_DIR="${APPMOTEL_HOME}/.config/traefik/dynamic"
readonly MIN_PORT=10001
readonly MAX_PORT=59999

# Isolated apps run as their own Linux user "a-<app>" (created by the root
# helper appmotel-user, member of APP_USERS_GROUP). Run by such a user, appmo
# works in "app" role: it manages only the apps in that user's own home and
# never elevates to appmotel. Traefik routes stay with appmotel.
readonly APP_USER_PREFIX="a-"
readonly APP_USERS_GROUP="appmotel-apps"
APPMO_ROLE="admin"
APPMO_HOME="${APPMOTEL_HOME}"
if [[ "$(id -un)" == "${APP_USER_PREFIX}"* ]] && id -nG | grep -qw "${APP_USERS_GROUP}"; then
  APPMO_ROLE="app"
  APPMO_HOME=$(getent passwd "$(id -un)" | cut -d: -f6)
fi
readonly APPMO_ROLE APPMO_HOME
readonly APPS_CONFIG_DIR="${APPMO_HOME}/.config/appmotel"
readonly APPS_DATA_DIR="${APPMO_HOME}/.local/share/appmotel"
readonly SYSTEMD_USER_DIR="${APPMO_HOME}/.config/systemd/user"
readonly BACKUPS_DIR="${APPMO_HOME}/.local/share/appmotel-backups"

# -----------------------------------------------------------------------------
# Ensure appmotel's local bin dirs are on PATH regardless of how this script
# was invoked (direct call as appmotel, `sudo -u appmotel appmo ...`, or the
# auto-elevation below). sudo's env_reset resets PATH to secure_path, which
# does not include ${APPMOTEL_HOME}/.local/bin — the directory holding the
# traefik binary, this script itself, and any per-app tooling.
# -----------------------------------------------------------------------------
case ":${PATH}:" in
  *":${APPMOTEL_HOME}/.local/bin:"*) ;;
  *) PATH="${APPMOTEL_HOME}/.local/bin:${APPMOTEL_HOME}/bin:${PATH}:/usr/local/go/bin" ;;
esac
export PATH

# -----------------------------------------------------------------------------
# Auto-elevate to the appmotel user
# Description: appmo operates on the appmotel user's files and `systemctl
# --user` services, so any invocation by another user (including root)
# transparently re-execs as appmotel via sudo. A small set of user-specific
# commands are exempted and run as the invoking user instead, so callers
# never need to type `sudo -u appmotel` themselves.
# -----------------------------------------------------------------------------
readonly APPMO_LOCAL_COMMANDS=(skill -h --help help)
if [[ "$(id -un)" != "${APPMOTEL_USER}" ]] && [[ "${APPMO_ROLE}" != "app" ]]; then
  appmo_elevate=1
  if [[ $# -eq 0 ]]; then
    appmo_elevate=0
  else
    for appmo_local_cmd in "${APPMO_LOCAL_COMMANDS[@]}"; do
      if [[ "$1" == "${appmo_local_cmd}" ]]; then
        appmo_elevate=0
        break
      fi
    done
    unset appmo_local_cmd
  fi

  if [[ "${appmo_elevate}" -eq 1 ]]; then
    # Use the installed path: the sudoers rule for appmotel-users allows
    # exactly this file, so no `env PATH=...` in front (PATH is set again
    # above after the switch)
    appmo_self="${APPMOTEL_HOME}/.local/bin/appmo"
    [[ -x "${appmo_self}" ]] || appmo_self=$(command -v appmo 2>/dev/null || echo "$0")
    # The re-exec'd process inherits our cwd, not appmotel's. If the caller's
    # cwd (e.g. their home dir) isn't reachable by appmotel, commands like
    # `find` fail to restore it on exit and print a spurious warning. Move
    # somewhere appmotel is guaranteed to reach before switching users.
    cd "${APPMOTEL_HOME}" 2>/dev/null || cd /tmp
    if [[ ${EUID} -ne 0 ]] && ! sudo -n -l -u "${APPMOTEL_USER}" "${appmo_self}" >/dev/null 2>&1; then
      echo "appmo: $(id -un) may not use appmo. Ask a sysadmin to run:" >&2
      echo "  sudo usermod -aG appmotel-users $(id -un)" >&2
      echo "then log in again (see 'Users and operators' in the appmotel README)." >&2
      exit 1
    fi
    exec sudo -u "${APPMOTEL_USER}" "${appmo_self}" "$@"
  fi
  unset appmo_elevate appmo_self
fi

# Audit: log who ran which appmo command (journalctl -t appmo). appmotel's
# own calls (timer, isolated-app relay) have no human caller and are skipped.
if [[ -n "${SUDO_USER:-}" ]] && [[ "${SUDO_USER}" != "${APPMOTEL_USER}" ]] && [[ $# -gt 0 ]]; then
  # %q quotes each word, so the line shows exactly what ran and stays one line.
  # 'env <app> set KEY VALUE' hides the value: it is often a secret.
  appmo_audit=("$@")
  if [[ "${1:-}" == "env" && "${3:-}" == "set" && $# -ge 4 ]]; then
    appmo_audit=("${@:1:3}" "${4%%=*}" "(value hidden)")
  fi
  logger -t appmo -p auth.notice -- "user=${SUDO_USER} as=$(id -un) cmd=appmo $(printf '%q ' "${appmo_audit[@]}")" 2>/dev/null || true
  unset appmo_audit
fi

# Load appmotel configuration
# Note: Temporarily reset IFS for proper .env parsing, then restore
if [[ "${APPMO_ROLE}" == "admin" ]] && [[ -f "${APPMOTEL_ENV_FILE}" ]]; then
  _saved_ifs="${IFS}"
  IFS=$' \t\n'
  # shellcheck source=/dev/null
  source "${APPMOTEL_ENV_FILE}"
  IFS="${_saved_ifs}"
  unset _saved_ifs
fi

# Default resource limits (can be overridden in .env)
readonly DEFAULT_MEMORY_LIMIT="512M"
readonly DEFAULT_CPU_QUOTA="100%"

# Rate limiting defaults
readonly DEFAULT_RATE_LIMIT_AVG=100
readonly DEFAULT_RATE_LIMIT_BURST=50

# Scheduled jobs: lines "<calendar> | <command>" in this file of the app folder
readonly SCHEDULE_FILE_NAME="appmo-schedule"
readonly MAX_SCHEDULED_JOBS=20
# autopull reports a crash loop when a unit restarted this often between two runs
readonly CRASH_LOOP_RESTARTS=3
# Let's Encrypt certificates that Traefik got (written by Traefik, mode 600)
readonly ACME_FILE="${APPMOTEL_HOME}/.local/share/traefik/acme.json"

# Ensure XDG_RUNTIME_DIR is set for systemd --user commands
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# In app role appmotel's global .env is unreadable; appmotel writes
# BASE_DOMAIN into the app user's own copy at isolate/add time
if [[ "${APPMO_ROLE}" == "app" ]]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
  if [[ -f "${APPS_CONFIG_DIR}/.env" ]]; then
    BASE_DOMAIN=$(grep -m1 '^BASE_DOMAIN=' "${APPS_CONFIG_DIR}/.env" | cut -d= -f2- | tr -d '"' || true)
    PYTHON_VERSION=$(grep -m1 '^PYTHON_VERSION=' "${APPS_CONFIG_DIR}/.env" | cut -d= -f2- | tr -d '"' || true)
  fi
fi

# -----------------------------------------------------------------------------
# Function: log_msg
# Description: Prints messages with timestamp
# -----------------------------------------------------------------------------
log_msg() {
  local level="$1"
  local msg="$2"
  printf "[%(%Y-%m-%d %H:%M:%S)T] [%s] %s\n" -1 "${level}" "${msg}" >&2
}

# -----------------------------------------------------------------------------
# Function: die
# Description: Prints error message and exits
# -----------------------------------------------------------------------------
die() {
  log_msg "ERROR" "$1"
  exit 1
}

# -----------------------------------------------------------------------------
# Function: json_escape
# Description: Print $1 as the inside of a JSON string: escapes backslash,
#   double quote, newline, CR and tab; drops other control characters.
# -----------------------------------------------------------------------------
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "${s}" | tr -d '\000-\010\013\014\016-\037'
}

# -----------------------------------------------------------------------------
# Function: notify
# Description: Post a one-line message to a chat webhook (Slack format
#   {"text": ...}; Mattermost, Rocket.Chat and Google Chat accept it too).
#   The URL is NOTIFY_WEBHOOK_URL from the app .env, else (admin role only)
#   from appmotel's global .env: an isolated app user cannot read that file,
#   so isolated apps notify only with their own URL. Never fails.
# Parameters: $1 = app name ("" for host-wide events), $2 = message
# -----------------------------------------------------------------------------
notify() {
  local app_name="$1" message="$2" url=""
  local app_env="${APPS_CONFIG_DIR}/${app_name}/.env"
  if [[ -n "${app_name}" ]] && [[ -f "${app_env}" ]]; then
    url=$(env_get_value "${app_env}" NOTIFY_WEBHOOK_URL 2>/dev/null) || url=""
  fi
  if [[ -z "${url}" ]] && [[ "${APPMO_ROLE}" == "admin" ]]; then
    url="${NOTIFY_WEBHOOK_URL:-}"
  fi
  [[ -n "${url}" ]] || return 0

  if [[ ! "${url}" =~ ^https?://[^[:space:]]+$ ]]; then
    log_msg "WARN" "NOTIFY_WEBHOOK_URL is not an http(s) URL, no notification sent"
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1; then
    log_msg "WARN" "curl is not installed, no notification sent"
    return 0
  fi

  local text="appmotel ${BASE_DOMAIN:-$(hostname 2>/dev/null || echo host)}"
  [[ -z "${app_name}" ]] || text+=": ${app_name}"
  text+=": ${message}"
  if ! printf '{"text": "%s"}\n' "$(json_escape "${text}")" \
      | curl -fsS --max-time 10 --proto '=https,http' -H 'Content-Type: application/json' \
          --data-binary @- "${url}" >/dev/null 2>&1; then
    log_msg "WARN" "Could not send a notification to NOTIFY_WEBHOOK_URL"
  fi
  return 0
}

# -----------------------------------------------------------------------------
# Function: safe_cd
# Description: Change directory with error context
# -----------------------------------------------------------------------------
safe_cd() {
  local target="$1"
  local context="${2:-}"

  if [[ ! -d "${target}" ]]; then
    if [[ -n "${context}" ]]; then
      die "Cannot change to directory '${target}': directory does not exist (${context})"
    else
      die "Cannot change to directory '${target}': directory does not exist"
    fi
  fi

  cd "${target}" || die "Failed to change to directory '${target}'"
}

# -----------------------------------------------------------------------------
# Function: systemctl_stop
# Description: Stop a systemd service, logging warnings on unexpected errors
# -----------------------------------------------------------------------------
systemctl_stop() {
  local service_name="$1"
  local is_user="${2:-true}"  # true for --user services, false for system services

  local output
  local exit_code

  if [[ "${is_user}" == "true" ]]; then
    output=$(systemctl --user stop "${service_name}" 2>&1) && exit_code=0 || exit_code=$?
  else
    output=$(sudo /bin/systemctl stop "${service_name}" 2>&1) && exit_code=0 || exit_code=$?
  fi

  # Exit code 5 means service not loaded (already stopped/doesn't exist) - this is OK
  if [[ ${exit_code} -ne 0 ]] && [[ ${exit_code} -ne 5 ]]; then
    log_msg "WARN" "Failed to stop ${service_name} (exit ${exit_code}): ${output}"
  fi

  return 0  # Always return success - stop failures shouldn't halt operations
}

# -----------------------------------------------------------------------------
# Function: git_with_timeout
# Description: Run git commands with a timeout to prevent hanging
# -----------------------------------------------------------------------------
git_with_timeout() {
  local timeout_secs="${GIT_TIMEOUT:-120}"  # Default 2 minutes
  timeout "${timeout_secs}" git "$@"
}

# -----------------------------------------------------------------------------
# Function: check_disk_space
# Description: Check if sufficient disk space is available
# Arguments: path, required_mb
# -----------------------------------------------------------------------------
check_disk_space() {
  local path="$1"
  local required_mb="${2:-100}"  # Default 100MB minimum

  # The dir may not exist yet (new app user): measure its nearest parent.
  # Under pipefail a failing df would otherwise abort the caller silently.
  while [[ ! -d "${path}" ]] && [[ "${path}" != "/" ]]; do
    path=$(dirname "${path}")
  done

  # Get available space in MB
  local available_mb
  available_mb=$(df -m "${path}" 2>/dev/null | awk 'NR==2 {print $4}' || true)

  if [[ -z "${available_mb}" ]]; then
    log_msg "WARN" "Could not check disk space for ${path}"
    return 0  # Continue anyway
  fi

  if [[ ${available_mb} -lt ${required_mb} ]]; then
    die "Insufficient disk space: ${available_mb}MB available, ${required_mb}MB required at ${path}"
  fi

  return 0
}

# -----------------------------------------------------------------------------
# Function: safe_rm_rf
# Description: Safely remove a directory with validation checks
# Prevents accidental deletion of critical directories
# -----------------------------------------------------------------------------
safe_rm_rf() {
  local target="$1"
  local context="${2:-unknown operation}"

  # Validate target is not empty
  if [[ -z "${target}" ]]; then
    die "safe_rm_rf: empty path provided during ${context}"
  fi

  # Resolve to absolute path
  local abs_target
  abs_target=$(realpath -m "${target}" 2>/dev/null || echo "${target}")

  # Validate path is within allowed directories
  local allowed_prefixes=(
    "${APPS_DATA_DIR}"
    "${APPS_CONFIG_DIR}"
    "${BACKUPS_DIR}"
    "${SYSTEMD_USER_DIR}"
    "${TRAEFIK_DYNAMIC_DIR}"
  )

  local path_allowed=false
  for prefix in "${allowed_prefixes[@]}"; do
    if [[ "${abs_target}" == "${prefix}"/* ]]; then
      path_allowed=true
      break
    fi
  done

  if [[ "${path_allowed}" != "true" ]]; then
    die "safe_rm_rf: refusing to remove '${abs_target}' - not in allowed directories (${context})"
  fi

  # Additional safety: prevent removal of root-level appmotel directories
  if [[ "${abs_target}" == "${APPS_DATA_DIR}" ]] || \
     [[ "${abs_target}" == "${APPS_CONFIG_DIR}" ]] || \
     [[ "${abs_target}" == "${BACKUPS_DIR}" ]] || \
     [[ "${abs_target}" == "${APPMO_HOME}" ]] || \
     [[ "${abs_target}" == "/" ]]; then
    die "safe_rm_rf: refusing to remove critical directory '${abs_target}' (${context})"
  fi

  # Path is valid, proceed with removal
  rm -rf "${target}"
}

# -----------------------------------------------------------------------------
# Function: safe_source_env
# Description: Safely source an .env file, only allowing KEY=VALUE lines
# Rejects lines with command substitution, semicolons, or other dangerous chars
# -----------------------------------------------------------------------------
safe_source_env() {
  local env_file="$1"
  local strict="${2:-false}"  # If true, fail on invalid lines

  if [[ ! -f "${env_file}" ]]; then
    return 1
  fi

  local line_num=0
  local saved_ifs="${IFS}"
  IFS=$' \t\n'

  while IFS= read -r line || [[ -n "${line}" ]]; do
    line_num=$((line_num + 1))

    # Skip empty lines and comments
    [[ -z "${line}" || "${line}" =~ ^[[:space:]]*# ]] && continue

    # Strip leading/trailing whitespace
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"

    # Validate: must be KEY=VALUE format
    # KEY: alphanumeric and underscore only, must start with letter or underscore
    # VALUE: can be quoted or unquoted, no command substitution or dangerous chars
    if [[ "${line}" =~ ^[a-zA-Z_][a-zA-Z0-9_]*= ]]; then
      local key="${line%%=*}"
      local value="${line#*=}"

      # Check for dangerous patterns in value
      # Reject: $(...), `...`, ;, &&, ||, |, >, <, \n in value
      # Note the braces: || and && have equal precedence in bash, so without
      # grouping the fully-quoted exemption (meant only for pipes) would
      # apply to the entire chain and quoted $(...)/backticks/; would pass
      if [[ "${value}" =~ \$\( ]] || \
         [[ "${value}" =~ \` ]] || \
         [[ "${value}" =~ \; ]] || \
         [[ "${value}" =~ \&\& ]] || \
         [[ "${value}" =~ \|\| ]] || \
         { [[ "${value}" =~ \| ]] && [[ ! "${value}" =~ ^[\"\'][^\"\']*[\"\']$ ]]; }; then
        if [[ "${strict}" == "true" ]]; then
          IFS="${saved_ifs}"
          die "Invalid .env file '${env_file}': dangerous pattern at line ${line_num}"
        fi
        log_msg "WARN" "Skipping suspicious line ${line_num} in ${env_file}"
        continue
      fi

      # Remove surrounding quotes if present
      if [[ "${value}" =~ ^\"(.*)\"$ ]] || [[ "${value}" =~ ^\'(.*)\'$ ]]; then
        value="${BASH_REMATCH[1]}"
      fi

      # Export the variable
      export "${key}=${value}"
    else
      if [[ "${strict}" == "true" ]]; then
        IFS="${saved_ifs}"
        die "Invalid .env file '${env_file}': malformed line ${line_num}"
      fi
      log_msg "WARN" "Skipping invalid line ${line_num} in ${env_file}"
    fi
  done < "${env_file}"

  IFS="${saved_ifs}"
}

# -----------------------------------------------------------------------------
# Function: safe_source_metadata
# Description: Safely source a metadata.conf file with strict validation
# Only allows specific known keys used by appmotel
# -----------------------------------------------------------------------------
safe_source_metadata() {
  local metadata_file="$1"

  if [[ ! -f "${metadata_file}" ]]; then
    return 1
  fi

  # Known valid metadata keys
  local -a valid_keys=("APP_NAME" "GITHUB_URL" "BRANCH" "PORT" "LAST_DEPLOYMENT" "SERVICES" "SUBDIR" "PROCESSES")

  local line_num=0
  while IFS= read -r line || [[ -n "${line}" ]]; do
    line_num=$((line_num + 1))

    # Skip empty lines and comments
    [[ -z "${line}" || "${line}" =~ ^[[:space:]]*# ]] && continue

    # Strip whitespace
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"

    if [[ "${line}" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)=(.*)$ ]]; then
      local key="${BASH_REMATCH[1]}"
      local value="${BASH_REMATCH[2]}"

      # Only allow known keys
      local key_valid=false
      for valid_key in "${valid_keys[@]}"; do
        if [[ "${key}" == "${valid_key}" ]]; then
          key_valid=true
          break
        fi
      done

      if [[ "${key_valid}" != "true" ]]; then
        die "Invalid metadata file '${metadata_file}': unknown key '${key}' at line ${line_num}"
      fi

      # Check for dangerous patterns
      if [[ "${value}" =~ \$\( ]] || [[ "${value}" =~ \` ]] || [[ "${value}" =~ \; ]]; then
        die "Invalid metadata file '${metadata_file}': dangerous pattern at line ${line_num}"
      fi

      # Remove surrounding quotes
      if [[ "${value}" =~ ^\"(.*)\"$ ]] || [[ "${value}" =~ ^\'(.*)\'$ ]]; then
        value="${BASH_REMATCH[1]}"
      fi

      # Set variable in current scope
      declare -g "${key}=${value}"
    else
      die "Invalid metadata file '${metadata_file}': malformed line ${line_num}"
    fi
  done < "${metadata_file}"
}

# -----------------------------------------------------------------------------
# Function: format_timestamp
# Description: Converts UTC timestamp to configured timezone for display
# Input: UTC timestamp in ISO 8601 format (e.g., 2025-12-17T19:58:08Z)
# Output: Human-readable timestamp in configured timezone
# -----------------------------------------------------------------------------
format_timestamp() {
  local utc_timestamp="$1"
  local tz="${TZ:-UTC}"

  if [[ -z "${utc_timestamp}" ]]; then
    echo "N/A"
    return
  fi

  # Use date command with TZ environment variable to convert
  # GNU date can parse ISO 8601 format directly
  local formatted
  if formatted=$(TZ="${tz}" date -d "${utc_timestamp}" "+%Y-%m-%d %H:%M:%S %Z" 2>/dev/null); then
    echo "${formatted}"
  else
    # Fallback: return original timestamp if conversion fails
    echo "${utc_timestamp}"
  fi
}

# -----------------------------------------------------------------------------
# Function: usage
# Description: Prints usage information
# -----------------------------------------------------------------------------
usage() {
  cat <<EOF
Usage: appmo <command> [arguments]

Commands:
  add <app-name> <url|user/repo> [branch]  Add and deploy a new app (default: main)
      --isolated                         Run the app as its own Linux user a-<app-name>
  isolate <app-name>                     Move an existing app to its own user a-<app-name>
  remove <app-name>                      Remove an app (alias: rm)
  list                                   List all configured apps (alias: ls)
  status [app-name]                      Show app status
  start <app-name>                       Start an app
  stop <app-name>                        Stop an app
  restart <app-name>                     Restart an app
  update <app-name>                      Manually update an app
  check [app-name]                       Check for available updates (no deploy)
  autopull                               Check all apps for updates and deploy
  logs <app-name> [lines]                View app logs (with scheduled jobs)
      --since TIME                       Everything since TIME ("1h ago", "today", "2026-01-31 08:00")
      --grep REGEX                       Only matching lines (lines then counts matches)
      --follow                           Keep printing new lines
  top [app-name...]                      Memory, CPU time, restarts and disk use per app
  rollback <app-name> [backup-id]        Go back to the version before the last update, pin it
  unpin <app-name>                       Let autopull update a rolled-back app again
  certs                                  List TLS certificates and when they expire
  env <app-name>                         Edit app's .env file (vim, mouse off)
  env <app-name> get KEY                 Print one .env value
  env <app-name> set KEY [VALUE]         Set one .env value (no VALUE: read from stdin)
  env <app-name> set < file              Set many KEY=VALUE lines from stdin (all or none)
  env <app-name> unset KEY...            Remove .env variables
  exec <app-name> <command>              Run command in app's environment
  backup <app-name>                      Create a backup of an app
  restore <app-name> [backup-id]         Restore an app from backup
  backups <app-name>                     List available backups for an app
  backup-verify <app-name> [backup-id]   Check that a backup can be restored (default: newest)
  self-update                            Update appmo CLI, Traefik, and configs
  skill                                  Install the Appmotel Claude Code skill into ~/.claude/skills/

URL Formats:
  user/repo                              Short form (expands to GitHub)
  https://github.com/user/repo           Standard GitHub URL
  https://github.com/user/repo/tree/branch/path/to/folder
                                         Deploy from a subfolder

Examples:
  appmo add myapp https://github.com/user/repo main
  appmo add myapp https://github.com/user/repo/tree/main/apps/myapp
  appmo add --isolated myapp user/repo
  appmo status myapp
  appmo autopull
  appmo logs myapp 50
  appmo logs myapp --since "1h ago" --grep 'Traceback|ERROR'
  appmo rollback myapp
  appmo env myapp
  appmo backup myapp
  appmo restore myapp 2024-01-15-120000
EOF
  exit 0
}

# -----------------------------------------------------------------------------
# Function: validate_app_name
# Description: Validates app name format
# -----------------------------------------------------------------------------
validate_app_name() {
  local app_name="$1"

  if [[ -z "${app_name}" ]]; then
    die "App name cannot be empty"
  fi

  if [[ "${app_name}" =~ [[:space:]] ]]; then
    die "App name cannot contain spaces"
  fi

  if [[ ! "${app_name}" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]]; then
    die "App name must be a valid DNS subdomain label (lowercase alphanumeric and hyphens only)"
  fi
}

# -----------------------------------------------------------------------------
# Function: check_github_ssh_access
# Description: Check if user has SSH access to GitHub
# Returns: 0 if SSH works, 1 otherwise
# -----------------------------------------------------------------------------
check_github_ssh_access() {
  # Try to connect to GitHub via SSH with a short timeout
  # GitHub returns "Hi username! You've successfully authenticated" on success
  # Exit code 1 with that message means authentication worked (not a real shell)
  if timeout 5 ssh -T -o StrictHostKeyChecking=accept-new -o BatchMode=yes git@github.com 2>&1 | grep -q "successfully authenticated"; then
    return 0
  fi
  return 1
}

# -----------------------------------------------------------------------------
# Function: validate_github_url
# Description: Validates GitHub URL format
# -----------------------------------------------------------------------------
validate_github_url() {
  local url="$1"

  if [[ -z "${url}" ]]; then
    die "GitHub URL cannot be empty"
  fi

  # Check for path traversal attempts
  if [[ "${url}" =~ \.\. ]]; then
    die "Invalid GitHub URL: path traversal not allowed"
  fi

  # Accept full URLs or user/repo shorthand
  if [[ "${url}" =~ ^https?:// ]] || [[ "${url}" =~ ^git@ ]]; then
    # Full URL - basic validation
    if [[ ! "${url}" =~ ^(https?://|git@)[a-zA-Z0-9._-]+[:/][a-zA-Z0-9._/-]+$ ]]; then
      die "Invalid GitHub URL format: ${url}"
    fi
  elif [[ "${url}" =~ ^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$ ]]; then
    # user/repo shorthand - this is valid
    :
  else
    die "Invalid GitHub URL format. Use https://github.com/user/repo or user/repo"
  fi
}

# -----------------------------------------------------------------------------
# Function: parse_github_url
# Description: Parses GitHub URL to extract repo URL, branch, and subfolder
# Input:  https://github.com/user/repo/tree/branch/path/to/folder
# Output: Sets global variables: PARSED_REPO_URL, PARSED_BRANCH, PARSED_SUBDIR
# -----------------------------------------------------------------------------
parse_github_url() {
  local url="$1"

  # Reset output variables
  PARSED_REPO_URL=""
  PARSED_BRANCH=""
  PARSED_SUBDIR=""

  # Check if URL contains /tree/ pattern (GitHub subfolder URL)
  if [[ "${url}" =~ ^(https://github\.com/[^/]+/[^/]+)/tree/([^/]+)/(.+)$ ]]; then
    # Full URL with subfolder: https://github.com/user/repo/tree/branch/path/to/folder
    PARSED_REPO_URL="${BASH_REMATCH[1]}"
    PARSED_BRANCH="${BASH_REMATCH[2]}"
    PARSED_SUBDIR="${BASH_REMATCH[3]}"
    # Remove trailing slash if present
    PARSED_SUBDIR="${PARSED_SUBDIR%/}"
  elif [[ "${url}" =~ ^(https://github\.com/[^/]+/[^/]+)/tree/([^/]+)/?$ ]]; then
    # URL with branch but no subfolder: https://github.com/user/repo/tree/branch
    PARSED_REPO_URL="${BASH_REMATCH[1]}"
    PARSED_BRANCH="${BASH_REMATCH[2]}"
  elif [[ "${url}" =~ ^(https://github\.com/[^/]+/[^/]+)/?$ ]]; then
    # Standard URL: https://github.com/user/repo
    PARSED_REPO_URL="${BASH_REMATCH[1]}"
  elif [[ "${url}" =~ ^(git@github\.com:[^/]+/[^/]+)(\.git)?$ ]]; then
    # SSH URL: git@github.com:user/repo.git
    PARSED_REPO_URL="${BASH_REMATCH[1]}"
  elif [[ "${url}" =~ ^([a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+)$ ]]; then
    # Shorthand: user/repo
    PARSED_REPO_URL="https://github.com/${BASH_REMATCH[1]}"
  else
    # Unrecognized format - let validate_github_url handle it
    PARSED_REPO_URL="${url}"
  fi
}


# -----------------------------------------------------------------------------
# Function: find_file_up
# Description: Search for a file starting from a directory and going up
# Arguments: filename, start_dir, stop_dir (don't search above this)
# Returns: Path to found file or empty string
# -----------------------------------------------------------------------------
find_file_up() {
  local filename="$1"
  local start_dir="$2"
  local stop_dir="$3"

  local current_dir="${start_dir}"

  while [[ "${current_dir}" == "${stop_dir}"* ]]; do
    if [[ -f "${current_dir}/${filename}" ]]; then
      echo "${current_dir}"
      return 0
    fi

    # Move up one directory
    local parent_dir
    parent_dir=$(dirname "${current_dir}")

    # Stop if we've reached the stop_dir or can't go higher
    if [[ "${parent_dir}" == "${current_dir}" ]] || [[ "${current_dir}" == "${stop_dir}" ]]; then
      break
    fi

    current_dir="${parent_dir}"
  done

  return 1
}

# -----------------------------------------------------------------------------
# Function: validate_branch_name
# Description: Validates git branch name
# -----------------------------------------------------------------------------
validate_branch_name() {
  local branch="$1"

  if [[ -z "${branch}" ]]; then
    die "Branch name cannot be empty"
  fi

  # Check for path traversal and dangerous characters
  if [[ "${branch}" =~ \.\. ]] || \
     [[ "${branch}" =~ [[:space:]] ]] || \
     [[ "${branch}" =~ [\;\|\&\$\`] ]]; then
    die "Invalid branch name: contains dangerous characters"
  fi

  # Git branch names have specific rules
  # https://git-scm.com/docs/git-check-ref-format
  if [[ ! "${branch}" =~ ^[a-zA-Z0-9_./-]+$ ]]; then
    die "Invalid branch name: must contain only alphanumeric, dot, underscore, hyphen, or slash"
  fi

  # Cannot start or end with slash or dot
  if [[ "${branch}" =~ ^[./] ]] || [[ "${branch}" =~ [./]$ ]]; then
    die "Invalid branch name: cannot start or end with slash or dot"
  fi
}

# -----------------------------------------------------------------------------
# Function: app_exists
# Description: Checks if an app exists (must have metadata.conf to be considered deployed)
# Note: A directory with only .env.backup from a removed app doesn't count
# -----------------------------------------------------------------------------
app_exists() {
  local app_name="$1"
  [[ -f "${APPS_CONFIG_DIR}/${app_name}/metadata.conf" ]] || is_isolated "${app_name}"
}

# -----------------------------------------------------------------------------
# Isolated apps (admin role only)
# appmotel keeps only isolated.conf (ISOLATED_USER, PORT) for such an app; the
# app itself lives in the home of its user and is managed by running appmo as
# that user. Everything the app user wrote is untrusted input here.
# -----------------------------------------------------------------------------
is_isolated() {
  [[ "${APPMO_ROLE}" == "admin" ]] && [[ -f "${APPS_CONFIG_DIR}/$1/isolated.conf" ]]
}

app_user_home() {
  getent passwd "${APP_USER_PREFIX}$1" | cut -d: -f6
}

# Run a command as the app user, from a directory that user can reach
as_app_user() {
  local app_name="$1"
  shift
  (cd / && sudo -n -u "${APP_USER_PREFIX}${app_name}" "$@")
}

# Ports of all apps except $1, for port allocation in app role
reserved_ports_except() {
  local skip="$1" f
  for f in "${APPS_CONFIG_DIR}"/*/metadata.conf "${APPS_CONFIG_DIR}"/*/isolated.conf; do
    [[ -f "${f}" ]] || continue
    [[ "$(basename "$(dirname "${f}")")" == "${skip}" ]] && continue
    grep -h '^PORT=' "${f}" | cut -d= -f2 | tr -d '"'
  done | tr '\n' ' '
}

# Run appmo as the app user (app role)
run_appmo_as_app() {
  local app_name="$1"
  shift
  as_app_user "${app_name}" env "PATH=${PATH}" \
    "APPMO_RESERVED_PORTS=$(reserved_ports_except "${app_name}")" \
    "EDITOR=${EDITOR:-${VISUAL:-}}" "GIT_TIMEOUT=${GIT_TIMEOUT:-120}" \
    "APPMO_KEEP_REPO=${APPMO_KEEP_REPO:-0}" \
    "$(command -v appmo 2>/dev/null || echo "$0")" "$@"
}

# Rebuild the Traefik route of an isolated app from its metadata and .env.
# create_traefik_config validates every value, so the app user cannot inject
# routing rules for other hosts.
sync_isolated_traefik() {
  local app_name="$1"
  local home
  home=$(app_user_home "${app_name}")
  [[ -n "${home}" ]] || { log_msg "WARN" "${app_name}: app user not found"; return 1; }

  local port
  port=$(as_app_user "${app_name}" cat "${home}/.config/appmotel/${app_name}/metadata.conf" 2>/dev/null \
    | grep -m1 '^PORT=' | cut -d= -f2 | tr -d '"' || true)
  if [[ ! "${port}" =~ ^[0-9]+$ ]] || [[ ${port} -lt ${MIN_PORT} ]] || [[ ${port} -gt ${MAX_PORT} ]]; then
    log_msg "WARN" "${app_name}: no valid PORT in app metadata, Traefik route not changed"
    return 1
  fi
  # The app user writes this value: it must not take the port of another app
  # (its route would point there, and the firewall would let it connect)
  if [[ " $(reserved_ports_except "${app_name}") " == *" ${port} "* ]]; then
    log_msg "WARN" "${app_name}: PORT ${port} belongs to another app, Traefik route not changed"
    return 1
  fi

  local env_copy
  env_copy=$(create_temp_file "isoenv")
  chmod 600 "${env_copy}"
  as_app_user "${app_name}" cat "${home}/.config/appmotel/${app_name}/.env" > "${env_copy}" 2>/dev/null || true

  if ! create_traefik_config "${app_name}" "${port}" "${BASE_DOMAIN:-apps.example.edu}" "${env_copy}"; then
    rm -f "${env_copy}"
    return 1
  fi
  rm -f "${env_copy}"
  local conf="${APPS_CONFIG_DIR}/${app_name}/isolated.conf" old_port=""
  old_port=$(grep -m1 '^PORT=' "${conf}" 2>/dev/null | cut -d= -f2 | tr -d '"') || true
  printf 'ISOLATED_USER="%s"\nPORT="%s"\n' "${APP_USER_PREFIX}${app_name}" "${port}" > "${conf}"
  # The app user may connect only to its own port (appmotel-user firewall)
  if [[ "${old_port}" != "${port}" ]]; then
    sudo -n /usr/local/bin/appmotel-user firewall \
      || log_msg "WARN" "${app_name}: could not update the app-port firewall"
  fi
}

# Public GitHub repo? Unknown hosts and errors count as private.
repo_is_public() {
  local url="$1" slug=""
  if [[ "${url}" =~ ^https://github\.com/([^/]+/[^/]+)$ ]] || \
     [[ "${url}" =~ ^git@github\.com:([^/]+/[^/]+)$ ]] || \
     [[ "${url}" =~ ^([a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+)$ ]]; then
    slug="${BASH_REMATCH[1]%.git}"
  fi
  [[ -n "${slug}" ]] || return 1
  [[ "$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "https://api.github.com/repos/${slug}" 2>/dev/null)" == "200" ]]
}

# Give the app user appmotel's GitHub SSH key(s), for private repos only
copy_ssh_keys_to_app() {
  local app_name="$1"
  local key copied=0
  local -a keys=()
  mapfile -t keys < <(ssh -G github.com 2>/dev/null | awk '/^identityfile /{print $2}' | sed "s|^~|${HOME}|")

  as_app_user "${app_name}" bash -c 'umask 077 && mkdir -p ~/.ssh'
  for key in "${keys[@]:-}"; do
    [[ -n "${key}" ]] && [[ -f "${key}" ]] || continue
    local name
    name=$(basename "${key}")
    [[ "${name}" =~ ^[A-Za-z0-9._-]+$ ]] || continue
    as_app_user "${app_name}" bash -c 'umask 077 && cat > ~/.ssh/"$1"' _ "${name}" < "${key}"
    [[ -f "${key}.pub" ]] && as_app_user "${app_name}" bash -c 'umask 077 && cat > ~/.ssh/"$1"' _ "${name}.pub" < "${key}.pub"
    printf 'Host github.com\n  IdentityFile ~/.ssh/%s\n' "${name}" \
      | as_app_user "${app_name}" bash -c 'umask 077 && cat >> ~/.ssh/config'
    copied=$((copied + 1))
  done

  # GitHub host key, so git over SSH does not stop at the host key prompt
  { ssh-keygen -F github.com 2>/dev/null | grep -v '^#' || ssh-keyscan -t ed25519,rsa github.com 2>/dev/null; } \
    | as_app_user "${app_name}" bash -c 'umask 077 && cat >> ~/.ssh/known_hosts'

  if [[ ${copied} -eq 0 ]]; then
    log_msg "WARN" "${app_name}: no SSH key of appmotel found to copy; private repo clone may fail"
  else
    log_msg "INFO" "${app_name}: copied ${copied} GitHub SSH key(s) to ${APP_USER_PREFIX}${app_name} (private repo)"
  fi
}

# Create the app user and prepare its home. Echoes the clone URL to use.
# isolated.conf is written only by sync_isolated_traefik after a good deploy,
# so a failure here never hides an existing app behind an empty user.
prepare_app_user() {
  local app_name="$1"
  local url="$2"

  # An app user must not be able to read appmotel's files
  secure_appmotel_files
  if ! sudo -n /usr/local/bin/appmotel-user create "${app_name}" >/dev/null; then
    log_msg "ERROR" "Could not create user ${APP_USER_PREFIX}${app_name} (is /usr/local/bin/appmotel-user installed? re-run 'sudo bash install.sh')"
    return 1
  fi

  mkdir -p "${APPS_CONFIG_DIR}/${app_name}" || return 1
  printf 'BASE_DOMAIN="%s"\nPYTHON_VERSION="%s"\n' "${BASE_DOMAIN:-}" "${PYTHON_VERSION:-}" \
    | as_app_user "${app_name}" bash -c 'umask 077 && mkdir -p ~/.config/appmotel && cat > ~/.config/appmotel/.env' \
    || return 1

  if repo_is_public "${url%%/tree/*}"; then
    # The app user has no SSH key, so use HTTPS for public repos
    if [[ "${url}" =~ ^git@github\.com:(.+)$ ]]; then
      url="https://github.com/${BASH_REMATCH[1]%.git}"
    fi
  else
    copy_ssh_keys_to_app "${app_name}" || return 1
  fi
  echo "${url}"
}

# Undo prepare_app_user after a failed deploy. Leaves the Traefik route alone:
# during isolate it still belongs to the old app.
drop_app_user() {
  local app_name="$1"
  sudo -n /usr/local/bin/appmotel-user delete "${app_name}" || log_msg "WARN" "Could not delete user ${APP_USER_PREFIX}${app_name}"
  rm -f "${APPS_CONFIG_DIR}/${app_name}/isolated.conf"
  rmdir "${APPS_CONFIG_DIR}/${app_name}" 2>/dev/null || true
}

# appmo add --isolated <app> <url> [branch] [subfolder]
add_isolated() {
  local app_name="$1"
  local url="$2"
  local branch="${3:-}"
  local subdir="${4:-}"

  [[ ${#app_name} -le 30 ]] || die "Isolated app names can have at most 30 characters"
  if app_exists "${app_name}"; then
    die "App '${app_name}' already exists"
  fi
  validate_github_url "${url%%/tree/*}"

  log_msg "INFO" "Adding isolated app '${app_name}' as user ${APP_USER_PREFIX}${app_name}"
  if ! url=$(prepare_app_user "${app_name}" "${url}"); then
    drop_app_user "${app_name}"
    die "Could not prepare user ${APP_USER_PREFIX}${app_name}, nothing deployed"
  fi

  # A .env kept by an earlier 'appmo remove' goes to the app user, where
  # cmd_add offers to restore it; appmotel's copy goes only after success
  local env_backup="${APPS_CONFIG_DIR}/${app_name}/.env.backup"
  if [[ -f "${env_backup}" ]]; then
    as_app_user "${app_name}" bash -c 'umask 077 && mkdir -p ~/.config/appmotel/"$1" && cat > ~/.config/appmotel/"$1"/.env.backup' _ "${app_name}" < "${env_backup}"
  fi

  if ! run_appmo_as_app "${app_name}" add "${app_name}" "${url}" "${branch}" "${subdir}" \
     || ! sync_isolated_traefik "${app_name}"; then
    drop_app_user "${app_name}"
    die "Failed to deploy isolated app '${app_name}', user removed"
  fi
  rm -f "${env_backup}"
  log_msg "INFO" "Isolated app '${app_name}' runs as ${APP_USER_PREFIX}${app_name}"
  check_app_url "${app_name}" "${BASE_DOMAIN:-apps.example.edu}" \
    "$(grep -m1 '^PORT=' "${APPS_CONFIG_DIR}/${app_name}/isolated.conf" | cut -d= -f2 | tr -d '"')"
}

# appmo isolate <app>: move an existing app to its own user
cmd_isolate() {
  [[ $# -eq 1 ]] || die "Usage: appmo isolate <app-name>"
  local app_name="$1"
  [[ "${APPMO_ROLE}" == "admin" ]] || die "appmo isolate must be run by appmotel or an operator"
  require_app_exists "${app_name}"
  is_isolated "${app_name}" && die "App '${app_name}' is already isolated"
  [[ ${#app_name} -le 30 ]] || die "Isolated app names can have at most 30 characters"

  load_app_metadata "${app_name}"
  local url="${GITHUB_URL}" branch="${BRANCH}" subdir="${SUBDIR:-}" old_port="${PORT}"
  local data_dir="${APPS_DATA_DIR}/${app_name}"
  local config_dir="${APPS_CONFIG_DIR}/${app_name}"
  local app_dir="${data_dir}/repo${subdir:+/${subdir}}"

  # The new copy is deployed from origin/<branch>, which would undo a rollback
  if [[ -f "${config_dir}/pinned" ]]; then
    die "App '${app_name}' is pinned by appmo rollback; isolating it would deploy the latest commit of ${branch}. Fix the branch, appmo unpin ${app_name}, then isolate"
  fi

  log_msg "INFO" "Creating backup before isolating..."
  local backup_id
  backup_id=$(create_backup "${app_name}") || die "Backup failed, nothing was changed"

  local -a services
  get_all_services "${app_name}" services
  local -a units=()
  local service
  for service in "${services[@]}"; do
    if [[ "${service}" == "frontend" ]] || [[ "${service}" == "${app_name}" ]]; then
      units+=("appmotel-${app_name}")
    else
      units+=("appmotel-${app_name}-${service}")
    fi
  done

  if ! url=$(prepare_app_user "${app_name}" "${url}"); then
    drop_app_user "${app_name}"
    die "Could not prepare user ${APP_USER_PREFIX}${app_name}, nothing was changed"
  fi

  # Stop the old services so the new ones can take over the same port, and
  # the old job timers so no job runs twice while the new copy starts
  local unit
  for unit in "${units[@]}"; do
    systemctl_stop "${unit}"
  done
  job_timers_ctl "${app_name}" stop

  # Copy repo (with untracked data, without any venv: venvs hold absolute
  # paths) and the app .env into the app user's home, then deploy there.
  # One chain, so any failure (for example a full disk) rolls back.
  local home
  home=$(app_user_home "${app_name}")
  if ! { [[ -n "${home}" ]] \
      && as_app_user "${app_name}" mkdir -p "${home}/.local/share/appmotel/${app_name}" "${home}/.config/appmotel/${app_name}" \
      && tar --exclude=.venv -C "${data_dir}" -cf - ./repo \
           | as_app_user "${app_name}" tar -C "${home}/.local/share/appmotel/${app_name}" -xf - \
      && { [[ ! -f "${config_dir}/.env" ]] \
           || as_app_user "${app_name}" bash -c 'umask 077 && cat > "$1"' _ "${home}/.config/appmotel/${app_name}/.env" < "${config_dir}/.env"; } \
      && APPMO_KEEP_REPO=1 run_appmo_as_app "${app_name}" add "${app_name}" "${url}" "${branch}" "${subdir}" \
      && sync_isolated_traefik "${app_name}"; }; then
    log_msg "ERROR" "Isolating '${app_name}' failed, restoring the old app"
    drop_app_user "${app_name}"
    create_traefik_config "${app_name}" "${old_port}" "${BASE_DOMAIN:-apps.example.edu}" "${app_dir}/.env" || true
    for unit in "${units[@]}"; do
      systemctl --user start "${unit}" || true
    done
    job_timers_ctl "${app_name}" start
    die "appmo isolate failed; '${app_name}' runs as appmotel again"
  fi

  # New app is live: remove the old copy
  remove_scheduled_jobs "${app_name}"
  for unit in "${units[@]}"; do
    systemctl --user disable "${unit}" 2>/dev/null || true
    rm -f "${SYSTEMD_USER_DIR}/${unit}.service"
    if [[ -d "${SYSTEMD_USER_DIR}/${unit}.service.d" ]]; then
      safe_rm_rf "${SYSTEMD_USER_DIR}/${unit}.service.d" "cmd_isolate old drop-ins"
    fi
  done
  systemctl --user daemon-reload
  safe_rm_rf "${data_dir}" "cmd_isolate old app data"
  find "${config_dir}" -mindepth 1 -maxdepth 1 ! -name isolated.conf -exec rm -rf {} +

  log_msg "INFO" "App '${app_name}' now runs as ${APP_USER_PREFIX}${app_name}"
  # appmo restore now looks in the app user's backups, so say where this one is
  log_msg "INFO" "The backup made before isolating is ${BACKUPS_DIR}/${app_name}/${backup_id}"
  log_msg "INFO" "To go back to the old app: appmo remove ${app_name}, then appmo add it again and copy the"
  log_msg "INFO" "  .env from that backup (appmo restore cannot use it, it runs as the app user)"
  check_app_url "${app_name}" "${BASE_DOMAIN:-apps.example.edu}" "$(grep -m1 '^PORT=' "${config_dir}/isolated.conf" | cut -d= -f2 | tr -d '"')"
}

# appmo remove for an isolated app
remove_isolated() {
  local app_name="$1"
  local home
  home=$(app_user_home "${app_name}")
  local config_dir="${APPS_CONFIG_DIR}/${app_name}"

  if [[ -n "${home}" ]]; then
    run_appmo_as_app "${app_name}" remove "${app_name}" || log_msg "WARN" "App user could not remove all app files"

    # Keep the .env and the backups: the user's home is deleted next
    as_app_user "${app_name}" cat "${home}/.config/appmotel/${app_name}/.env.backup" > "${config_dir}/.env.backup" 2>/dev/null \
      || rm -f "${config_dir}/.env.backup"
    [[ -f "${config_dir}/.env.backup" ]] && chmod 600 "${config_dir}/.env.backup"
    # Kept as one archive: appmotel never unpacks a tar the app user made
    mkdir -p "${BACKUPS_DIR}"
    local archive
    archive="${BACKUPS_DIR}/${app_name}-isolated-$(date +%Y-%m-%d-%H%M%S).tar.gz"
    if as_app_user "${app_name}" test -d "${home}/.local/share/appmotel-backups/${app_name}"; then
      as_app_user "${app_name}" tar -C "${home}/.local/share/appmotel-backups" -czf - "${app_name}" > "${archive}" \
        && log_msg "INFO" "App backups saved to ${archive}" \
        || log_msg "WARN" "Could not save app backups"
    fi
  fi

  rm -f "${TRAEFIK_DYNAMIC_DIR}/${app_name}.yaml"
  sudo -n /usr/local/bin/appmotel-user delete "${app_name}" || die "Could not delete user ${APP_USER_PREFIX}${app_name}"
  rm -f "${config_dir}/isolated.conf"
  rmdir "${config_dir}" 2>/dev/null || true
  log_msg "INFO" "Isolated app '${app_name}' and user ${APP_USER_PREFIX}${app_name} removed"
}

# -----------------------------------------------------------------------------
# Function: require_app_exists
# Description: Ensures app exists or exits
# -----------------------------------------------------------------------------
require_app_exists() {
  local app_name="$1"
  if ! app_exists "${app_name}"; then
    die "App '${app_name}' does not exist"
  fi
}

# -----------------------------------------------------------------------------
# Function: create_backup
# Description: Creates a backup of an app's data and config
# -----------------------------------------------------------------------------
create_backup() {
  local app_name="$1"
  local mode="${2:-}"   # "keep-all": do not prune (appmo rollback's safety backup)
  local backup_id base_id suffix=1
  base_id=$(date +%Y-%m-%d-%H%M%S)
  backup_id="${base_id}"
  # Two backups in one second (appmo rollback backs up the current state
  # right before it restores) must not share a directory
  while [[ -e "${BACKUPS_DIR}/${app_name}/${backup_id}" ]]; do
    backup_id="${base_id}-${suffix}"
    suffix=$((suffix + 1))
  done
  local backup_dir="${BACKUPS_DIR}/${app_name}/${backup_id}"
  local backup_warnings=false

  # Check disk space before creating backup (require at least 200MB)
  check_disk_space "${BACKUPS_DIR}" 200

  mkdir -p "${backup_dir}"

  # Backup config
  if [[ -d "${APPS_CONFIG_DIR}/${app_name}" ]]; then
    if ! cp -r "${APPS_CONFIG_DIR}/${app_name}" "${backup_dir}/config"; then
      log_msg "WARN" "Failed to backup config directory"
      backup_warnings=true
    fi
  fi

  # Backup repo (excluding .venv and node_modules to save space; .git is kept so
  # a restored backup is a valid git repo and autopull can update it normally)
  if [[ -d "${APPS_DATA_DIR}/${app_name}/repo" ]]; then
    if ! tar --exclude='.venv' --exclude='node_modules' \
        -czf "${backup_dir}/repo.tar.gz" \
        -C "${APPS_DATA_DIR}/${app_name}" repo 2>/dev/null; then
      log_msg "WARN" "Failed to backup repo (tar failed - disk full?)"
      backup_warnings=true
    fi
    # The deployed commit: appmo rollback picks the newest backup of another
    # version, appmo backups and backup-verify show and check it
    git -C "${APPS_DATA_DIR}/${app_name}/repo" rev-parse HEAD > "${backup_dir}/COMMIT" 2>/dev/null \
      || rm -f "${backup_dir}/COMMIT"
  fi

  # Backup all systemd service files for this app (including multi-component)
  local -a unit_files
  get_app_unit_files "${app_name}" unit_files
  local unit_file
  for unit_file in "${unit_files[@]}"; do
    if [[ -f "${SYSTEMD_USER_DIR}/${unit_file}" ]]; then
      if ! cp "${SYSTEMD_USER_DIR}/${unit_file}" "${backup_dir}/"; then
        log_msg "WARN" "Failed to backup service file: ${unit_file}"
        backup_warnings=true
      fi
    fi
  done

  # Backup Traefik config
  if [[ -f "${TRAEFIK_DYNAMIC_DIR}/${app_name}.yaml" ]]; then
    if ! cp "${TRAEFIK_DYNAMIC_DIR}/${app_name}.yaml" "${backup_dir}/"; then
      log_msg "WARN" "Failed to backup Traefik config"
      backup_warnings=true
    fi
  fi

  echo "${backup_id}"
  if [[ "${backup_warnings}" == "true" ]]; then
    log_msg "WARN" "Backup created with warnings: ${backup_id}"
  else
    log_msg "INFO" "Backup created: ${backup_id}"
  fi

  # Prune old backups — keep only the newest BACKUP_RETENTION (default 5).
  # Not for rollback's safety backup: it could prune the backup about to be
  # restored; the next backup prunes again.
  [[ "${mode}" != "keep-all" ]] || return 0
  local retention
  retention=$(backup_retention "${app_name}")
  local app_backup_dir="${BACKUPS_DIR}/${app_name}"
  local old_backups
  mapfile -t old_backups < <(ls -1t "${app_backup_dir}" 2>/dev/null | tail -n +$((retention + 1)))
  if [[ ${#old_backups[@]} -gt 0 ]]; then
    log_msg "INFO" "Pruning ${#old_backups[@]} old backup(s) for ${app_name} (keeping ${retention})"
    for old in "${old_backups[@]}"; do
      rm -rf "${app_backup_dir:?}/${old}"
    done
  fi
}

# -----------------------------------------------------------------------------
# Function: restore_backup
# Description: Restores an app from a backup
# Returns: 0 on success, 1 on failure
# -----------------------------------------------------------------------------
restore_backup() {
  local app_name="$1"
  local backup_id="$2"
  local backup_dir="${BACKUPS_DIR}/${app_name}/${backup_id}"
  local restore_failed=false

  # An empty backup_id would make backup_dir the backup root, which exists —
  # the -d check below would pass while restoring nothing
  if [[ -z "${backup_id}" ]]; then
    log_msg "ERROR" "restore_backup called with empty backup id for '${app_name}'"
    return 1
  fi

  if [[ ! -d "${backup_dir}" ]]; then
    log_msg "ERROR" "Backup '${backup_id}' not found for app '${app_name}'"
    return 1
  fi

  log_msg "INFO" "Restoring from backup: ${backup_id}"

  # Stop all services if running
  local -a services
  if get_all_services "${app_name}" services 2>/dev/null; then
    for service in "${services[@]}"; do
      local service_name
      if [[ "${service}" == "frontend" ]] || [[ "${service}" == "${app_name}" ]]; then
        service_name="appmotel-${app_name}"
      else
        service_name="appmotel-${app_name}-${service}"
      fi
      systemctl_stop "${service_name}"
    done
  else
    systemctl_stop "appmotel-${app_name}"
  fi

  # Remove the current scheduled jobs while jobs.list still names them: the
  # config restore below replaces it with the backup's list
  remove_scheduled_jobs "${app_name}"

  # Restore config
  if [[ -d "${backup_dir}/config" ]]; then
    safe_rm_rf "${APPS_CONFIG_DIR}/${app_name}" "restore_backup config"
    if ! cp -r "${backup_dir}/config" "${APPS_CONFIG_DIR}/${app_name}"; then
      log_msg "ERROR" "Failed to restore config directory"
      restore_failed=true
    fi
  fi

  # Restore repo
  if [[ -f "${backup_dir}/repo.tar.gz" ]]; then
    safe_rm_rf "${APPS_DATA_DIR}/${app_name}/repo" "restore_backup repo"
    mkdir -p "${APPS_DATA_DIR}/${app_name}"
    if ! tar -xzf "${backup_dir}/repo.tar.gz" -C "${APPS_DATA_DIR}/${app_name}"; then
      log_msg "ERROR" "Failed to restore repo from backup archive"
      restore_failed=true
    fi
  fi

  # Restore systemd service(s). Only units this app owns (per metadata) —
  # the old glob could copy a stale unit over a sibling app's current one.
  local -a unit_files
  get_app_unit_files "${app_name}" unit_files
  local unit_file
  for unit_file in "${unit_files[@]}"; do
    if [[ -f "${backup_dir}/${unit_file}" ]]; then
      if ! cp "${backup_dir}/${unit_file}" "${SYSTEMD_USER_DIR}/"; then
        log_msg "ERROR" "Failed to restore systemd service: ${unit_file}"
        restore_failed=true
      fi
    fi
  done
  systemctl --user daemon-reload

  # Restore Traefik config
  if [[ -f "${backup_dir}/${app_name}.yaml" ]]; then
    if ! cp "${backup_dir}/${app_name}.yaml" "${TRAEFIK_DYNAMIC_DIR}/"; then
      log_msg "ERROR" "Failed to restore Traefik config"
      restore_failed=true
    fi
  fi

  # The app folder per the restored metadata (subfolder deployments)
  local repo_dir="${APPS_DATA_DIR}/${app_name}/repo"
  local restored_subdir=""
  restored_subdir=$(grep -m1 '^SUBDIR=' "${APPS_CONFIG_DIR}/${app_name}/metadata.conf" 2>/dev/null \
    | cut -d= -f2- | tr -d '"') || restored_subdir=""
  local app_dir="${repo_dir}${restored_subdir:+/${restored_subdir}}"

  # Backups leave out .venv and node_modules: rebuild them (only if the
  # repo restore succeeded)
  if [[ "${restore_failed}" == "false" ]]; then
    if ! restore_app_deps "${app_name}" "${repo_dir}" "${app_dir}"; then
      log_msg "ERROR" "Failed to reinstall dependencies"
      restore_failed=true
    fi
  fi

  # Scheduled jobs and the restart limit from what is restored now, also
  # after an error: the jobs of before were removed above
  if [[ -d "${app_dir}" ]]; then
    sync_scheduled_jobs "${app_name}" "${app_dir}"
  fi
  apply_restart_limit "${app_name}"

  # Start service(s). reset-failed first: a unit that hit its start limit
  # (RESTART_LIMIT) refuses every start until then, also this one.
  if [[ "${restore_failed}" == "false" ]]; then
    if get_all_services "${app_name}" services 2>/dev/null; then
      for service in "${services[@]}"; do
        local service_name
        if [[ "${service}" == "frontend" ]] || [[ "${service}" == "${app_name}" ]]; then
          service_name="appmotel-${app_name}"
        else
          service_name="appmotel-${app_name}-${service}"
        fi
        systemctl --user reset-failed "${service_name}" 2>/dev/null || true
        if ! systemctl --user start "${service_name}"; then
          log_msg "ERROR" "Failed to start service: ${service_name}"
          restore_failed=true
        fi
      done
    else
      systemctl --user reset-failed "appmotel-${app_name}" 2>/dev/null || true
      if ! systemctl --user start "appmotel-${app_name}"; then
        log_msg "ERROR" "Failed to start service: appmotel-${app_name}"
        restore_failed=true
      fi
    fi
  fi

  if [[ "${restore_failed}" == "true" ]]; then
    log_msg "ERROR" "Restore completed with errors - app may be in inconsistent state"
    return 1
  fi

  log_msg "INFO" "Restore completed successfully"
  return 0
}

# -----------------------------------------------------------------------------
# Function: restore_app_deps
# Description: Rebuild what backups leave out (.venv and node_modules, at
#   any depth) after a restore, with the rules of cmd_update: per component
#   for multi-component apps; else in the folder with the dependency file,
#   searched up from a subfolder app; a Zensical site is built again.
# Returns: 1 if a setup failed
# -----------------------------------------------------------------------------
restore_app_deps() {
  local app_name="$1" repo_dir="$2" app_dir="$3"
  local failed=false
  local -a services=()
  get_all_services "${app_name}" services 2>/dev/null || services=("${app_name}")

  if is_multi_component "${app_name}"; then
    local component component_dir
    for component in "${services[@]}"; do
      component_dir="${app_dir}/${component}"
      [[ -d "${component_dir}" ]] || component_dir="${app_dir}/src/${component}"
      if [[ -f "${component_dir}/go.mod" ]]; then
        setup_go_env "${component_dir}" || failed=true
      elif [[ -f "${component_dir}/requirements.txt" ]] || [[ -f "${component_dir}/pyproject.toml" ]]; then
        setup_python_env "${component_dir}" || failed=true
      elif [[ -f "${component_dir}/package.json" ]]; then
        setup_nodejs_env "${component_dir}" || failed=true
      fi
    done
  elif is_zensical_site "${app_dir}"; then
    setup_zensical_env "${app_dir}" || failed=true
  else
    local deps_dir="${app_dir}" found_dir marker
    if [[ "${app_dir}" != "${repo_dir}" ]]; then
      for marker in requirements.txt pyproject.toml package.json go.mod; do
        if found_dir=$(find_file_up "${marker}" "${app_dir}" "${repo_dir}"); then
          deps_dir="${found_dir}"
          break
        fi
      done
    fi
    setup_python_env "${deps_dir}" || failed=true
    setup_nodejs_env "${deps_dir}" || failed=true
    setup_go_env "${deps_dir}" || failed=true
  fi
  [[ "${failed}" == "false" ]]
}

# -----------------------------------------------------------------------------
# Function: list_backups
# Description: Lists available backups for an app
# -----------------------------------------------------------------------------
list_backups() {
  local app_name="$1"
  local backup_base="${BACKUPS_DIR}/${app_name}"

  if [[ ! -d "${backup_base}" ]]; then
    log_msg "INFO" "No backups found for app '${app_name}'"
    return
  fi

  printf "%-25s %-8s %s\n" "BACKUP ID" "SIZE" "COMMIT"
  printf "%-25s %-8s %s\n" "---------" "----" "------"

  for backup_dir in "${backup_base}"/*; do
    if [[ -d "${backup_dir}" ]]; then
      local backup_id
      backup_id=$(basename "${backup_dir}")
      local size commit
      size=$(du -sh "${backup_dir}" 2>/dev/null | cut -f1)
      commit=$(head -c 8 "${backup_dir}/COMMIT" 2>/dev/null) || commit=""
      [[ ! -f "${backup_dir}/ROLLBACK_SAFETY" ]] || commit+=" (state before a rollback)"
      printf "%-25s %-8s %s\n" "${backup_id}" "${size}" "${commit:--}"
    fi
  done
}

# -----------------------------------------------------------------------------
# Function: backup_retention
# Description: Print how many backups to keep for an app: BACKUP_RETENTION
#   from its .env (a positive number), else 5.
# -----------------------------------------------------------------------------
backup_retention() {
  local app_name="$1" value=""
  value=$(env_get_value "${APPS_CONFIG_DIR}/${app_name}/.env" BACKUP_RETENTION 2>/dev/null) || value=""
  if [[ "${value}" =~ ^[0-9]+$ ]] && (( 10#${value} > 0 )); then
    echo "$(( 10#${value} ))"
  else
    echo 5
  fi
}

# -----------------------------------------------------------------------------
# Function: validate_backup_id
# Description: A backup id is one directory name (no slash, no leading dot),
#   so it cannot point outside the app's backup directory.
# -----------------------------------------------------------------------------
validate_backup_id() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "Invalid backup id '$1' (see: appmo backups <app-name>)"
}

# -----------------------------------------------------------------------------
# Function: rollback_target
# Description: Print the newest backup of an app whose COMMIT differs from
#   $2 (the deployed HEAD): the version before the last update. Skips the
#   backups appmo rollback makes of the state it replaces (ROLLBACK_SAFETY),
#   so a second rollback goes further back instead of forward again. If no
#   backup records a commit (made before COMMIT existed), the newest backup.
#   Returns 1 if there is none.
# -----------------------------------------------------------------------------
rollback_target() {
  local app_name="$1" head="$2"
  local base="${BACKUPS_DIR}/${app_name}"
  local id commit newest="" any_commit=false
  [[ -d "${base}" ]] || return 1
  while IFS= read -r id; do
    [[ -d "${base}/${id}" ]] || continue
    [[ ! -f "${base}/${id}/ROLLBACK_SAFETY" ]] || continue
    [[ -n "${newest}" ]] || newest="${id}"
    commit=$(cat "${base}/${id}/COMMIT" 2>/dev/null) || commit=""
    [[ -n "${commit}" ]] || continue
    any_commit=true
    if [[ "${commit}" != "${head}" ]]; then
      echo "${id}"
      return 0
    fi
  done < <(ls -1 "${base}" 2>/dev/null | sort -rV)
  if [[ "${any_commit}" == "false" ]] && [[ -n "${newest}" ]]; then
    echo "${newest}"
    return 0
  fi
  return 1
}

# -----------------------------------------------------------------------------
# Function: parse_env_file
# Description: Parses .env file handling quotes and special characters
# Returns: Variable assignments that can be evaluated
# -----------------------------------------------------------------------------
parse_env_file() {
  local env_file="$1"

  if [[ ! -f "${env_file}" ]]; then
    return
  fi

  while IFS= read -r line || [[ -n "${line}" ]]; do
    # Skip empty lines and comments
    [[ -z "${line}" || "${line}" =~ ^[[:space:]]*# ]] && continue

    # Extract key and value
    if [[ "${line}" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
      local key="${BASH_REMATCH[1]}"
      local value="${BASH_REMATCH[2]}"

      # Remove surrounding quotes if present
      if [[ "${value}" =~ ^\"(.*)\"$ ]] || [[ "${value}" =~ ^\'(.*)\'$ ]]; then
        value="${BASH_REMATCH[1]}"
      fi

      # Output properly quoted assignment
      printf '%s=%q\n' "${key}" "${value}"
    fi
  done < "${env_file}"
}

# -----------------------------------------------------------------------------
# Function: parse_procfile
# Description: Parses Procfile and returns process definitions
# Returns: Lines in format "process_name:command"
# -----------------------------------------------------------------------------
parse_procfile() {
  local procfile="$1"

  if [[ ! -f "${procfile}" ]]; then
    return 1
  fi

  while IFS= read -r line || [[ -n "${line}" ]]; do
    # Skip empty lines and comments
    [[ -z "${line}" || "${line}" =~ ^[[:space:]]*# ]] && continue

    # Parse "process_name: command"
    if [[ "${line}" =~ ^([a-zA-Z][a-zA-Z0-9_-]*)[[:space:]]*:[[:space:]]*(.+)$ ]]; then
      local proc_name="${BASH_REMATCH[1]}"
      local proc_cmd="${BASH_REMATCH[2]}"
      echo "${proc_name}:${proc_cmd}"
    fi
  done < "${procfile}"
}

# -----------------------------------------------------------------------------
# Function: port_available
# Description: Check a specific port against listening sockets, other apps'
#   metadata, and an optional space-separated exclude list (ports assigned
#   earlier in the same run whose metadata is not written yet)
# Returns: 0 if available
# -----------------------------------------------------------------------------
port_available() {
  local port="$1"
  local exclude_ports="${2:-}"

  if [[ -n "${exclude_ports}" ]] && echo "${exclude_ports}" | grep -qw "${port}" 2>/dev/null; then
    return 1
  fi

  local allocated_ports
  # isolated.conf holds the ports of isolated apps; in app role appmotel passes
  # the ports of all other apps in APPMO_RESERVED_PORTS
  allocated_ports=$(grep -h "^PORT=" "${APPS_CONFIG_DIR}"/*/metadata.conf "${APPS_CONFIG_DIR}"/*/isolated.conf 2>/dev/null | cut -d'=' -f2 | tr -d '"' || true)
  allocated_ports="${allocated_ports} ${APPMO_RESERVED_PORTS:-}"
  if echo "${allocated_ports}" | grep -qw "${port}" 2>/dev/null; then
    return 1
  fi

  if ss -tuln | grep -q ":${port} "; then
    return 1
  fi

  return 0
}

# -----------------------------------------------------------------------------
# Function: find_free_port
# Description: Finds a random free port
# Parameters: $1 (optional) - space-separated ports to additionally exclude
# -----------------------------------------------------------------------------
find_free_port() {
  local exclude_ports="${1:-}"
  local port
  local max_attempts=100
  local attempt=0

  while [[ ${attempt} -lt ${max_attempts} ]]; do
    # Generate random port in range
    port=$((MIN_PORT + RANDOM % (MAX_PORT - MIN_PORT)))

    if port_available "${port}" "${exclude_ports}"; then
      echo "${port}"
      return 0
    fi

    attempt=$((attempt + 1))
  done

  die "Could not find free port after ${max_attempts} attempts"
}

# -----------------------------------------------------------------------------
# Function: update_port_in_env
# Description: Updates PORT and FLASK_PORT in .env file
# -----------------------------------------------------------------------------
update_port_in_env() {
  local env_file="$1"
  local new_port="$2"

  if [[ ! -f "${env_file}" ]]; then
    return 1
  fi

  # Update PORT if it exists
  if grep -q "^PORT=" "${env_file}"; then
    sed -i "s/^PORT=.*/PORT=${new_port}/" "${env_file}"
  fi

  # Also update FLASK_PORT if it exists (Flask apps)
  if grep -q "^FLASK_PORT=" "${env_file}"; then
    sed -i "s/^FLASK_PORT=.*/FLASK_PORT=${new_port}/" "${env_file}"
  fi
}

# -----------------------------------------------------------------------------
# Function: get_port_from_env
# Description: Extracts port from app's .env file
# Checks both config dir (preferred) and repo dir for .env
# -----------------------------------------------------------------------------
get_port_from_env() {
  local app_name="$1"
  local config_env="${APPS_CONFIG_DIR}/${app_name}/.env"
  local repo_env="${APPS_DATA_DIR}/${app_name}/repo/.env"

  # Prefer config dir .env, fall back to repo .env
  local env_file=""
  if [[ -f "${config_env}" ]] && [[ ! -L "${config_env}" ]]; then
    env_file="${config_env}"
  elif [[ -f "${repo_env}" ]]; then
    env_file="${repo_env}"
  else
    return 1
  fi

  # Look for PORT variable (priority order: PORT, FLASK_PORT, other *PORT* vars)
  local port

  # 1. Check for PORT=
  port=$(grep -E '^PORT=' "${env_file}" | head -1 | cut -d'=' -f2 | tr -d ' "'"'" || true)
  if [[ -n "${port}" ]] && [[ "${port}" =~ ^[0-9]+$ ]]; then
    echo "${port}"
    return 0
  fi

  # 2. Check for FLASK_PORT= (common in Flask apps)
  port=$(grep -E '^FLASK_PORT=' "${env_file}" | head -1 | cut -d'=' -f2 | tr -d ' "'"'" || true)
  if [[ -n "${port}" ]] && [[ "${port}" =~ ^[0-9]+$ ]]; then
    echo "${port}"
    return 0
  fi

  # 3. Check for any other *PORT* variable (NODE_PORT, SERVER_PORT, etc.)
  port=$(grep -iE '^[A-Z_]*PORT[A-Z_]*=' "${env_file}" | head -1 | cut -d'=' -f2 | tr -d ' "'"'" || true)
  if [[ -n "${port}" ]] && [[ "${port}" =~ ^[0-9]+$ ]]; then
    echo "${port}"
    return 0
  fi

  return 1
}

# -----------------------------------------------------------------------------
# Function: save_app_metadata
# Description: Saves app metadata to config directory
# -----------------------------------------------------------------------------
save_app_metadata() {
  local app_name="$1"
  local github_url="$2"
  local branch="$3"
  local port="$4"
  local services="${5:-}"  # Optional services string (space-separated component names)
  local subdir="${6:-}"    # Optional subfolder path within repo
  local processes="${7:-}" # Optional Procfile process names (space-separated)

  local config_dir="${APPS_CONFIG_DIR}/${app_name}"
  mkdir -p "${config_dir}"

  local metadata_file="${config_dir}/metadata.conf"

  cat > "${metadata_file}" <<EOF
APP_NAME="${app_name}"
GITHUB_URL="${github_url}"
BRANCH="${branch}"
PORT="${port}"
LAST_DEPLOYMENT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
EOF

  # Add SERVICES field if provided (for multi-component apps)
  if [[ -n "${services}" ]]; then
    echo "SERVICES=\"${services}\"" >> "${metadata_file}"
  fi

  # Add SUBDIR field if provided (for subfolder deployments)
  if [[ -n "${subdir}" ]]; then
    echo "SUBDIR=\"${subdir}\"" >> "${metadata_file}"
  fi

  # Procfile apps: one unit appmotel-<app>-<process> per process. Not in
  # SERVICES, which means components (folders) to cmd_update and restore.
  if [[ -n "${processes}" ]]; then
    echo "PROCESSES=\"${processes}\"" >> "${metadata_file}"
  fi

  log_msg "INFO" "App metadata saved"
}

# -----------------------------------------------------------------------------
# Function: setup_app_env_file
# Description: Creates physical .env in config dir and symlinks repo/.env to it
# Looks for template: .env.default, env.default, .env.example, env.example, .env.local
# in the app folder only (the subfolder for subfolder deployments)
# -----------------------------------------------------------------------------
setup_app_env_file() {
  local app_name="$1"
  local port="$2"
  local subdir="${3:-}"  # Optional subfolder path

  local config_dir="${APPS_CONFIG_DIR}/${app_name}"
  local config_env="${config_dir}/.env"
  local repo_dir="${APPS_DATA_DIR}/${app_name}/repo"
  local repo_env="${repo_dir}/.env"

  # Determine the app working directory (subfolder or repo root)
  local app_dir="${repo_dir}"
  if [[ -n "${subdir}" ]]; then
    app_dir="${repo_dir}/${subdir}"
  fi
  local app_env="${app_dir}/.env"

  mkdir -p "${config_dir}"

  # If config .env already exists (from backup restore), skip creation
  if [[ -f "${config_env}" ]] && [[ ! -L "${config_env}" ]]; then
    log_msg "INFO" "Using existing .env from config: ${config_env}"
  else
    # Remove any existing symlink in config dir
    rm -f "${config_env}"

    # Template only from the app's own folder: a parent folder's template
    # belongs to the repo or another app (e.g. the appmotel repo's root
    # .env.default is the global config template, not one for examples/*)
    local template_file="" tmpl
    for tmpl in ".env.default" "env.default" ".env.example" "env.example" ".env.local"; do
      if [[ -f "${app_dir}/${tmpl}" ]]; then
        template_file="${app_dir}/${tmpl}"
        break
      fi
    done

    if [[ -n "${template_file}" ]]; then
      # Copy template to config dir
      cp "${template_file}" "${config_env}"
      log_msg "INFO" "Created .env from template: $(basename "${template_file}")"
    elif [[ -f "${app_env}" ]] && [[ ! -L "${app_env}" ]]; then
      # If app dir has a real .env file, move it to config
      mv "${app_env}" "${config_env}"
      log_msg "INFO" "Moved existing .env to config directory"
    elif [[ -f "${repo_env}" ]] && [[ ! -L "${repo_env}" ]]; then
      # Fall back to repo root .env if exists
      mv "${repo_env}" "${config_env}"
      log_msg "INFO" "Moved existing .env from repo root to config directory"
    else
      # Create empty .env with just PORT
      echo "PORT=${port}" > "${config_env}"
      log_msg "INFO" "Created new .env with PORT=${port}"
    fi
  fi

  # Ensure PORT is set in .env and override any low ports (< 10001)
  # Apps should not dictate their own ports - the PaaS assigns them
  local port_updated=false
  if grep -q "^PORT=" "${config_env}" 2>/dev/null; then
    local existing_port
    existing_port=$(grep "^PORT=" "${config_env}" | cut -d'=' -f2 | tr -d ' ')
    if [[ "${existing_port}" =~ ^[0-9]+$ ]] && [[ "${existing_port}" -lt 10001 ]]; then
      log_msg "WARN" "Overriding low port ${existing_port} with assigned port ${port}"
      update_port_in_env "${config_env}" "${port}"
      port_updated=true
    fi
  else
    echo "PORT=${port}" >> "${config_env}"
    port_updated=true
  fi

  # Always update FLASK_PORT if it exists and we're setting a port
  if [[ "${port_updated}" == "true" ]] && grep -q "^FLASK_PORT=" "${config_env}" 2>/dev/null; then
    log_msg "INFO" "Updating FLASK_PORT to match assigned PORT ${port}"
    sed -i "s/^FLASK_PORT=.*/FLASK_PORT=${port}/" "${config_env}"
  fi

  # Verify config .env exists before creating symlinks
  if [[ ! -f "${config_env}" ]]; then
    die "Failed to create symlink: config .env does not exist at ${config_env}"
  fi

  # Remove any existing .env in repo root (file or symlink)
  rm -f "${repo_env}"

  # Create symlink from repo/.env -> config/.env
  if ! ln -s "${config_env}" "${repo_env}"; then
    die "Failed to create .env symlink: ${repo_env} -> ${config_env}"
  fi
  log_msg "INFO" "Created symlink: ${repo_env} -> ${config_env}"

  # For subfolder deployments, also create symlink in the subfolder
  if [[ -n "${subdir}" ]] && [[ "${app_env}" != "${repo_env}" ]]; then
    rm -f "${app_env}"
    if ! ln -s "${config_env}" "${app_env}"; then
      die "Failed to create .env symlink: ${app_env} -> ${config_env}"
    fi
    log_msg "INFO" "Created subfolder symlink: ${app_env} -> ${config_env}"
  fi
}

# -----------------------------------------------------------------------------
# Function: load_app_metadata
# Description: Loads app metadata from config directory
# -----------------------------------------------------------------------------
load_app_metadata() {
  local app_name="$1"
  local metadata_file="${APPS_CONFIG_DIR}/${app_name}/metadata.conf"

  if [[ ! -f "${metadata_file}" ]]; then
    die "App metadata not found for '${app_name}'"
  fi

  # Optional keys: clear them, so an app without one does not keep the value
  # of the app loaded before it (autopull updates many apps in one shell)
  unset SERVICES SUBDIR PROCESSES
  safe_source_metadata "${metadata_file}"
}

# -----------------------------------------------------------------------------
# Function: detect_app_type
# Description: Detects application type and returns start command
# Priority: Go (if go.mod exists) > Python > Node.js > Binary
# -----------------------------------------------------------------------------
detect_app_type() {
  local repo_dir="$1"
  local -n cmd_ref=$2

  # Check for start.sh script first (component-specific startup)
  if [[ -f "${repo_dir}/start.sh" ]]; then
    cmd_ref="bash start.sh"
    return 0
  fi

  # Zensical docs site: served by the static server setup_zensical_env wrote
  # into .venv (python3 is swapped for the venv python by the caller)
  if is_zensical_site "${repo_dir}"; then
    cmd_ref="python3 .venv/bin/appmotel-static-server $(zensical_site_dir "${repo_dir}")"
    return 0
  fi

  # Check Go first (highest priority when go.mod exists)
  # Priority: start.sh > Go > Python > Node.js > Binary
  if [[ -f "${repo_dir}/go.mod" ]]; then
    # Go app - binary should be in bin/ after setup_go_env runs
    if [[ -d "${repo_dir}/bin" ]] && [[ $(find "${repo_dir}/bin" -type f -executable | wc -l) -ge 1 ]]; then
      local bin_file
      # Prefer binary matching module name
      local module_name
      module_name=$(grep "^module " "${repo_dir}/go.mod" | awk '{print $2}' | xargs basename)
      if [[ -x "${repo_dir}/bin/${module_name}" ]]; then
        cmd_ref="bin/${module_name}"
      else
        bin_file=$(find "${repo_dir}/bin" -type f -executable | head -1)
        cmd_ref="bin/$(basename "${bin_file}")"
      fi
      return 0
    fi
    # Binary not built yet, will be built by setup_go_env
    local module_name
    module_name=$(grep "^module " "${repo_dir}/go.mod" | awk '{print $2}' | xargs basename)
    cmd_ref="bin/${module_name}"
    return 0
  else
    # Python app detection - check for .py files
    # (requirements.txt may be in parent directory for subfolder deployments)
    local py_file=""

    # 1. Check for app.py (most common)
    if [[ -f "${repo_dir}/app.py" ]]; then
      py_file="app.py"
    # 2. Check for main.py
    elif [[ -f "${repo_dir}/main.py" ]]; then
      py_file="main.py"
    # 3. Check for <repo_name>.py (e.g., bedbot.py for bedbot repo)
    else
      local repo_name
      repo_name=$(basename "${repo_dir}")
      # Handle "repo" directory from our clone structure
      if [[ "${repo_name}" == "repo" ]]; then
        repo_name=$(basename "$(dirname "${repo_dir}")")
      fi
      if [[ -f "${repo_dir}/${repo_name}.py" ]]; then
        py_file="${repo_name}.py"
      # 4. Check for *<repo_name>*.py pattern (e.g., my-bedbot-app.py)
      elif [[ -n "$(find "${repo_dir}" -maxdepth 1 -name "*${repo_name}*.py" -type f 2>/dev/null | head -1)" ]]; then
        py_file=$(basename "$(find "${repo_dir}" -maxdepth 1 -name "*${repo_name}*.py" -type f | head -1)")
      # 5. Check if there's exactly one .py file
      elif [[ $(find "${repo_dir}" -maxdepth 1 -name "*.py" -type f | wc -l) -eq 1 ]]; then
        py_file=$(basename "$(find "${repo_dir}" -maxdepth 1 -name "*.py" -type f | head -1)")
      fi
    fi

    if [[ -n "${py_file}" ]]; then
      cmd_ref="python3 ${py_file}"
      return 0
    fi
  fi

  # Check for Node.js app
  if [[ -f "${repo_dir}/package.json" ]]; then
    # Node.js app
    cmd_ref="npm start"
    return 0
  fi

  # Check for single executable in bin
  if [[ -d "${repo_dir}/bin" ]] && [[ $(find "${repo_dir}/bin" -type f -executable | wc -l) -eq 1 ]]; then
    local bin_file
    bin_file=$(find "${repo_dir}/bin" -type f -executable | head -1)
    cmd_ref="bin/$(basename "${bin_file}")"
    return 0
  fi

  return 1
}

# =============================================================================
# Function: detect_components
# Description: Detects multi-component app structure (frontend, backend, etc)
# Returns: Modifies array passed by name reference
# Known components: frontend, backend, api, worker, db, cache
# =============================================================================
detect_components() {
  local repo_dir="$1"
  local -n components_ref=$2  # Output array

  local known_components=("frontend" "backend" "api" "worker" "db" "cache")
  local detected=()

  # Check each known component directory (both root and src/ subdirectory)
  for component in "${known_components[@]}"; do
    local component_path=""

    # Check root level first (e.g., frontend/, backend/)
    if [[ -d "${repo_dir}/${component}" ]]; then
      component_path="${repo_dir}/${component}"
    # Then check src/ subdirectory (e.g., src/frontend/, src/backend/)
    elif [[ -d "${repo_dir}/src/${component}" ]]; then
      component_path="${repo_dir}/src/${component}"
    fi

    # Check if component directory exists and has app markers
    if [[ -n "${component_path}" ]]; then
      if [[ -f "${component_path}/package.json" ]] || \
         [[ -f "${component_path}/requirements.txt" ]] || \
         [[ -f "${component_path}/pyproject.toml" ]] || \
         [[ -f "${component_path}/go.mod" ]]; then
        detected+=("${component}")
      fi
    fi
  done

  # Return detected components
  components_ref=("${detected[@]}")
}

# =============================================================================
# Function: get_all_services
# Description: Returns all services for an app from metadata SERVICES field
# Returns: Modifies array passed by name reference
# Fallback: If SERVICES not set, assumes single app for backward compatibility
# =============================================================================
get_all_services() {
  local app_name="$1"
  local -n services_ref=$2  # Output array

  local metadata_file="${APPS_CONFIG_DIR}/${app_name}/metadata.conf"

  if [[ ! -f "${metadata_file}" ]]; then
    services_ref=()
    return 1
  fi

  # Load SERVICES field from metadata (space-separated component names)
  local services_str
  services_str=$(grep "^SERVICES=" "${metadata_file}" 2>/dev/null | cut -d'=' -f2 | tr -d '"' || true)

  # Procfile apps: their processes (units appmotel-<app>-<process>)
  if [[ -z "${services_str}" ]]; then
    services_str=$(grep "^PROCESSES=" "${metadata_file}" 2>/dev/null | cut -d'=' -f2 | tr -d '"' || true)
  fi

  # Procfile apps added before PROCESSES existed: the processes of the
  # Procfile, if the app has no single unit appmotel-<app>.service
  if [[ -z "${services_str}" ]] && [[ ! -f "${SYSTEMD_USER_DIR}/appmotel-${app_name}.service" ]]; then
    local subdir="" procfile line
    subdir=$(grep -m1 '^SUBDIR=' "${metadata_file}" 2>/dev/null | cut -d= -f2- | tr -d '"') || subdir=""
    procfile="${APPS_DATA_DIR}/${app_name}/repo${subdir:+/${subdir}}/Procfile"
    if [[ -f "${procfile}" ]]; then
      while IFS= read -r line; do
        services_str+="${services_str:+ }${line%%:*}"
      done < <(parse_procfile "${procfile}")
    fi
  fi

  if [[ -n "${services_str}" ]]; then
    # Convert space-separated to array (temporarily use default IFS for splitting)
    local saved_ifs="${IFS}"
    IFS=' '
    read -ra services_ref <<< "${services_str}"
    IFS="${saved_ifs}"
  else
    # Fallback for single-component apps (backward compatibility)
    # Apps without SERVICES field use the app name as single service
    services_ref=("${app_name}")
  fi
}

# True if the app has components (SERVICES: folders like frontend/backend),
# not Procfile processes: only components get their own dependency setup
is_multi_component() {
  local services_str
  services_str=$(grep "^SERVICES=" "${APPS_CONFIG_DIR}/$1/metadata.conf" 2>/dev/null | cut -d'=' -f2 | tr -d '"' || true)
  [[ "${services_str}" == *" "* ]]
}

# -----------------------------------------------------------------------------
# Function: get_app_unit_files
# Description: Resolve the exact systemd unit file names an app owns, from
#   metadata. Used instead of the glob appmotel-${app_name}*.service, which
#   would also match a different app whose name shares the prefix (backing up
#   app "foo" must not capture app "foo-bar"'s unit).
# Parameters: $1 = app_name, $2 = nameref to output array
# -----------------------------------------------------------------------------
get_app_unit_files() {
  local app_name="$1"
  local -n units_ref=$2
  units_ref=()

  local -a services
  if ! get_all_services "${app_name}" services 2>/dev/null || [[ ${#services[@]} -eq 0 ]]; then
    services=("${app_name}")
  fi

  local service
  for service in "${services[@]}"; do
    if [[ "${service}" == "frontend" ]] || [[ "${service}" == "${app_name}" ]]; then
      units_ref+=("appmotel-${app_name}.service")
    else
      units_ref+=("appmotel-${app_name}-${service}.service")
    fi
  done
}

# -----------------------------------------------------------------------------
# Function: unit_props
# Description: Read properties of a user unit into an associative array.
#   systemctl show prints KEY=VALUE lines in its own order, not in the order
#   asked for, so --value with several properties cannot be used. A missing
#   unit gives LoadState=not-found.
# Parameters: $1 = unit, $2 = nameref to an associative array, $3... = properties
# -----------------------------------------------------------------------------
unit_props() {
  local unit="$1"
  local -n unit_props_ref=$2
  shift 2
  local line list
  unit_props_ref=()
  list=$(IFS=','; printf '%s' "$*")
  while IFS= read -r line; do
    if [[ "${line}" == *=* ]]; then
      unit_props_ref["${line%%=*}"]="${line#*=}"
    fi
  done < <(systemctl --user show -p "${list}" "${unit}" 2>/dev/null || true)
}

# A systemd counter that is set: digits, not UINT64_MAX ("not tracked"), and
# small enough for Bash arithmetic
is_counter() {
  [[ "$1" =~ ^[0-9]+$ ]] && [[ ${#1} -le 18 ]]
}

# -----------------------------------------------------------------------------
# Function: restart_limit_directives
# Description: [Unit] lines that make systemd stop restarting a crashing app.
#   Off unless the app .env sets RESTART_LIMIT=N (1-100): after N starts
#   within RESTART_WINDOW seconds (default 300) the unit fails and stays down
#   until appmo start/restart. Without it a crashing app is restarted every
#   10 s forever (autopull reports the crash loop either way).
# Parameters: $1 = app .env file
# -----------------------------------------------------------------------------
restart_limit_directives() {
  local env_file="$1" limit="" window=""
  [[ -f "${env_file}" ]] || return 0
  limit=$(env_get_value "${env_file}" RESTART_LIMIT 2>/dev/null) || limit=""
  [[ -n "${limit}" ]] || return 0
  if [[ ! "${limit}" =~ ^[0-9]{1,3}$ ]] || (( 10#${limit} < 1 || 10#${limit} > 100 )); then
    log_msg "WARN" "RESTART_LIMIT=${limit} is not a number from 1 to 100, ignored"
    return 0
  fi
  window=$(env_get_value "${env_file}" RESTART_WINDOW 2>/dev/null) || window=""
  if [[ ! "${window}" =~ ^[0-9]{1,5}$ ]] || (( 10#${window} < 10 || 10#${window} > 86400 )); then
    [[ -z "${window}" ]] || log_msg "WARN" "RESTART_WINDOW=${window} is not 10-86400 seconds, using 300"
    window=300
  fi
  printf 'StartLimitIntervalSec=%s\nStartLimitBurst=%s\n' "$(( 10#${window} ))" "$(( 10#${limit} ))"
}

# -----------------------------------------------------------------------------
# Function: apply_restart_limit
# Description: Write or remove the drop-in <unit>.d/restart-limit.conf of
#   each unit of the app, from RESTART_LIMIT/RESTART_WINDOW in its .env. A
#   drop-in, not the unit file: appmo writes unit files only on add, but runs
#   this on add, update, start, restart and restore, so a changed limit needs
#   only appmo restart (like every other .env change).
# -----------------------------------------------------------------------------
apply_restart_limit() {
  local app_name="$1"
  local env_file="${APPS_CONFIG_DIR}/${app_name}/.env"
  local directives content unit dropin_dir dropin changed=false
  local -a units=()
  get_app_unit_files "${app_name}" units
  directives=$(restart_limit_directives "${env_file}")
  content=$(printf '# Written by appmo from RESTART_LIMIT in the app .env\n[Unit]\n%s' "${directives}")
  for unit in "${units[@]}"; do
    dropin_dir="${SYSTEMD_USER_DIR}/${unit}.d"
    dropin="${dropin_dir}/restart-limit.conf"
    if [[ -n "${directives}" ]]; then
      if [[ ! -f "${dropin}" ]] || [[ "$(cat "${dropin}")" != "${content}" ]]; then
        mkdir -p "${dropin_dir}"
        printf '%s\n' "${content}" > "${dropin}"
        changed=true
      fi
    elif [[ -f "${dropin}" ]]; then
      rm -f "${dropin}"
      rmdir "${dropin_dir}" 2>/dev/null || true
      changed=true
    fi
  done
  if [[ "${changed}" == "true" ]]; then
    systemctl --user daemon-reload 2>/dev/null || true
  fi
}

# -----------------------------------------------------------------------------
# Function: schedule_parse_line
# Description: Split a line of appmo-schedule, "<calendar> | <command>", into
#   the namerefs $2 (a systemd OnCalendar expression) and $3 (the command).
#   The calendar may only use the characters of OnCalendar expressions, so
#   it cannot change the timer unit it is written into.
# Returns: 0 job line, 1 blank or comment line, 2 malformed line
# -----------------------------------------------------------------------------
schedule_parse_line() {
  local line="${1%$'\r'}"
  local -n schedule_calendar_ref=$2
  local -n schedule_command_ref=$3
  local parsed_calendar parsed_command
  local calendar_re='^[A-Za-z0-9 _,:./*~+-]+$'
  schedule_calendar_ref=""
  schedule_command_ref=""

  if [[ "${line}" =~ ^[[:space:]]*(#.*)?$ ]]; then
    return 1
  fi
  [[ "${line}" == *" | "* ]] || return 2
  parsed_calendar="${line%% | *}"
  parsed_command="${line#* | }"
  parsed_calendar="${parsed_calendar#"${parsed_calendar%%[![:space:]]*}"}"
  parsed_calendar="${parsed_calendar%"${parsed_calendar##*[![:space:]]}"}"
  parsed_command="${parsed_command#"${parsed_command%%[![:space:]]*}"}"
  parsed_command="${parsed_command%"${parsed_command##*[![:space:]]}"}"
  [[ -n "${parsed_calendar}" ]] && [[ -n "${parsed_command}" ]] || return 2
  [[ "${parsed_calendar}" =~ ${calendar_re} ]] || return 2
  # No calendar starts with "-"; such a value would be read as an option
  [[ "${parsed_calendar}" != -* ]] || return 2

  schedule_calendar_ref="${parsed_calendar}"
  schedule_command_ref="${parsed_command}"
}

# -----------------------------------------------------------------------------
# Function: remove_scheduled_jobs
# Description: Disable and delete the job timers and services named in the
#   app's jobs.list. A job that is running is left to finish, unless $2 is
#   "stop" (appmo remove).
# -----------------------------------------------------------------------------
remove_scheduled_jobs() {
  local app_name="$1" mode="${2:-}"
  local config_dir="${APPS_CONFIG_DIR}/${app_name}"
  local list_file="${config_dir}/jobs.list" unit
  [[ -f "${list_file}" ]] || return 0
  while IFS= read -r unit; do
    [[ "${unit}" =~ ^appmotel-"${app_name}"[.]job-[0-9]+$ ]] || continue
    systemctl --user disable --now "${unit}.timer" >/dev/null 2>&1 || true
    if [[ "${mode}" == "stop" ]]; then
      systemctl --user stop "${unit}.service" >/dev/null 2>&1 || true
    fi
    rm -f "${SYSTEMD_USER_DIR}/${unit}.timer" "${SYSTEMD_USER_DIR}/${unit}.service"
  done < "${list_file}"
  rm -f "${list_file}"
  if [[ -d "${config_dir}/jobs" ]]; then
    safe_rm_rf "${config_dir}/jobs" "remove_scheduled_jobs"
  fi
  systemctl --user daemon-reload 2>/dev/null || true
}

# -----------------------------------------------------------------------------
# Function: sync_scheduled_jobs
# Description: (Re)create the app's scheduled jobs from appmo-schedule in the
#   app folder: per line a timer and a oneshot service appmotel-<app>.job-<n>,
#   run in the app folder with the app's .env, its venv on PATH, and its
#   MEMORY_LIMIT/CPU_QUOTA. The command goes into a script in the config dir,
#   so it needs no quoting for systemd. Bad lines are skipped with a warning:
#   a deploy never fails here.
# Parameters: $1 = app name, $2 = app folder (repo or its subfolder)
# -----------------------------------------------------------------------------
sync_scheduled_jobs() {
  local app_name="$1" app_dir="$2"
  local config_dir="${APPS_CONFIG_DIR}/${app_name}"
  local schedule="${app_dir}/${SCHEDULE_FILE_NAME}"

  remove_scheduled_jobs "${app_name}"
  [[ -f "${schedule}" ]] || return 0
  if ! command -v systemd-analyze >/dev/null 2>&1; then
    log_msg "WARN" "systemd-analyze not found: ${SCHEDULE_FILE_NAME} ignored"
    return 0
  fi

  local env_file="${config_dir}/.env"
  local env_directive="" path_directive="" memory_limit="" cpu_quota="" timeout=""
  if [[ -f "${env_file}" ]]; then
    env_directive="EnvironmentFile=${env_file}"
    memory_limit=$(env_get_value "${env_file}" MEMORY_LIMIT 2>/dev/null) || memory_limit=""
    cpu_quota=$(env_get_value "${env_file}" CPU_QUOTA 2>/dev/null) || cpu_quota=""
    timeout=$(env_get_value "${env_file}" JOB_TIMEOUT 2>/dev/null) || timeout=""
  fi
  [[ -n "${memory_limit}" ]] || memory_limit="${DEFAULT_MEMORY_LIMIT}"
  [[ -n "${cpu_quota}" ]] || cpu_quota="${DEFAULT_CPU_QUOTA}"
  if [[ ! "${timeout}" =~ ^[0-9]+(s|min|h|d)?$ ]]; then
    [[ -z "${timeout}" ]] || log_msg "WARN" "JOB_TIMEOUT=${timeout} is not like 30min, 2h or 1d; using 1h"
    timeout="1h"
  fi

  # The venv may be in a parent folder for subfolder deployments
  local search_dir="${app_dir}" data_dir="${APPS_DATA_DIR}/${app_name}"
  while [[ "${search_dir}" == "${data_dir}"/* ]]; do
    if [[ -x "${search_dir}/.venv/bin/python3" ]]; then
      path_directive="Environment=\"PATH=${search_dir}/.venv/bin:/usr/local/bin:/usr/bin:/bin\""
      break
    fi
    search_dir=$(dirname "${search_dir}")
  done

  mkdir -p "${config_dir}/jobs" "${SYSTEMD_USER_DIR}"
  local line calendar command unit script line_no=0 n=0 rc
  local -a units=()
  while IFS= read -r line || [[ -n "${line}" ]]; do
    line_no=$((line_no + 1))
    rc=0
    schedule_parse_line "${line}" calendar command || rc=$?
    if [[ ${rc} -eq 1 ]]; then
      continue
    elif [[ ${rc} -ne 0 ]]; then
      log_msg "WARN" "${SCHEDULE_FILE_NAME} line ${line_no}: expected '<calendar> | <command>', skipped"
      continue
    fi
    if ! systemd-analyze calendar -- "${calendar}" >/dev/null 2>&1; then
      log_msg "WARN" "${SCHEDULE_FILE_NAME} line ${line_no}: '${calendar}' is not a systemd calendar expression (man systemd.time), skipped"
      continue
    fi
    if [[ ${#units[@]} -ge ${MAX_SCHEDULED_JOBS} ]]; then
      log_msg "WARN" "${SCHEDULE_FILE_NAME}: more than ${MAX_SCHEDULED_JOBS} jobs, the rest is skipped"
      break
    fi
    n=$((n + 1))
    # The dot keeps job units apart from app units: app, component and
    # Procfile names cannot contain one (an app "x-job-1" would otherwise own
    # appmotel-x-job-1.service). A file of that name left over is not ours.
    unit="appmotel-${app_name}.job-${n}"
    if [[ -e "${SYSTEMD_USER_DIR}/${unit}.service" ]] || [[ -e "${SYSTEMD_USER_DIR}/${unit}.timer" ]]; then
      log_msg "WARN" "${SCHEDULE_FILE_NAME} line ${line_no}: ${unit} exists and is not in jobs.list, skipped"
      continue
    fi

    script="${config_dir}/jobs/job-${n}.sh"
    printf '# %s line %s of app %s, runs at: %s\n%s\n' \
      "${SCHEDULE_FILE_NAME}" "${line_no}" "${app_name}" "${calendar}" "${command}" > "${script}"

    cat > "${SYSTEMD_USER_DIR}/${unit}.service" <<EOF
[Unit]
Description=Appmotel scheduled job: ${app_name} (${SCHEDULE_FILE_NAME} line ${line_no})

[Service]
Type=oneshot
WorkingDirectory=${app_dir}
${env_directive}
${path_directive}
Environment="HOME=${APPMO_HOME}"
Environment="USER=$(id -un)"
ExecStart=/bin/bash ${script}
TimeoutStartSec=${timeout}

# Resource limits
MemoryMax=${memory_limit}
CPUQuota=${cpu_quota}

StandardOutput=journal
StandardError=journal
EOF

    cat > "${SYSTEMD_USER_DIR}/${unit}.timer" <<EOF
[Unit]
Description=Appmotel schedule: ${app_name} (${calendar})

[Timer]
OnCalendar=${calendar}
Persistent=true
Unit=${unit}.service

[Install]
WantedBy=timers.target
EOF
    units+=("${unit}")
  done < "${schedule}"

  if [[ ${#units[@]} -eq 0 ]]; then
    rmdir "${config_dir}/jobs" 2>/dev/null || true
    return 0
  fi
  printf '%s\n' "${units[@]}" > "${config_dir}/jobs.list"
  systemctl --user daemon-reload
  for unit in "${units[@]}"; do
    systemctl --user enable --now "${unit}.timer" >/dev/null 2>&1 \
      || log_msg "WARN" "Could not start ${unit}.timer"
  done
  log_msg "INFO" "Scheduled ${#units[@]} job(s) from ${SCHEDULE_FILE_NAME} (appmo status ${app_name} shows the next runs)"
}

# Start or stop the timers of an app's scheduled jobs (appmo start / stop)
job_timers_ctl() {
  local app_name="$1" action="$2" unit
  local list_file="${APPS_CONFIG_DIR}/${app_name}/jobs.list"
  [[ -f "${list_file}" ]] || return 0
  while IFS= read -r unit; do
    [[ "${unit}" =~ ^appmotel-"${app_name}"[.]job-[0-9]+$ ]] || continue
    systemctl --user "${action}" "${unit}.timer" >/dev/null 2>&1 \
      || log_msg "WARN" "Could not ${action} ${unit}.timer"
  done < "${list_file}"
}

# Print the job units of an app (one per line, from jobs.list)
job_units() {
  local app_name="$1" unit
  local list_file="${APPS_CONFIG_DIR}/${app_name}/jobs.list"
  [[ -f "${list_file}" ]] || return 0
  while IFS= read -r unit; do
    if [[ "${unit}" =~ ^appmotel-"${app_name}"[.]job-[0-9]+$ ]]; then
      echo "${unit}"
    fi
  done < "${list_file}"
}

# =============================================================================
# Function: create_systemd_service
# Description: Creates systemd service for app or app component
# Parameters:
#   $1: app_name
#   $2: repo_dir (or component_dir if component specified)
#   $3: [optional] component_name (e.g., "frontend", "backend")
#   $4: [optional] component_port (internal port for backends, uses PORT from env for frontend)
# Examples:
#   create_systemd_service myapp /path/to/repo                    # Single app
#   create_systemd_service compliance /path/to/compliance/frontend # Frontend component
#   create_systemd_service compliance /path/to/compliance/backend 8001  # Backend component
# =============================================================================
create_systemd_service() {
  local app_name="$1"
  local repo_dir="$2"
  local port="$3"
  local component_name="${4:-}"  # Optional component name (e.g., "frontend", "backend")

  # Service file naming: appmotel-{app_name}[-{component_name}].service
  # Frontend gets no suffix (appmotel-<app>.service), others get suffix
  local service_name="appmotel-${app_name}"
  if [[ -n "${component_name}" ]] && [[ "${component_name}" != "frontend" ]]; then
    service_name="${service_name}-${component_name}"
  fi
  local service_file="${SYSTEMD_USER_DIR}/${service_name}.service"
  mkdir -p "${SYSTEMD_USER_DIR}"
  local env_file="${repo_dir}/.env"

  # Detect app type and get start command
  local start_cmd=""
  if ! detect_app_type "${repo_dir}" start_cmd; then
    die "Could not determine how to run the app. Please check app structure."
  fi

  log_msg "INFO" "Detected start command: ${start_cmd}"

  # For Python apps, find venv (may be in parent directory for subfolder deployments)
  local venv_dir=""
  local search_dir="${repo_dir}"
  local app_data_dir
  app_data_dir=$(dirname "$(dirname "${repo_dir}")")  # Go up from repo/subfolder to app_data

  while [[ -n "${search_dir}" ]] && [[ "${search_dir}" == "${app_data_dir}"* ]]; do
    if [[ -d "${search_dir}/.venv" ]]; then
      venv_dir="${search_dir}/.venv"
      break
    fi
    local parent_dir
    parent_dir=$(dirname "${search_dir}")
    if [[ "${parent_dir}" == "${search_dir}" ]]; then
      break
    fi
    search_dir="${parent_dir}"
  done

  # For Python apps, use the venv python directly
  # Only apply if start_cmd actually uses python3 (not for Go/Node apps with requirements.txt)
  if [[ "${start_cmd}" == *"python3"* ]] && [[ -n "${venv_dir}" ]] && [[ -f "${venv_dir}/bin/python3" ]]; then
    # Replace python3 with full path to venv python
    start_cmd="${start_cmd/python3/${venv_dir}\/bin\/python3}"
    log_msg "INFO" "Using virtual environment Python: ${start_cmd}"
  elif [[ -n "${venv_dir}" ]] && [[ -f "${venv_dir}/bin/python3" ]]; then
    # Python venv exists - PATH will be set in service file
    log_msg "INFO" "Virtual environment detected at: ${venv_dir}"
  fi

  # Build environment file directive
  local env_directive=""
  if [[ -f "${env_file}" ]]; then
    env_directive="EnvironmentFile=${env_file}"
  fi

  # Get resource limits from .env or use defaults
  local memory_limit="${DEFAULT_MEMORY_LIMIT}"
  local cpu_quota="${DEFAULT_CPU_QUOTA}"

  if [[ -f "${env_file}" ]]; then
    # Parse env file for resource overrides
    local parsed_env
    parsed_env=$(parse_env_file "${env_file}")
    if echo "${parsed_env}" | grep -q "^MEMORY_LIMIT="; then
      memory_limit=$(echo "${parsed_env}" | grep "^MEMORY_LIMIT=" | cut -d= -f2-)
    fi
    if echo "${parsed_env}" | grep -q "^CPU_QUOTA="; then
      cpu_quota=$(echo "${parsed_env}" | grep "^CPU_QUOTA=" | cut -d= -f2-)
    fi
  fi

  # Build description with optional component
  local description="Appmotel Application: ${app_name}"
  if [[ -n "${component_name}" ]]; then
    description="${description} (${component_name})"
  fi

  # For Python apps with venv, add PATH to include venv bin
  local path_directive=""
  if [[ -n "${venv_dir}" ]] && [[ -f "${venv_dir}/bin/python3" ]]; then
    path_directive="Environment=\"PATH=${venv_dir}/bin:/usr/local/bin:/usr/bin:/bin\""
  fi

  cat > "${service_file}" <<EOF
[Unit]
Description=${description}
After=network-online.target

[Service]
Type=simple
WorkingDirectory=${repo_dir}
${env_directive}
${path_directive}
Environment="PORT=${port}"
Environment="HOME=${APPMO_HOME}"
Environment="USER=$(id -un)"
ExecStart=/bin/bash -c '${start_cmd}'
Restart=always
RestartSec=10

# Resource limits
MemoryMax=${memory_limit}
CPUQuota=${cpu_quota}

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
EOF

  # Ensure XDG_RUNTIME_DIR is set
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"

  systemctl --user daemon-reload
  log_msg "INFO" "Systemd user service created: ${service_name}"
}

# -----------------------------------------------------------------------------
# Function: create_systemd_service_procfile
# Description: Creates systemd service for a Procfile process
# -----------------------------------------------------------------------------
create_systemd_service_procfile() {
  local app_name="$1"
  local proc_name="$2"
  local repo_dir="$3"
  local port="$4"
  local start_cmd="$5"

  local service_file="${SYSTEMD_USER_DIR}/appmotel-${app_name}-${proc_name}.service"
  mkdir -p "${SYSTEMD_USER_DIR}"
  local env_file="${repo_dir}/.env"

  # For Python apps, use the venv python directly
  # Only apply if start_cmd actually uses python (not for Go/Node apps)
  if [[ "${start_cmd}" == *"python"* ]] && [[ -f "${repo_dir}/.venv/bin/python3" ]]; then
    start_cmd="${start_cmd/python3/${repo_dir}\/.venv\/bin\/python3}"
    start_cmd="${start_cmd/python /${repo_dir}\/.venv\/bin\/python3 }"
  fi

  # Build environment file directive
  local env_directive=""
  if [[ -f "${env_file}" ]]; then
    env_directive="EnvironmentFile=${env_file}"
  fi

  # Get resource limits
  local memory_limit="${DEFAULT_MEMORY_LIMIT}"
  local cpu_quota="${DEFAULT_CPU_QUOTA}"

  if [[ -f "${env_file}" ]]; then
    local parsed_env
    parsed_env=$(parse_env_file "${env_file}")
    if echo "${parsed_env}" | grep -q "^MEMORY_LIMIT="; then
      memory_limit=$(echo "${parsed_env}" | grep "^MEMORY_LIMIT=" | cut -d= -f2-)
    fi
    if echo "${parsed_env}" | grep -q "^CPU_QUOTA="; then
      cpu_quota=$(echo "${parsed_env}" | grep "^CPU_QUOTA=" | cut -d= -f2-)
    fi
  fi

  cat > "${service_file}" <<EOF
[Unit]
Description=Appmotel Application: ${app_name} (${proc_name})
After=network-online.target

[Service]
Type=simple
WorkingDirectory=${repo_dir}
${env_directive}
Environment="PORT=${port}"
Environment="HOME=${APPMO_HOME}"
Environment="USER=$(id -un)"
ExecStart=/bin/bash -c '${start_cmd}'
Restart=always
RestartSec=10

# Resource limits
MemoryMax=${memory_limit}
CPUQuota=${cpu_quota}

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
EOF

  systemctl --user daemon-reload
  log_msg "INFO" "Systemd service created: appmotel-${app_name}-${proc_name}"
}

# -----------------------------------------------------------------------------
# Function: create_traefik_config
# Description: Creates Traefik dynamic configuration for app
# -----------------------------------------------------------------------------
create_traefik_config() {
  local app_name="$1"
  local port="$2"
  local base_domain="${3:-apps.example.edu}"
  local env_file="${4:-}"

  if [[ "${APPMO_ROLE}" == "app" ]]; then
    log_msg "INFO" "Traefik route is managed by appmotel (updated on its next autopull or appmo command)"
    return 0
  fi

  local config_file="${TRAEFIK_DYNAMIC_DIR}/${app_name}.yaml"
  local app_url="${app_name}.${base_domain}"

  # Get rate limit settings from .env or use defaults
  local rate_limit_avg="${DEFAULT_RATE_LIMIT_AVG}"
  local rate_limit_burst="${DEFAULT_RATE_LIMIT_BURST}"
  local health_check_path=""  # No health check by default - only if app explicitly sets it
  local enable_rate_limit="true"

  if [[ -n "${env_file}" ]] && [[ -f "${env_file}" ]]; then
    local parsed_env
    parsed_env=$(parse_env_file "${env_file}")
    if echo "${parsed_env}" | grep -q "^RATE_LIMIT_AVG="; then
      rate_limit_avg=$(echo "${parsed_env}" | grep "^RATE_LIMIT_AVG=" | cut -d= -f2-)
    fi
    if echo "${parsed_env}" | grep -q "^RATE_LIMIT_BURST="; then
      rate_limit_burst=$(echo "${parsed_env}" | grep "^RATE_LIMIT_BURST=" | cut -d= -f2-)
    fi
    if echo "${parsed_env}" | grep -q "^HEALTH_CHECK_PATH="; then
      health_check_path=$(echo "${parsed_env}" | grep "^HEALTH_CHECK_PATH=" | cut -d= -f2-)
    fi
    if echo "${parsed_env}" | grep -q "^DISABLE_RATE_LIMIT="; then
      enable_rate_limit="false"
    fi
  fi

  # These values come from the app's .env and go into Traefik's YAML
  if [[ ! "${port}" =~ ^[0-9]+$ ]]; then
    log_msg "WARN" "Invalid port '${port}', Traefik config not written"
    return 1
  fi
  if [[ ! "${rate_limit_avg}" =~ ^[0-9]+$ ]]; then
    log_msg "WARN" "Invalid RATE_LIMIT_AVG, using default"
    rate_limit_avg="${DEFAULT_RATE_LIMIT_AVG}"
  fi
  if [[ ! "${rate_limit_burst}" =~ ^[0-9]+$ ]]; then
    log_msg "WARN" "Invalid RATE_LIMIT_BURST, using default"
    rate_limit_burst="${DEFAULT_RATE_LIMIT_BURST}"
  fi
  if [[ -n "${health_check_path}" ]] && [[ ! "${health_check_path}" =~ ^/[A-Za-z0-9._~/-]*$ ]]; then
    log_msg "WARN" "Invalid HEALTH_CHECK_PATH, health check disabled"
    health_check_path=""
  fi

  # Build middleware list
  local middlewares_line=""
  if [[ "${enable_rate_limit}" == "true" ]]; then
    middlewares_line="middlewares:
        - ${app_name}-ratelimit"
  fi

  # Build health check section (only if explicitly configured)
  local health_check_section=""
  if [[ -n "${health_check_path}" ]]; then
    health_check_section="healthCheck:
          path: ${health_check_path}
          interval: 30s
          timeout: 5s"
  fi

  # Build TLS block. When a pre-existing wildcard cert store is present
  # (tls-config.yaml, written by generate_traefik_config), Traefik v3 serves
  # it via the default store, so the router must use a bare `tls: {}` and must
  # NOT reference an ACME certResolver (which is undefined in that mode). Only
  # fall back to certResolver: myresolver when ACME is the active issuer.
  local tls_block="tls: {}"
  if [[ ! -f "${TRAEFIK_DYNAMIC_DIR}/tls-config.yaml" ]]; then
    tls_block="tls:
        certResolver: myresolver"
    # DNS-01 can prove the whole domain: all apps share one wildcard
    # certificate (Traefik requests the same domain set only once)
    if [[ "${LETSENCRYPT_MODE:-http}" == "dns" ]]; then
      tls_block+="
        domains:
          - main: \"${base_domain}\"
            sans:
              - \"*.${base_domain}\""
    fi
  fi

  # Write a temp file and move it in place: Traefik watches this dir and must
  # never read a half-written file. Unchanged content is not rewritten, so
  # the autopull sync of isolated apps causes no reloads.
  local tmp_file="${config_file}.tmp"
  cat > "${tmp_file}" <<EOF
http:
  routers:
    ${app_name}:
      rule: "Host(\`${app_url}\`)"
      entryPoints:
        - websecure
      service: ${app_name}
      ${middlewares_line}
      ${tls_block}

  services:
    ${app_name}:
      loadBalancer:
        servers:
          - url: "http://localhost:${port}"
        ${health_check_section}

  middlewares:
    ${app_name}-ratelimit:
      rateLimit:
        average: ${rate_limit_avg}
        burst: ${rate_limit_burst}
EOF

  if cmp -s "${tmp_file}" "${config_file}"; then
    rm -f "${tmp_file}"
    return 0
  fi
  if ! mv -f "${tmp_file}" "${config_file}"; then
    rm -f "${tmp_file}"
    log_msg "ERROR" "Could not write Traefik config ${config_file}"
    return 1
  fi
  log_msg "INFO" "Traefik config created: ${app_url} -> localhost:${port}"
}

# -----------------------------------------------------------------------------
# Function: run_install_script
# Description: Runs app's install.sh script
# -----------------------------------------------------------------------------
run_install_script() {
  local repo_dir="$1"
  local install_script="${repo_dir}/install.sh"

  if [[ ! -f "${install_script}" ]]; then
    log_msg "WARN" "No install.sh found in repository, skipping installation steps"
    return 0
  fi

  if [[ ! -x "${install_script}" ]]; then
    chmod +x "${install_script}"
  fi

  log_msg "INFO" "Running install.sh"

  safe_cd "${repo_dir}" "running install.sh"

  if bash "${install_script}"; then
    log_msg "INFO" "Installation completed successfully"
    return 0
  else
    log_msg "ERROR" "Installation script failed"
    return 1
  fi
}

# -----------------------------------------------------------------------------
# Function: python_version_request
# Description: Python version the app in dir $1 asks for, or empty for the
#   system python3. Order: PYTHON_VERSION in the app .env, .python-version,
#   requires-python in pyproject.toml, global PYTHON_VERSION.
# -----------------------------------------------------------------------------
python_version_request() {
  local dir="$1"
  local v=""
  if [[ -f "${dir}/.env" ]]; then
    v=$(grep -m1 '^PYTHON_VERSION=' "${dir}/.env" | cut -d= -f2- | tr -d "\"' " || true)
  fi
  if [[ -z "${v}" ]] && [[ -f "${dir}/.python-version" ]]; then
    v=$(head -1 "${dir}/.python-version" | tr -d '[:space:]')
  fi
  if [[ -z "${v}" ]] && [[ -f "${dir}/pyproject.toml" ]]; then
    v=$(grep -m1 -E '^[[:space:]]*requires-python[[:space:]]*=' "${dir}/pyproject.toml" | cut -d= -f2- | tr -d "\"' " || true)
  fi
  [[ -n "${v}" ]] || v="${PYTHON_VERSION:-}"
  # The value comes from the repo; allow only version request characters
  if [[ -n "${v}" ]] && [[ ! "${v}" =~ ^[0-9A-Za-z.,\<\>=~!*+-]+$ ]]; then
    log_msg "WARN" "Ignoring invalid Python version request: ${v}"
    v=""
  fi
  echo "${v}"
}

# -----------------------------------------------------------------------------
# Function: create_venv
# Description: Create .venv in the current dir. With a version request, uv
#   creates it and installs that Python into the user's home if needed.
# shortcut: an existing .venv is kept when the request changes; delete .venv
#   (or redeploy) to switch Python versions.
# -----------------------------------------------------------------------------
create_venv() {
  local request
  request=$(python_version_request "${PWD}")

  # Without uv, keep the old behaviour (system python3) instead of failing
  if [[ -n "${request}" ]] && ! command -v uv >/dev/null 2>&1; then
    log_msg "WARN" "App asks for Python ${request}, but uv is not installed (run appmo self-update); using system python3"
    request=""
  fi

  if [[ -n "${request}" ]]; then
    log_msg "INFO" "Creating virtual environment with uv, Python ${request}"
    if ! uv venv --quiet --seed --python "${request}" .venv; then
      log_msg "ERROR" "uv could not create a Python ${request} virtual environment"
      return 1
    fi
    return 0
  fi

  if ! python3 -m venv .venv 2>/dev/null; then
    log_msg "ERROR" "Failed to create Python virtual environment"
    log_msg "ERROR" "Install the required system packages and retry:"
    log_msg "ERROR" "  sudo apt install python3-venv python3-pip   # Debian/Ubuntu"
    log_msg "ERROR" "  sudo dnf install python3-pip                # RHEL/Amazon Linux"
    return 1
  fi
}

# -----------------------------------------------------------------------------
# Function: setup_python_env
# Description: Sets up Python virtual environment
# -----------------------------------------------------------------------------
setup_python_env() {
  local repo_dir="$1"

  if [[ ! -f "${repo_dir}/requirements.txt" ]]; then
    return 0
  fi

  log_msg "INFO" "Setting up Python virtual environment"

  safe_cd "${repo_dir}" "setting up Python environment"

  if [[ ! -d ".venv" ]]; then
    create_venv || return 1
  fi

  source .venv/bin/activate
  if ! pip install --upgrade pip; then
    log_msg "WARN" "pip self-upgrade failed, continuing with existing pip"
  fi
  if ! pip install -r requirements.txt; then
    log_msg "ERROR" "Failed to install Python dependencies from requirements.txt"
    return 1
  fi

  log_msg "INFO" "Python dependencies installed"
}

# -----------------------------------------------------------------------------
# Function: setup_nodejs_env
# Description: Sets up Node.js environment
# -----------------------------------------------------------------------------
setup_nodejs_env() {
  local repo_dir="$1"

  if [[ ! -f "${repo_dir}/package.json" ]]; then
    return 0
  fi

  log_msg "INFO" "Installing Node.js dependencies"

  safe_cd "${repo_dir}" "setting up Node.js environment"
  if ! npm install; then
    log_msg "ERROR" "npm install failed"
    return 1
  fi

  # Check if this is a Next.js app with static export
  local nextjs_config=""
  if [[ -f "${repo_dir}/next.config.js" ]]; then
    nextjs_config="${repo_dir}/next.config.js"
  elif [[ -f "${repo_dir}/next.config.mjs" ]]; then
    nextjs_config="${repo_dir}/next.config.mjs"
  fi

  if [[ -n "${nextjs_config}" ]]; then
    # Check if output: 'export' is configured
    if grep -q "output.*['\"]export['\"]" "${nextjs_config}" 2>/dev/null; then
      log_msg "INFO" "Detected Next.js static export - building application"

      # Build the static export
      if ! npm run build; then
        log_msg "ERROR" "Next.js build failed"
        return 1
      fi

      # Install serve for static hosting
      if ! npm install serve; then
        log_msg "ERROR" "Failed to install serve for static hosting"
        return 1
      fi

      # Update package.json start script to use serve
      if command -v jq &> /dev/null; then
        # Use jq if available (more robust)
        local tmp_file
        tmp_file=$(create_temp_file "package_json")
        jq '.scripts.start = "serve -l ${PORT:-3000} out"' "${repo_dir}/package.json" > "${tmp_file}"
        mv "${tmp_file}" "${repo_dir}/package.json"
      else
        # Fallback to npm pkg set
        npm pkg set scripts.start="serve -l \${PORT:-3000} out"
      fi

      log_msg "INFO" "Next.js static export built successfully"
    fi
  fi

  # Check if this is a Vite app that needs building
  if [[ -f "${repo_dir}/vite.config.ts" ]] || [[ -f "${repo_dir}/vite.config.js" ]]; then
    if grep -q '"build".*vite build' "${repo_dir}/package.json"; then
      log_msg "INFO" "Detected Vite app - building for production"

      # Build the app
      if ! npm run build; then
        log_msg "ERROR" "Vite build failed"
        return 1
      fi

      # Install serve for static hosting
      if ! npm install serve; then
        log_msg "ERROR" "Failed to install serve for static hosting"
        return 1
      fi

      # Add/update start script that serves the dist folder
      if command -v jq &> /dev/null; then
        local tmp_file
        tmp_file=$(create_temp_file "package_json")
        jq '.scripts.start = "serve -l ${PORT:-3000} dist"' "${repo_dir}/package.json" > "${tmp_file}"
        mv "${tmp_file}" "${repo_dir}/package.json"
      else
        npm pkg set scripts.start="serve -l \${PORT:-3000} dist"
      fi

      log_msg "INFO" "Vite app built successfully"
    fi
  fi

  log_msg "INFO" "Node.js dependencies installed"
}

# -----------------------------------------------------------------------------
# Function: setup_go_env
# Description: Sets up Go environment and builds the application
# -----------------------------------------------------------------------------
setup_go_env() {
  local repo_dir="$1"

  if [[ ! -f "${repo_dir}/go.mod" ]]; then
    return 0
  fi

  # Check if go is installed
  if ! command -v go &>/dev/null; then
    die "Go is not installed. Please install Go to deploy Go applications.
    Ubuntu/Debian: sudo apt-get install golang-go
    RHEL/CentOS:   sudo dnf install golang"
  fi

  log_msg "INFO" "Building Go application"

  safe_cd "${repo_dir}" "building Go application"

  # Download dependencies
  log_msg "INFO" "Downloading Go dependencies"
  if ! go mod download; then
    log_msg "ERROR" "go mod download failed"
    return 1
  fi

  # Build the application
  # Try to find the module name from go.mod for the binary name
  local module_name
  module_name=$(grep "^module " go.mod | awk '{print $2}' | xargs basename)

  # Build into bin directory
  mkdir -p "${repo_dir}/bin"

  # Check for cmd/ directory structure (common Go project layout)
  if [[ -d "${repo_dir}/cmd" ]]; then
    # Build all commands in cmd/ directory
    local cmd_count=0
    for cmd_dir in "${repo_dir}/cmd"/*; do
      if [[ -d "${cmd_dir}" ]] && [[ -f "${cmd_dir}/main.go" ]]; then
        local cmd_name
        cmd_name=$(basename "${cmd_dir}")
        log_msg "INFO" "Compiling Go binary: ${cmd_name}"
        if go build -o "${repo_dir}/bin/${cmd_name}" "${cmd_dir}"; then
          chmod +x "${repo_dir}/bin/${cmd_name}"
          log_msg "INFO" "Built: bin/${cmd_name}"
          cmd_count=$((cmd_count + 1))
        else
          log_msg "WARN" "Failed to build ${cmd_name}"
        fi
      fi
    done
    if [[ ${cmd_count} -eq 0 ]]; then
      die "No Go commands found in cmd/ directory"
    fi
    log_msg "INFO" "Go application built successfully (${cmd_count} binaries)"
  else
    # Try to build from root directory
    log_msg "INFO" "Compiling Go binary: ${module_name}"
    if go build -o "${repo_dir}/bin/${module_name}" .; then
      chmod +x "${repo_dir}/bin/${module_name}"
      log_msg "INFO" "Go application built successfully: bin/${module_name}"
    else
      die "Failed to build Go application"
    fi
  fi
}

# -----------------------------------------------------------------------------
# Function: is_zensical_site
# Description: True for a Zensical docs project (zensical.toml) that brings no
#   server of its own. Repos that ship start.sh, app.py, main.py or a Procfile
#   keep full control, e.g. a custom server that builds with Zensical itself.
# -----------------------------------------------------------------------------
is_zensical_site() {
  local dir="$1"
  [[ -f "${dir}/zensical.toml" ]] && \
    [[ ! -f "${dir}/start.sh" ]] && [[ ! -f "${dir}/app.py" ]] && \
    [[ ! -f "${dir}/main.py" ]] && [[ ! -f "${dir}/Procfile" ]]
}

# -----------------------------------------------------------------------------
# Function: zensical_site_dir
# Description: Print the build output directory from zensical.toml (site_dir),
#   defaulting to "site". Restricted to a plain relative path because it is
#   interpolated into the systemd ExecStart line.
# -----------------------------------------------------------------------------
zensical_site_dir() {
  local dir="$1"
  local site_dir
  site_dir=$(sed -n 's/^[[:space:]]*site_dir[[:space:]]*=[[:space:]]*["'\'']\([^"'\'']*\)["'\''].*/\1/p' \
    "${dir}/zensical.toml" 2>/dev/null | head -1 || true)
  if [[ -z "${site_dir}" ]] || [[ ! "${site_dir}" =~ ^[A-Za-z0-9._-][A-Za-z0-9._/-]*$ ]] || \
     [[ "${site_dir}" =~ \.\. ]]; then
    site_dir="site"
  fi
  echo "${site_dir}"
}

# -----------------------------------------------------------------------------
# Function: write_static_server
# Description: Write the stdlib-only static file server used for Zensical
#   sites into the app's venv. It lives in .venv (untracked, rebuilt on
#   restore) so the repo needs no app.py. Serves the site's own 404.html and
#   answers HEALTH_CHECK_PATH (default /health) for Traefik health checks.
# -----------------------------------------------------------------------------
write_static_server() {
  local server_file="$1"

  cat > "${server_file}" <<'PYEOF'
#!/usr/bin/env python3
"""Appmotel static site server: serve a built site directory on $PORT."""

import os
import sys
from functools import partial
from http import HTTPStatus
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

SITE_DIR = Path(sys.argv[1] if len(sys.argv) > 1 else "site").resolve()
HEALTH_PATH = os.environ.get("HEALTH_CHECK_PATH", "/health")


class SiteHandler(SimpleHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def do_GET(self):
        if not self._health(body=True):
            super().do_GET()

    def do_HEAD(self):
        if not self._health(body=False):
            super().do_HEAD()

    def _health(self, body):
        if self.path.split("?", 1)[0] != HEALTH_PATH:
            return False
        payload = b'{"status": "healthy"}'
        self.send_response(HTTPStatus.OK)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        if body:
            self.wfile.write(payload)
        return True

    def send_error(self, code, message=None, explain=None):
        page = SITE_DIR / "404.html"
        if code == HTTPStatus.NOT_FOUND and page.is_file():
            content = page.read_bytes()
            self.send_response(HTTPStatus.NOT_FOUND)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(content)))
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(content)
            return
        super().send_error(code, message, explain)

    def log_message(self, fmt, *args):
        # journald adds its own timestamp
        sys.stderr.write("%s %s\n" % (self.address_string(), fmt % args))


def main():
    if not (SITE_DIR / "index.html").is_file():
        sys.exit(f"ERROR: {SITE_DIR}/index.html missing - site was not built")
    port = int(os.environ.get("PORT") or 10800)
    server = ThreadingHTTPServer(
        ("0.0.0.0", port), partial(SiteHandler, directory=str(SITE_DIR))
    )
    print(f"Serving {SITE_DIR} on port {port}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
PYEOF
  chmod +x "${server_file}"
}

# -----------------------------------------------------------------------------
# Function: setup_zensical_env
# Description: Build a Zensical site: create .venv, install zensical (plus a
#   requirements.txt if the repo pins versions or adds extensions), write the
#   static server, and run `zensical build --clean`. Runs on add, update and
#   restore, so every deploy serves a fresh build.
# -----------------------------------------------------------------------------
setup_zensical_env() {
  local site_root="$1"

  log_msg "INFO" "Setting up Zensical site"

  safe_cd "${site_root}" "setting up Zensical site"

  if [[ ! -d ".venv" ]]; then
    create_venv || return 1
  fi

  if ! .venv/bin/pip install --quiet --upgrade pip; then
    log_msg "WARN" "pip self-upgrade failed, continuing with existing pip"
  fi
  if [[ -f requirements.txt ]]; then
    if ! .venv/bin/pip install --quiet -r requirements.txt; then
      log_msg "ERROR" "Failed to install Python dependencies from requirements.txt"
      return 1
    fi
  fi
  if [[ ! -x .venv/bin/zensical ]]; then
    if ! .venv/bin/pip install --quiet zensical; then
      log_msg "ERROR" "Failed to install zensical"
      return 1
    fi
  fi

  write_static_server ".venv/bin/appmotel-static-server"

  local site_dir
  site_dir=$(zensical_site_dir "${site_root}")

  log_msg "INFO" "Building site with $(.venv/bin/zensical --version 2>/dev/null | head -1 || echo zensical)"
  if ! .venv/bin/zensical build --clean; then
    log_msg "ERROR" "zensical build failed"
    return 1
  fi
  if [[ ! -f "${site_dir}/index.html" ]]; then
    log_msg "ERROR" "Build finished but ${site_dir}/index.html is missing"
    return 1
  fi

  # The `zensical new` scaffold ships a placeholder site_url. The site still
  # works (links are root-relative) but canonical URLs and sitemap.xml point
  # at the placeholder, so nudge the author.
  if grep -q '^[[:space:]]*site_url[[:space:]]*=.*example\.com' zensical.toml 2>/dev/null; then
    log_msg "WARN" "zensical.toml still has the placeholder site_url (example.com);"
    log_msg "WARN" "set it to this app's URL for correct canonical links and sitemap.xml"
  fi

  log_msg "INFO" "Zensical site built: $(find "${site_dir}" -type f | wc -l) files in ${site_dir}/"
}

# -----------------------------------------------------------------------------
# Function: check_app_url
# Description: Wait up to 15 s for https://<app>.<domain> to answer, and print
#   DNS help if it does not. Used after add and after an isolated add.
# -----------------------------------------------------------------------------
check_app_url() {
  local app_name="$1"
  local base_domain="$2"
  local port="$3"
  local app_url="https://${app_name}.${base_domain}"

  # Check if BASE_DOMAIN is still set to default
  if [[ "${base_domain}" == "apps.example.edu" ]] || [[ "${base_domain}" == "apps.yourdomain.edu" ]]; then
    log_msg "WARN" "⚠️  BASE_DOMAIN is set to default value: ${base_domain}"
    log_msg "WARN" "   Please update BASE_DOMAIN in ~/.config/appmotel/.env"
    log_msg "WARN" "   Then restart Traefik: sudo systemctl restart traefik-appmotel"
    return
  fi

  # Check if the app URL is reachable (retry for 15 seconds)
  log_msg "INFO" "Checking if app is accessible..."

  local http_code
  local response_body
  local max_attempts=15
  local attempt=1
  local app_accessible=false

  local curl_output
  curl_output=$(create_temp_file "appmo_check")

  while [[ ${attempt} -le ${max_attempts} ]]; do
    http_code=$(curl -s -o "${curl_output}" -w '%{http_code}' --connect-timeout 2 --max-time 3 -k "${app_url}" 2>/dev/null || echo "000")
    response_body=$(cat "${curl_output}" 2>/dev/null || echo "")

    # Check for successful HTTP status (2xx or 3xx) and no "Bad Gateway" in response
    if [[ "${http_code}" =~ ^[23] ]] && ! grep -qi "bad gateway" <<< "${response_body}"; then
      app_accessible=true
      break
    fi

    # Only wait and retry if not the last attempt
    if [[ ${attempt} -lt ${max_attempts} ]]; then
      sleep 1
    fi
    attempt=$((attempt + 1))
  done

  if [[ "${app_accessible}" == "true" ]]; then
    log_msg "INFO" "✓ App is accessible at ${app_url}"
  else
    if [[ "${http_code}" == "502" ]] || grep -qi "bad gateway" <<< "${response_body}"; then
      log_msg "WARN" "App not accessible - received Bad Gateway error (app may not be running on port ${port})"
    else
      log_msg "WARN" "App not yet accessible - DNS may need configuration"
    fi
    log_msg "INFO" ""
    log_msg "INFO" "DNS Configuration Required:"
    log_msg "INFO" ""
    log_msg "INFO" "   Configure DNS to route traffic to this app. Choose one option:"
    log_msg "INFO" ""
    log_msg "INFO" "   Option 1 (Recommended): Wildcard A record"
    log_msg "INFO" "     *.${base_domain} IN A $(curl -s --connect-timeout 3 ifconfig.me 2>/dev/null || echo 'YOUR_SERVER_IP')"
    log_msg "INFO" "     → All subdomains automatically route to this server"
    log_msg "INFO" ""
    log_msg "INFO" "   Option 2: Individual A record"
    log_msg "INFO" "     ${app_name}.${base_domain} IN A $(curl -s --connect-timeout 3 ifconfig.me 2>/dev/null || echo 'YOUR_SERVER_IP')"
    log_msg "INFO" "     → Requires manual DNS update for each new app"
  fi
}

# -----------------------------------------------------------------------------
# Function: cmd_add
# Description: Adds a new app
# Supports subfolder URLs: https://github.com/user/repo/tree/branch/path/to/folder
# -----------------------------------------------------------------------------
cmd_add() {
  local isolated=false
  local -a args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --isolated) isolated=true ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  set -- "${args[@]:-}"

  if [[ $# -lt 2 ]]; then
    die "Usage: appmo add [--isolated] <app-name> <github-url|user/repo> [branch] [subfolder]"
  fi

  local app_name="$1"
  local github_url="$2"
  local branch="${3:-}"
  local subdir="${4:-}"

  # Validate app name first
  validate_app_name "${app_name}"

  if [[ "${isolated}" == "true" ]]; then
    [[ "${APPMO_ROLE}" == "admin" ]] || die "--isolated must be run by appmotel or an operator"
    add_isolated "$@"
    return
  fi

  # Parse the URL to extract repo, branch, and subfolder
  parse_github_url "${github_url}"

  # Use parsed values
  local clone_url="${PARSED_REPO_URL}"
  local url_branch="${PARSED_BRANCH}"
  local url_subdir="${PARSED_SUBDIR}"

  # Handle branch resolution
  if [[ -n "${url_branch}" ]] && [[ -n "${branch}" ]]; then
    # Both URL contains branch AND user passed branch argument - error
    die "Conflicting branch specification: URL contains branch '${url_branch}' but you also specified '${branch}'. Remove the branch argument or use a simpler URL format."
  elif [[ -n "${url_branch}" ]]; then
    # Use branch from URL
    branch="${url_branch}"
    log_msg "INFO" "Using branch from URL: ${branch}"
  elif [[ -z "${branch}" ]]; then
    # No branch specified anywhere - default to main
    branch="main"
  fi

  # Use subfolder from URL if present
  if [[ -n "${url_subdir}" ]] && [[ -n "${subdir}" ]] && [[ "${url_subdir}" != "${subdir}" ]]; then
    die "Conflicting subfolder: URL contains '${url_subdir}' but you also specified '${subdir}'"
  elif [[ -n "${url_subdir}" ]]; then
    subdir="${url_subdir}"
    log_msg "INFO" "Deploying from subfolder: ${subdir}"
  fi

  # Update github_url to the clean repo URL for cloning
  github_url="${clone_url}"

  # Validate the clean URL and branch
  validate_github_url "${github_url}"
  validate_branch_name "${branch}"
  if [[ "${subdir}" =~ \.\. ]] || [[ "${subdir}" == /* ]]; then
    die "Invalid subfolder: ${subdir}"
  fi

  # Auto-expand short GitHub URLs (e.g., "user/repo" -> git@github.com:user/repo.git or https://github.com/user/repo)
  if [[ ! "${github_url}" =~ ^(https?://|git@) ]] && [[ "${github_url}" =~ ^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$ ]]; then
    # Check if user has SSH access to GitHub
    if check_github_ssh_access; then
      # Use SSH URL for authenticated access
      github_url="git@github.com:${github_url}.git"
      log_msg "INFO" "Expanded to SSH: ${github_url}"
    else
      # Use HTTPS URL for anonymous access (no credentials needed for public repos)
      github_url="https://github.com/${github_url}"
      log_msg "INFO" "Expanded to HTTPS: ${github_url}"
    fi
  fi

  if app_exists "${app_name}"; then
    die "App '${app_name}' already exists"
  fi

  log_msg "INFO" "Adding app: ${app_name}"

  # Check disk space before cloning (require at least 500MB)
  check_disk_space "${APPS_DATA_DIR}" 500

  # Create directories
  local app_data_dir="${APPS_DATA_DIR}/${app_name}"
  local repo_dir="${app_data_dir}/repo"

  # Clean up any leftover directories from failed deployments
  # If app doesn't exist in metadata but directory exists, it's a leftover
  # appmo isolate copies the old repo here first (APPMO_KEEP_REPO=1) so
  # untracked app data survives the move
  if [[ -d "${app_data_dir}" ]] && ! app_exists "${app_name}" && [[ "${APPMO_KEEP_REPO:-0}" != "1" ]]; then
    log_msg "WARN" "Cleaning up leftover directory from previous failed deployment"
    safe_rm_rf "${app_data_dir}" "cmd_add cleanup leftover"
  fi

  # Verify repository exists before attempting to clone (for HTTPS URLs only)
  # Skip this check for SSH URLs as they require authentication to test
  if [[ "${github_url}" =~ ^https:// ]]; then
    log_msg "INFO" "Verifying repository exists: ${github_url}"
    local repo_check
    repo_check=$(curl -I -s -o /dev/null -w "%{http_code}" "${github_url}" 2>/dev/null || echo "000")
    if [[ "${repo_check}" == "404" ]]; then
      die "Repository not found: ${github_url} (HTTP 404). Please check the URL and ensure the repository exists."
    elif [[ "${repo_check}" == "000" ]]; then
      log_msg "WARN" "Could not verify repository existence (network issue?), proceeding anyway"
    fi
  fi

  mkdir -p "${app_data_dir}"

  # Clone or update repository
  if [[ -d "${repo_dir}/.git" ]]; then
    # Repo exists, pull latest changes
    log_msg "INFO" "Repository exists, pulling latest: ${github_url}"
    safe_cd "${repo_dir}" "updating git repository"
    local git_update_failed=false

    # Try to update existing repo with proper error recovery
    if ! git_with_timeout fetch origin 2>&1; then
      log_msg "WARN" "Git fetch failed"
      git_update_failed=true
    elif ! git checkout "${branch}" 2>&1; then
      log_msg "WARN" "Git checkout failed for branch '${branch}'"
      git_update_failed=true
    elif ! git reset --hard "origin/${branch}" 2>&1; then
      # Use reset --hard instead of pull to avoid merge conflicts
      log_msg "WARN" "Git reset failed"
      git_update_failed=true
    fi

    if [[ "${git_update_failed}" == "true" ]]; then
      log_msg "WARN" "Git update failed, removing and re-cloning"
      safe_cd "${APPS_DATA_DIR}" "before deleting repo"  # Move out of repo dir before deleting
      safe_rm_rf "${repo_dir}" "cmd_add re-clone"
      if ! git_with_timeout clone --branch "${branch}" "${github_url}" "${repo_dir}"; then
        safe_rm_rf "${app_data_dir}" "cmd_add clone failed"
        die "Failed to clone repository: ${github_url}"
      fi
    fi
  elif [[ -d "${repo_dir}" ]]; then
    # Directory exists but not a git repo, remove and clone
    log_msg "WARN" "Directory exists but not a git repo, removing"
    safe_rm_rf "${repo_dir}" "cmd_add non-git dir"
    log_msg "INFO" "Cloning repository: ${github_url}"
    if ! git_with_timeout clone --branch "${branch}" "${github_url}" "${repo_dir}"; then
      safe_rm_rf "${app_data_dir}" "cmd_add clone failed"
      die "Failed to clone repository: ${github_url}"
    fi
  else
    # Fresh clone
    log_msg "INFO" "Cloning repository: ${github_url}"
    if ! git_with_timeout clone --branch "${branch}" "${github_url}" "${repo_dir}"; then
      safe_rm_rf "${app_data_dir}" "cmd_add clone failed"
      die "Failed to clone repository: ${github_url}"
    fi
  fi

  # Determine the app working directory (subfolder or repo root)
  local app_dir="${repo_dir}"
  if [[ -n "${subdir}" ]]; then
    app_dir="${repo_dir}/${subdir}"
    # Verify subfolder exists
    if [[ ! -d "${app_dir}" ]]; then
      safe_rm_rf "${app_data_dir}" "subfolder not found"
      die "Subfolder '${subdir}' not found in repository. Available directories: $(ls -d "${repo_dir}"/*/ 2>/dev/null | xargs -n1 basename 2>/dev/null | tr '\n' ' ' || echo 'none')"
    fi
    log_msg "INFO" "Using subfolder: ${app_dir}"
  fi

  # Check for existing .env backup and offer to restore
  local config_dir="${APPS_CONFIG_DIR}/${app_name}"
  local env_backup="${config_dir}/.env.backup"
  if [[ -f "${env_backup}" ]]; then
    local restore_answer=""
    if [[ -t 0 ]]; then
      printf "Found previous .env backup for '${app_name}'. Restore it? [Y/n] "
      # || guard: read fails at EOF and errexit would abort mid-deployment
      read -r restore_answer || restore_answer=""
    else
      log_msg "INFO" "Non-interactive session: restoring previous .env backup (default)"
    fi
    case "${restore_answer}" in
      [nN]|[nN][oO])
        log_msg "INFO" "Starting with fresh .env"
        rm -f "${env_backup}"
        ;;
      *)
        log_msg "INFO" "Restoring .env from backup"
        mkdir -p "${config_dir}"
        mv "${env_backup}" "${config_dir}/.env"
        ;;
    esac
  fi

  # Determine port (check config .env first, then repo .env, then assign new)
  local port
  local port_from_env=""
  if port_from_env=$(get_port_from_env "${app_name}"); then
    # Check if port is too low (< 10001) - override with high port
    if [[ "${port_from_env}" -lt 10001 ]]; then
      log_msg "WARN" "Port ${port_from_env} from .env is too low, assigning high port"
      port=$(find_free_port)
      log_msg "INFO" "Assigned new port: ${port}"
      # Update the .env file with new port if it exists
      local config_env="${APPS_CONFIG_DIR}/${app_name}/.env"
      if [[ -f "${config_env}" ]]; then
        update_port_in_env "${config_env}" "${port}"
      fi
    # Check if the port from .env is still free
    elif ss -tuln | grep -q ":${port_from_env} "; then
      log_msg "WARN" "Port ${port_from_env} from .env is already in use"
      port=$(find_free_port)
      log_msg "INFO" "Assigned new port: ${port}"
      # Update the .env file with new port if it exists
      local config_env="${APPS_CONFIG_DIR}/${app_name}/.env"
      if [[ -f "${config_env}" ]]; then
        update_port_in_env "${config_env}" "${port}"
      fi
    else
      port="${port_from_env}"
      log_msg "INFO" "Using port from .env: ${port}"
    fi
  else
    port=$(find_free_port)
    log_msg "INFO" "Assigned port: ${port}"
  fi

  # Setup .env file (physical in config dir, symlink in repo and subfolder)
  setup_app_env_file "${app_name}" "${port}" "${subdir}"

  # Detect multi-component structure (frontend, backend, api, etc.)
  # For subfolder deployments, detect components within the subfolder
  local -a detected_components
  detect_components "${app_dir}" detected_components

  local services_to_deploy=()

  if [[ ${#detected_components[@]} -gt 1 ]]; then
    # Multi-component app detected
    log_msg "INFO" "Detected multi-component app: ${detected_components[*]}"
    services_to_deploy=("${detected_components[@]}")
  else
    # Single-component app - detect type and setup app directory
    # For subfolder deployments, search up for dependency files
    local app_type="unknown"
    local deps_dir="${app_dir}"  # Directory containing dependency files

    if is_zensical_site "${app_dir}"; then
      app_type="zensical"
    elif [[ -f "${app_dir}/go.mod" ]]; then
      app_type="go"
    elif [[ -f "${app_dir}/requirements.txt" ]] || [[ -f "${app_dir}/pyproject.toml" ]]; then
      app_type="python"
    elif [[ -f "${app_dir}/package.json" ]]; then
      app_type="nodejs"
    elif [[ -n "${subdir}" ]]; then
      # Subfolder deployment: search up for dependency files
      local found_dir
      if found_dir=$(find_file_up "requirements.txt" "${app_dir}" "${repo_dir}"); then
        app_type="python"
        deps_dir="${found_dir}"
        log_msg "INFO" "Found requirements.txt in parent: ${found_dir}"
      elif found_dir=$(find_file_up "pyproject.toml" "${app_dir}" "${repo_dir}"); then
        app_type="python"
        deps_dir="${found_dir}"
        log_msg "INFO" "Found pyproject.toml in parent: ${found_dir}"
      elif found_dir=$(find_file_up "package.json" "${app_dir}" "${repo_dir}"); then
        app_type="nodejs"
        deps_dir="${found_dir}"
        log_msg "INFO" "Found package.json in parent: ${found_dir}"
      elif found_dir=$(find_file_up "go.mod" "${app_dir}" "${repo_dir}"); then
        app_type="go"
        deps_dir="${found_dir}"
        log_msg "INFO" "Found go.mod in parent: ${found_dir}"
      fi
    fi

    log_msg "INFO" "Detected app type: ${app_type}"

    case "${app_type}" in
      zensical)
        setup_zensical_env "${app_dir}" || {
          safe_rm_rf "${app_data_dir}" "Zensical build failed"
          die "Failed to build Zensical site"
        }
        ;;
      go)
        setup_go_env "${deps_dir}" || {
          safe_rm_rf "${app_data_dir}" "Go build failed"
          die "Failed to build Go application"
        }
        ;;
      python)
        setup_python_env "${deps_dir}" || {
          safe_rm_rf "${app_data_dir}" "Python setup failed"
          die "Failed to setup Python environment"
        }
        ;;
      nodejs)
        setup_nodejs_env "${deps_dir}" || {
          safe_rm_rf "${app_data_dir}" "Node.js setup failed"
          die "Failed to setup Node.js environment"
        }
        ;;
      *)
        log_msg "WARN" "Unknown app type, skipping environment setup"
        ;;
    esac

    # Run install script for single app
    if ! run_install_script "${app_dir}"; then
      safe_rm_rf "${app_data_dir}" "install script failed"
      die "Installation failed, rolling back"
    fi

    services_to_deploy=()
  fi

  # Use BASE_DOMAIN from .env (sourced at script start) or default
  local base_domain="${BASE_DOMAIN:-apps.example.edu}"

  # Setup all detected services (multi-component or fallback to Procfile/single)
  if [[ ${#services_to_deploy[@]} -gt 0 ]]; then
    # Multi-component deployment
    log_msg "INFO" "Setting up ${#services_to_deploy[@]} components..."

    # Track services to start (backend first, then frontend)
    local -a backend_services=()
    local frontend_service=""
    # Ports handed out during this run: this app's metadata is not written
    # yet, so find_free_port alone could return a port already given to a
    # sibling component (or the frontend's own port)
    local assigned_ports="${port}"

    for component in "${services_to_deploy[@]}"; do
      # Resolve component directory (check root level first, then src/)
      # For subfolder deployments, components are relative to app_dir
      local component_dir="${app_dir}/${component}"
      if [[ ! -d "${component_dir}" ]]; then
        component_dir="${app_dir}/src/${component}"
      fi

      local component_port="${port}"

      # Only frontend gets the public port; others run internal
      if [[ "${component}" != "frontend" ]]; then
        component_port=$(find_free_port "${assigned_ports}")
        assigned_ports="${assigned_ports} ${component_port}"
        log_msg "INFO" "Assigned internal port ${component_port} for ${component}"
      fi

      log_msg "INFO" "Setting up component: ${component} at ${component_dir}"

      # Detect and setup component type
      if [[ -f "${component_dir}/go.mod" ]]; then
        setup_go_env "${component_dir}" || {
          safe_rm_rf "${app_data_dir}" "Go component build failed: ${component}"
          die "Failed to build Go component: ${component}"
        }
      elif [[ -f "${component_dir}/requirements.txt" ]] || [[ -f "${component_dir}/pyproject.toml" ]]; then
        setup_python_env "${component_dir}" || {
          safe_rm_rf "${app_data_dir}" "Python component setup failed: ${component}"
          die "Failed to setup Python component: ${component}"
        }
      elif [[ -f "${component_dir}/package.json" ]]; then
        setup_nodejs_env "${component_dir}" || {
          safe_rm_rf "${app_data_dir}" "Node.js component setup failed: ${component}"
          die "Failed to setup Node.js component: ${component}"
        }
      fi

      # Run install script if exists in component
      if [[ -f "${component_dir}/install.sh" ]]; then
        log_msg "INFO" "Running install script for ${component}"
        safe_cd "${component_dir}" "running install script for ${component}"
        if ! bash install.sh; then
          safe_rm_rf "${app_data_dir}" "component install failed: ${component}"
          die "Installation failed for component: ${component}"
        fi
      fi

      # Create systemd service for component
      # Frontend uses appmotel-<app>.service (no suffix), others get suffix
      local service_suffix=""
      if [[ "${component}" != "frontend" ]]; then
        service_suffix="-${component}"
        backend_services+=("appmotel-${app_name}${service_suffix}")
      else
        frontend_service="appmotel-${app_name}"
      fi
      create_systemd_service "${app_name}" "${component_dir}" "${component_port}" "${component}"

      # Enable service (don't start yet - we'll start in correct order)
      systemctl --user enable "appmotel-${app_name}${service_suffix}"
    done

    # Start services in correct order: backend first, then frontend
    log_msg "INFO" "Starting services (backend first, then frontend)..."
    for svc in "${backend_services[@]}"; do
      log_msg "INFO" "Starting ${svc}..."
      systemctl --user start "${svc}"
    done
    if [[ -n "${frontend_service}" ]]; then
      log_msg "INFO" "Starting ${frontend_service}..."
      systemctl --user start "${frontend_service}"
    fi

    # Create Traefik config only for frontend (public port)
    create_traefik_config "${app_name}" "${port}" "${base_domain}" "${app_dir}/.env"

    # Save metadata with services list and subdir
    services_str=$(echo "${services_to_deploy[@]}" | tr ' ' '\n' | sort | tr '\n' ' ' | xargs)
    save_app_metadata "${app_name}" "${github_url}" "${branch}" "${port}" "${services_str}" "${subdir}"
  else
    # Single-component deployment - check for Procfile or standard single service
    local procfile="${app_dir}/Procfile"
    local processes_str=""
    if [[ -f "${procfile}" ]]; then
      log_msg "INFO" "Procfile detected, setting up multi-process app"

      local proc_count=0
      local assigned_ports="${port}"
      while IFS= read -r proc_line; do
        if [[ "${proc_line}" =~ ^([a-zA-Z][a-zA-Z0-9_-]*):(.+)$ ]]; then
          local proc_name="${BASH_REMATCH[1]}"
          local proc_cmd="${BASH_REMATCH[2]}"
          local proc_port="${port}"

          # Web process gets the main port; others prefer consecutive ports
          # but fall back to a random free one if port+N is taken (it may
          # belong to another app or a live socket)
          if [[ "${proc_name}" != "web" ]]; then
            # Not ((proc_count++)): post-increment from 0 returns status 1 and
            # errexit would abort the deploy mid-way
            proc_count=$((proc_count + 1))
            proc_port=$((port + proc_count))

            if [[ ${proc_port} -gt ${MAX_PORT} ]] || ! port_available "${proc_port}" "${assigned_ports}"; then
              proc_port=$(find_free_port "${assigned_ports}")
              log_msg "INFO" "Port $((port + proc_count)) unavailable for ${proc_name}, assigned ${proc_port}"
            fi
            assigned_ports="${assigned_ports} ${proc_port}"
          fi

          log_msg "INFO" "Creating service for process: ${proc_name} (port ${proc_port})"
          create_systemd_service_procfile "${app_name}" "${proc_name}" "${app_dir}" "${proc_port}" "${proc_cmd}"

          # Enable and start service
          systemctl --user enable "appmotel-${app_name}-${proc_name}"
          systemctl --user start "appmotel-${app_name}-${proc_name}"
          processes_str+="${processes_str:+ }${proc_name}"
        fi
      done < <(parse_procfile "${procfile}")

      # Create Traefik config (only routes to web process on main port)
      create_traefik_config "${app_name}" "${port}" "${base_domain}" "${app_dir}/.env"
    else
      # Single process app
      create_systemd_service "${app_name}" "${app_dir}" "${port}"

      # Create Traefik config with app_dir for settings
      create_traefik_config "${app_name}" "${port}" "${base_domain}" "${app_dir}/.env"

      # Start service
      systemctl --user enable "appmotel-${app_name}"
      systemctl --user start "appmotel-${app_name}"
    fi

    # Save metadata (no SERVICES field for single-component, but include
    # subdir, and the processes of a Procfile app)
    save_app_metadata "${app_name}" "${github_url}" "${branch}" "${port}" "" "${subdir}" "${processes_str}"
  fi

  # Scheduled jobs from appmo-schedule in the app folder, and RESTART_LIMIT
  sync_scheduled_jobs "${app_name}" "${app_dir}"
  apply_restart_limit "${app_name}"

  local app_url="https://${app_name}.${base_domain}"

  log_msg "INFO" "App '${app_name}' added successfully"
  log_msg "INFO" "URL: ${app_url}"
  log_msg "INFO" "Status: appmo status ${app_name}"
  log_msg "INFO" "Logs: appmo logs ${app_name}"
  log_msg "INFO" ""

  # In app role the Traefik route does not exist yet; appmotel adds it next
  [[ "${APPMO_ROLE}" == "app" ]] && return 0

  check_app_url "${app_name}" "${base_domain}" "${port}"
}

# -----------------------------------------------------------------------------
# Function: cmd_remove
# Description: Removes an app (also aliased as 'rm')
# Backs up .env file before removal for potential restore on re-add
# -----------------------------------------------------------------------------
cmd_remove() {
  if [[ $# -lt 1 ]]; then
    die "Usage: appmo remove <app-name>"
  fi

  local app_name="$1"

  require_app_exists "${app_name}"

  log_msg "INFO" "Removing app: ${app_name}"

  # Backup .env file before removal
  local config_dir="${APPS_CONFIG_DIR}/${app_name}"
  local env_file="${config_dir}/.env"
  local env_backup="${config_dir}/.env.backup"

  if [[ -f "${env_file}" ]] && [[ ! -L "${env_file}" ]]; then
    # Create config dir if needed (for storing backup)
    mkdir -p "${config_dir}"
    cp "${env_file}" "${env_backup}"
    log_msg "INFO" "Backed up .env to ${env_backup}"
  fi

  # Scheduled jobs first, so none starts while the app is taken down
  remove_scheduled_jobs "${app_name}" stop

  # Get all services for this app (handles multi-component and Procfile)
  local -a services
  get_all_services "${app_name}" services

  # Stop, disable, and remove all service files
  for service in "${services[@]}"; do
    local service_name
    # Frontend gets no suffix, others get suffix
    if [[ "${service}" == "frontend" ]] || [[ "${service}" == "${app_name}" ]]; then
      service_name="appmotel-${app_name}"
    else
      service_name="appmotel-${app_name}-${service}"
    fi

    # Stop and disable service
    systemctl_stop "${service_name}"
    systemctl --user disable "${service_name}" 2>/dev/null || true

    # Remove service file and its drop-ins (restart-limit.conf)
    rm -f "${SYSTEMD_USER_DIR}/${service_name}.service"
    if [[ -d "${SYSTEMD_USER_DIR}/${service_name}.service.d" ]]; then
      safe_rm_rf "${SYSTEMD_USER_DIR}/${service_name}.service.d" "cmd_remove drop-ins"
    fi
  done
  systemctl --user daemon-reload

  # Remove Traefik config (in app role appmotel does this)
  if [[ "${APPMO_ROLE}" == "admin" ]]; then
    rm -f "${TRAEFIK_DYNAMIC_DIR}/${app_name}.yaml"
  fi

  # Remove app data
  safe_rm_rf "${APPS_DATA_DIR}/${app_name}" "cmd_remove app data"

  # Remove app config (but preserve .env.backup)
  # Move .env.backup to temp, remove dir, recreate with just backup
  if [[ -f "${env_backup}" ]]; then
    local temp_backup
    temp_backup=$(create_temp_file "env_backup")
    cp "${env_backup}" "${temp_backup}"
    safe_rm_rf "${config_dir}" "cmd_remove config (preserving backup)"
    mkdir -p "${config_dir}"
    mv "${temp_backup}" "${env_backup}"
    log_msg "INFO" ".env backup preserved at ${env_backup}"
    log_msg "INFO" "Re-add app with same name to restore .env"
  else
    safe_rm_rf "${config_dir}" "cmd_remove config"
  fi

  log_msg "INFO" "App '${app_name}' removed successfully"
}

# -----------------------------------------------------------------------------
# Function: cmd_list
# Description: Lists all apps
# -----------------------------------------------------------------------------
cmd_list() {
  if [[ ! -d "${APPS_CONFIG_DIR}" ]]; then
    echo "No apps configured"
    return
  fi

  local -a apps
  # Use -print0 and mapfile -d '' for safe handling of special characters
  mapfile -t -d '' apps < <(find "${APPS_CONFIG_DIR}" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)
  # Extract basenames
  local -a app_names=()
  for app_path in "${apps[@]:-}"; do
    [[ -n "${app_path}" ]] && app_names+=("$(basename "${app_path}")")
  done
  apps=("${app_names[@]:-}")

  if [[ ${#apps[@]} -eq 0 ]]; then
    echo "No apps configured"
    return
  fi

  printf "%-22s %-10s %-35s %-45s %s\n" "APP NAME" "STATUS" "REPO" "URL" "USER"
  printf "%-22s %-10s %-35s %-45s %s\n" "--------" "------" "----" "---" "----"

  local base_domain="${BASE_DOMAIN:-apps.example.edu}"

  local found_apps=0
  for app in "${apps[@]}"; do
    # Skip directories that only have .env.backup (removed apps)
    if ! app_exists "${app}"; then
      continue
    fi
    found_apps=$((found_apps + 1))

    local status="stopped"
    local user
    user=$(id -un)
    local metadata_file="${APPS_CONFIG_DIR}/${app}/metadata.conf"
    local metadata=""
    if is_isolated "${app}"; then
      user="${APP_USER_PREFIX}${app}"
      local uid
      uid=$(id -u "${user}" 2>/dev/null || echo 0)
      if as_app_user "${app}" env "XDG_RUNTIME_DIR=/run/user/${uid}" systemctl --user is-active --quiet "appmotel-${app}" 2>/dev/null; then
        status="running"
      fi
      metadata=$(as_app_user "${app}" cat "$(app_user_home "${app}")/.config/appmotel/${app}/metadata.conf" 2>/dev/null || true)
    else
      if systemctl --user is-active --quiet "appmotel-${app}"; then
        status="running"
      fi
      [[ -f "${metadata_file}" ]] && metadata=$(<"${metadata_file}")
    fi

    local url="https://${app}.${base_domain}"

    # Get repo from metadata (extract user/repo from GitHub URL)
    local repo=""
    if [[ -n "${metadata}" ]]; then
      local github_url
      github_url=$(grep "^GITHUB_URL=" <<< "${metadata}" | cut -d'"' -f2 || true)
      # Extract user/repo from URL (handles https://github.com/user/repo or git@github.com:user/repo)
      repo=$(echo "${github_url}" | sed -E 's|^https?://github\.com/||; s|^git@github\.com:||; s|\.git$||')
    fi

    printf "%-22s %-10s %-35s %-45s %s\n" "${app}" "${status}" "${repo}" "${url}" "${user}"
  done

  if [[ ${found_apps} -eq 0 ]]; then
    echo "No apps configured"
  fi
}

# -----------------------------------------------------------------------------
# Function: cmd_status
# Description: Shows app status
# -----------------------------------------------------------------------------
cmd_status() {
  local base_domain="${BASE_DOMAIN:-apps.example.edu}"

  if [[ $# -eq 0 ]]; then
    if [[ "${APPMO_ROLE}" == "app" ]]; then
      die "Usage: appmo status <app-name> (Traefik status is only shown to appmotel)"
    fi
    # Show Traefik service status
    sudo /bin/systemctl status traefik-appmotel || true

    local cert_secs
    if cert_secs=$(tls_cert_seconds_left); then
      echo ""
      echo "TLS certificate: $(format_cert_expiry "${cert_secs}")"
    fi
    return
  fi

  local app_name="$1"

  require_app_exists "${app_name}"

  load_app_metadata "${app_name}"

  # Get all services for this app
  local -a services
  get_all_services "${app_name}" services

  # Show systemctl status for each service (allow failure for stopped services)
  for service in "${services[@]}"; do
    local service_name
    if [[ "${service}" == "frontend" ]] || [[ "${service}" == "${app_name}" ]]; then
      service_name="appmotel-${app_name}"
    else
      service_name="appmotel-${app_name}-${service}"
    fi
    systemctl --user status "${service_name}" --no-pager 2>/dev/null || true
    echo ""
  done

  echo "App: ${app_name}"
  echo "URL: https://${app_name}.${base_domain}"
  if [[ -n "${SUBDIR:-}" ]]; then
    echo "GitHub: ${GITHUB_URL} (${BRANCH}) [subfolder: ${SUBDIR}]"
  else
    echo "GitHub: ${GITHUB_URL} (${BRANCH})"
  fi
  echo "Port: ${PORT}"
  echo "Last Deployment: $(format_timestamp "${LAST_DEPLOYMENT}")"
  local pin_file="${APPS_CONFIG_DIR}/${app_name}/pinned"
  if [[ -f "${pin_file}" ]]; then
    local pin_commit pin_backup
    pin_commit=$(env_get_value "${pin_file}" COMMIT 2>/dev/null) || pin_commit=""
    pin_backup=$(env_get_value "${pin_file}" BACKUP 2>/dev/null) || pin_backup=""
    echo "Pinned: rolled back to ${pin_commit:0:8} (backup ${pin_backup}); autopull does not update it"
    echo "        Follow ${BRANCH} again: appmo unpin ${app_name} (or deploy now: appmo update ${app_name})"
  fi
  echo ""

  # Check status for each service/component
  echo "Service Status:"
  for service in "${services[@]}"; do
    local service_name
    local display_name="${service}"
    if [[ "${service}" == "frontend" ]] || [[ "${service}" == "${app_name}" ]]; then
      service_name="appmotel-${app_name}"
      if [[ "${service}" == "${app_name}" ]]; then
        display_name="main"
      fi
    else
      service_name="appmotel-${app_name}-${service}"
    fi

    echo "  ${display_name}:"
    echo "    Systemd: $(unit_state_text "${service_name}.service" "${app_name}")"

    # Check port response for frontend only
    if [[ "${service}" == "frontend" ]] || [[ "${service}" == "${app_name}" ]]; then
      if timeout 2 bash -c "cat < /dev/null > /dev/tcp/localhost/${PORT}" 2>/dev/null; then
        echo "    Port ${PORT}: responding"
      else
        echo "    Port ${PORT}: not responding"
      fi
    fi
  done

  local -a timers=()
  mapfile -t timers < <(job_units "${app_name}" | sed 's/$/.timer/')
  if [[ ${#timers[@]} -gt 0 ]]; then
    echo ""
    echo "Scheduled jobs (${SCHEDULE_FILE_NAME}):"
    systemctl --user list-timers --all --no-pager "${timers[@]}" 2>/dev/null || true
    echo "Job output: appmo logs ${app_name}"
  fi
}

# -----------------------------------------------------------------------------
# Function: unit_state_text
# Description: The state of one unit for appmo status: running, stopped,
#   crashed and waiting to restart, or failed (with the crash-loop case,
#   where systemd hit RESTART_LIMIT and stopped restarting it).
# -----------------------------------------------------------------------------
unit_state_text() {
  local unit="$1" app_name="$2" text restarts
  local -A props=()
  unit_props "${unit}" props ActiveState SubState Result NRestarts
  restarts="${props[NRestarts]:-0}"
  is_counter "${restarts}" || restarts=0
  case "${props[ActiveState]:-}/${props[SubState]:-}" in
    active/*) text="running" ;;
    activating/auto-restart*) text="CRASHED, systemd restarts it in a few seconds" ;;
    activating/*|reloading/*) text="starting" ;;
    failed/*)
      # Restart=always leaves a unit failed only once the start limit
      # stopped the restarts; Result then still shows the last run (exit-code)
      if [[ "${props[Result]:-}" == "start-limit-hit" ]] || (( restarts > 0 )); then
        text="FAILED: crash loop, systemd stopped restarting it (start limit); fix the app, then: appmo restart ${app_name}"
      else
        text="FAILED (${props[Result]:-unknown}), see: appmo logs ${app_name}"
      fi
      ;;
    *) text="stopped" ;;
  esac
  if (( restarts > 0 )); then
    text+=" [${restarts} automatic restart(s) since it was started]"
  fi
  echo "${text}"
}

# -----------------------------------------------------------------------------
# Function: cmd_start
# Description: Starts an app
# -----------------------------------------------------------------------------
cmd_start() {
  if [[ $# -lt 1 ]]; then
    die "Usage: appmo start <app-name>"
  fi

  local app_name="$1"
  require_app_exists "${app_name}"

  # Get all services for this app (handles multi-component)
  local -a services
  get_all_services "${app_name}" services

  log_msg "INFO" "Starting app: ${app_name}"
  apply_restart_limit "${app_name}"
  for service in "${services[@]}"; do
    local service_name
    # Frontend gets no suffix, others get suffix
    if [[ "${service}" == "frontend" ]] || [[ "${service}" == "${app_name}" ]]; then
      service_name="appmotel-${app_name}"
    else
      service_name="appmotel-${app_name}-${service}"
    fi
    # A unit that hit RESTART_LIMIT refuses to start until it is reset
    systemctl --user reset-failed "${service_name}" 2>/dev/null || true
    systemctl --user start "${service_name}"
  done
  job_timers_ctl "${app_name}" start
  log_msg "INFO" "App started"
}

# -----------------------------------------------------------------------------
# Function: cmd_stop
# Description: Stops an app
# -----------------------------------------------------------------------------
cmd_stop() {
  if [[ $# -lt 1 ]]; then
    die "Usage: appmo stop <app-name>"
  fi

  local app_name="$1"
  require_app_exists "${app_name}"

  # Get all services for this app (handles multi-component)
  local -a services
  get_all_services "${app_name}" services

  log_msg "INFO" "Stopping app: ${app_name}"
  for service in "${services[@]}"; do
    local service_name
    # Frontend gets no suffix, others get suffix
    if [[ "${service}" == "frontend" ]] || [[ "${service}" == "${app_name}" ]]; then
      service_name="appmotel-${app_name}"
    else
      service_name="appmotel-${app_name}-${service}"
    fi
    systemctl --user stop "${service_name}"
  done
  # Scheduled jobs pause with the app (appmo start resumes them)
  job_timers_ctl "${app_name}" stop
  log_msg "INFO" "App stopped"
}

# -----------------------------------------------------------------------------
# Function: cmd_restart
# Description: Restarts an app
# -----------------------------------------------------------------------------
cmd_restart() {
  if [[ $# -lt 1 ]]; then
    die "Usage: appmo restart <app-name>"
  fi

  local app_name="$1"
  require_app_exists "${app_name}"

  # Get all services for this app (handles multi-component)
  local -a services
  get_all_services "${app_name}" services

  log_msg "INFO" "Restarting app: ${app_name}"
  apply_restart_limit "${app_name}"
  for service in "${services[@]}"; do
    local service_name
    # Frontend gets no suffix, others get suffix
    if [[ "${service}" == "frontend" ]] || [[ "${service}" == "${app_name}" ]]; then
      service_name="appmotel-${app_name}"
    else
      service_name="appmotel-${app_name}-${service}"
    fi
    systemctl --user reset-failed "${service_name}" 2>/dev/null || true
    systemctl --user restart "${service_name}"
  done
  # Resume jobs that appmo stop paused: the app runs again
  job_timers_ctl "${app_name}" start
  log_msg "INFO" "App restarted"
}

# -----------------------------------------------------------------------------
# Function: cmd_update
# Description: Updates an app with automatic backup and rollback on failure
# -----------------------------------------------------------------------------
cmd_update() {
  if [[ $# -lt 1 ]]; then
    die "Usage: appmo update <app-name>"
  fi

  local app_name="$1"

  require_app_exists "${app_name}"

  load_app_metadata "${app_name}"

  local repo_dir="${APPS_DATA_DIR}/${app_name}/repo"

  # Determine app working directory (subfolder or repo root)
  local app_dir="${repo_dir}"
  if [[ -n "${SUBDIR:-}" ]]; then
    app_dir="${repo_dir}/${SUBDIR}"
    log_msg "INFO" "Using subfolder: ${SUBDIR}"
  fi

  log_msg "INFO" "Updating app: ${app_name}"
  local old_head
  old_head=$(git -C "${repo_dir}" rev-parse --short HEAD 2>/dev/null) || old_head="unknown"

  # Create backup before update. Guarded explicitly: when invoked from
  # autopull (errexit suppressed), an unchecked failure here would leave
  # backup_id empty and the later rollback would "restore" nothing.
  log_msg "INFO" "Creating backup before update..."
  local backup_id
  if ! backup_id=$(create_backup "${app_name}") || [[ -z "${backup_id}" ]]; then
    log_msg "ERROR" "Backup failed, aborting update (nothing was changed)"
    return 1
  fi

  # Track if we need to rollback
  local update_failed=false

  # Pull latest changes
  safe_cd "${repo_dir}" "pulling latest changes"
  if ! git_with_timeout pull origin "${BRANCH}"; then
    log_msg "ERROR" "Failed to pull latest changes"
    update_failed=true
  fi

  if [[ "${update_failed}" == "false" ]]; then
    # Check if .env.default has a low port and override it
    # Apps should not dictate their own ports - the PaaS assigns them
    local config_env="${APPS_CONFIG_DIR}/${app_name}/.env"
    local env_default="${app_dir}/.env.default"

    if [[ -f "${env_default}" ]] && grep -q "^PORT=" "${env_default}" 2>/dev/null; then
      local default_port
      default_port=$(grep "^PORT=" "${env_default}" | cut -d'=' -f2 | tr -d ' ')
      if [[ "${default_port}" =~ ^[0-9]+$ ]] && [[ "${default_port}" -lt 10001 ]]; then
        # Get current port from config .env or assign new one
        local assigned_port="${PORT}"
        if [[ -z "${assigned_port}" ]] || [[ "${assigned_port}" -lt 10001 ]]; then
          assigned_port=$(find_free_port)
        fi
        log_msg "WARN" "App's .env.default has low port ${default_port}, overriding with ${assigned_port}"
        update_port_in_env "${config_env}" "${assigned_port}"
        PORT="${assigned_port}"

        # Update Traefik config with new port
        local base_domain="${BASE_DOMAIN:-apps.example.edu}"
        create_traefik_config "${app_name}" "${assigned_port}" "${base_domain}" "${app_dir}/.env"
      fi
    fi

    # Get all services for this app
    local -a services
    get_all_services "${app_name}" services

    # Check if multi-component app
    if is_multi_component "${app_name}"; then
      # Multi-component: setup each component
      log_msg "INFO" "Updating ${#services[@]} components..."
      for component in "${services[@]}"; do
        # Resolve component directory (check root level first, then src/)
        # For subfolder deployments, components are relative to app_dir
        local component_dir="${app_dir}/${component}"
        if [[ ! -d "${component_dir}" ]]; then
          component_dir="${app_dir}/src/${component}"
        fi
        log_msg "INFO" "Updating component: ${component} at ${component_dir}"

        # Setup component environment
        if [[ -f "${component_dir}/go.mod" ]]; then
          setup_go_env "${component_dir}" || update_failed=true
        elif [[ -f "${component_dir}/requirements.txt" ]] || [[ -f "${component_dir}/pyproject.toml" ]]; then
          setup_python_env "${component_dir}" || update_failed=true
        elif [[ -f "${component_dir}/package.json" ]]; then
          setup_nodejs_env "${component_dir}" || update_failed=true
        fi

        # Run component install script
        if [[ -f "${component_dir}/install.sh" ]]; then
          safe_cd "${component_dir}" "running install.sh for ${component}"
          if ! bash install.sh; then
            log_msg "ERROR" "Install script failed for ${component}"
            update_failed=true
          fi
        fi
      done
    else
      # Single-component: setup app directory
      # For subfolder deployments, search up for dependency files
      local deps_dir="${app_dir}"
      if [[ -n "${SUBDIR:-}" ]]; then
        local found_dir
        if found_dir=$(find_file_up "requirements.txt" "${app_dir}" "${repo_dir}"); then
          deps_dir="${found_dir}"
        elif found_dir=$(find_file_up "pyproject.toml" "${app_dir}" "${repo_dir}"); then
          deps_dir="${found_dir}"
        elif found_dir=$(find_file_up "package.json" "${app_dir}" "${repo_dir}"); then
          deps_dir="${found_dir}"
        elif found_dir=$(find_file_up "go.mod" "${app_dir}" "${repo_dir}"); then
          deps_dir="${found_dir}"
        fi
      fi

      if is_zensical_site "${app_dir}"; then
        setup_zensical_env "${app_dir}" || update_failed=true
      else
        setup_python_env "${deps_dir}" || update_failed=true
        setup_nodejs_env "${deps_dir}" || update_failed=true
        setup_go_env "${deps_dir}" || update_failed=true
      fi

      # Run install script
      if ! run_install_script "${app_dir}"; then
        log_msg "ERROR" "Install script failed"
        update_failed=true
      fi
    fi
  fi

  if [[ "${update_failed}" == "true" ]]; then
    log_msg "WARN" "Update failed, rolling back to backup ${backup_id}..."
    if restore_backup "${app_name}" "${backup_id}"; then
      log_msg "INFO" "Rollback completed. App restored to previous version."
      notify "${app_name}" "update of ${BRANCH} failed; rolled back, still running ${old_head} (appmo logs ${app_name})"
    else
      log_msg "ERROR" "Rollback failed! App may be in inconsistent state."
      log_msg "ERROR" "Manual intervention required. Backup available at: ${BACKUPS_DIR}/${app_name}/${backup_id}"
      notify "${app_name}" "update of ${BRANCH} failed AND the automatic rollback failed; needs manual repair (backup ${backup_id})"
    fi
    return 1
  fi

  # Get SERVICES string if multi-component
  local services_str="" processes_str="" service
  if is_multi_component "${app_name}"; then
    services_str=$(echo "${services[@]}" | tr ' ' '\n' | sort | tr '\n' ' ' | xargs)
  elif [[ "${services[0]}" != "${app_name}" ]]; then
    # Procfile processes (also records them for apps added before PROCESSES)
    for service in "${services[@]}"; do
      processes_str+="${processes_str:+ }${service}"
    done
  fi

  # Update metadata timestamp (preserve SUBDIR and PROCESSES if set)
  save_app_metadata "${app_name}" "${GITHUB_URL}" "${BRANCH}" "${PORT}" "${services_str}" "${SUBDIR:-}" "${processes_str}"

  # The branch is deployed again, so a rollback pin no longer applies.
  # (autopull never updates a pinned app; only a manual update gets here.)
  if [[ -f "${APPS_CONFIG_DIR}/${app_name}/pinned" ]]; then
    rm -f "${APPS_CONFIG_DIR}/${app_name}/pinned"
    log_msg "INFO" "Rollback pin removed: autopull follows ${BRANCH} again"
  fi

  # Scheduled jobs from the new appmo-schedule, and RESTART_LIMIT
  sync_scheduled_jobs "${app_name}" "${app_dir}"
  apply_restart_limit "${app_name}"

  # Restart all services
  log_msg "INFO" "Restarting services..."
  for service in "${services[@]}"; do
    local service_name
    if [[ "${service}" == "frontend" ]] || [[ "${service}" == "${app_name}" ]]; then
      service_name="appmotel-${app_name}"
    else
      service_name="appmotel-${app_name}-${service}"
    fi
    systemctl --user reset-failed "${service_name}" 2>/dev/null || true
    systemctl --user restart "${service_name}"
  done
  local new_head
  new_head=$(git -C "${repo_dir}" rev-parse --short HEAD 2>/dev/null) || new_head="unknown"

  # Wait until the app answers on its port, so "updated" means usable
  local attempt
  # Listening, not connecting: for an isolated app whose PORT just changed,
  # the firewall allows the new port only after sync_isolated_traefik
  for attempt in $(seq 1 30); do
    if ss -ltnH "sport = :${PORT}" 2>/dev/null | grep -q .; then
      log_msg "INFO" "App updated successfully (backup: ${backup_id})"
      notify "${app_name}" "deployed ${BRANCH} ${old_head} -> ${new_head}"
      return 0
    fi
    sleep 1
  done
  log_msg "WARN" "App updated (backup: ${backup_id}), but port ${PORT} does not answer after 30 s; check: appmo logs ${app_name}"
  notify "${app_name}" "deployed ${BRANCH} ${old_head} -> ${new_head}, but port ${PORT} does not answer after 30 s (appmo logs ${app_name}; undo: appmo rollback ${app_name})"
}

# -----------------------------------------------------------------------------
# Function: cmd_logs
# Description: Shows app logs
# -----------------------------------------------------------------------------
cmd_logs() {
  local usage_text="Usage: appmo logs <app-name> [lines] [--since TIME] [--grep REGEX] [--follow]"
  if [[ $# -lt 1 ]]; then
    die "${usage_text}"
  fi

  local app_name="$1"
  shift
  local lines="" since="" pattern="" follow=false
  if [[ $# -gt 0 ]] && [[ "$1" =~ ^[0-9]+$ ]]; then
    lines="$1"
    shift
  fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--lines) [[ $# -ge 2 ]] || die "${usage_text}"; lines="$2"; shift 2 ;;
      --since) [[ $# -ge 2 ]] || die "${usage_text}"; since="$2"; shift 2 ;;
      --since=*) since="${1#--since=}"; shift ;;
      --grep|-g) [[ $# -ge 2 ]] || die "${usage_text}"; pattern="$2"; shift 2 ;;
      --grep=*) pattern="${1#--grep=}"; shift ;;
      -f|--follow) follow=true; shift ;;
      *) die "${usage_text}" ;;
    esac
  done
  [[ -z "${lines}" || "${lines}" =~ ^[0-9]+$ ]] || die "lines must be a number: ${lines}"

  require_app_exists "${app_name}"

  # Get all services for this app
  local -a services
  get_all_services "${app_name}" services

  # Build journalctl command with all service units
  local -a unit_args=()
  for service in "${services[@]}"; do
    local service_name
    if [[ "${service}" == "frontend" ]] || [[ "${service}" == "${app_name}" ]]; then
      service_name="appmotel-${app_name}"
    else
      service_name="appmotel-${app_name}-${service}"
    fi
    unit_args+=("-u" "${service_name}")
  done
  # Output of scheduled jobs
  local job_unit
  while IFS= read -r job_unit; do
    unit_args+=("-u" "${job_unit}")
  done < <(job_units "${app_name}")

  # Last 50 lines by default; with --since everything since then. --grep is
  # journalctl's own: -n then counts matching lines. Values are passed as
  # --opt=VALUE so they cannot be read as other options.
  local -a journal_args=(--user --no-pager "${unit_args[@]}")
  if [[ -n "${lines}" ]]; then
    journal_args+=(-n "${lines}")
  elif [[ -z "${since}" ]]; then
    journal_args+=(-n 50)
  fi
  [[ -z "${since}" ]] || journal_args+=("--since=${since}")
  [[ -z "${pattern}" ]] || journal_args+=("--grep=${pattern}")
  [[ "${follow}" == "false" ]] || journal_args+=(--follow)

  journalctl "${journal_args[@]}"
}

# -----------------------------------------------------------------------------
# Function: cmd_exec
# Description: Executes command in app environment
# -----------------------------------------------------------------------------
cmd_exec() {
  if [[ $# -lt 2 ]]; then
    die "Usage: appmo exec <app-name> <command>"
  fi

  local app_name="$1"
  shift

  require_app_exists "${app_name}"

  local repo_dir="${APPS_DATA_DIR}/${app_name}/repo"
  local env_file="${repo_dir}/.env"

  if [[ ! -d "${repo_dir}" ]]; then
    die "App repository directory not found: ${repo_dir}"
  fi

  safe_cd "${repo_dir}" "executing command in app environment"

  # Use safe_source_env to prevent command injection from malicious .env files
  if [[ -f "${env_file}" ]]; then
    safe_source_env "${env_file}"
  fi

  # Activate Python venv if it exists (venv activate scripts are trusted)
  if [[ -f "${repo_dir}/.venv/bin/activate" ]]; then
    # shellcheck source=/dev/null
    source "${repo_dir}/.venv/bin/activate"
  fi

  "$@"
}

# -----------------------------------------------------------------------------
# Function: env_get_value
# Description: Prints the value of KEY from an .env file (last line wins, as
#   in systemd), without one pair of outer quotes. Returns 1 if KEY is unset.
# -----------------------------------------------------------------------------
env_get_value() {
  local env_file="$1" key="$2" line
  [[ "${key}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "Invalid variable name '${key}'"
  line=$(grep -E "^[[:space:]]*${key}=" "${env_file}" 2>/dev/null | tail -n 1) || return 1
  local value="${line#*=}"
  value="${value%"${value##*[![:space:]]}"}"
  if [[ "${value}" =~ ^\"(.*)\"$ ]] || [[ "${value}" =~ ^\'(.*)\'$ ]]; then
    value="${BASH_REMATCH[1]}"
  fi
  printf '%s\n' "${value}"
}

# -----------------------------------------------------------------------------
# Function: env_set_value
# Description: Sets KEY=VALUE in an .env file: replaces the first KEY line,
#   drops later duplicates, or appends. Quotes the value so that systemd,
#   python-dotenv and safe_source_env all read the same string, and refuses a
#   value that safe_source_env would skip (the app would lose it silently).
# -----------------------------------------------------------------------------
env_set_value() {
  local env_file="$1" key="$2" value="$3" line
  [[ "${key}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "Invalid variable name '${key}'"
  [[ "${value}" != *$'\n'* ]] || die "The value of ${key} must be one line"

  if [[ "${value}" =~ ^[A-Za-z0-9_./:@%+,=-]*$ ]]; then
    line="${key}=${value}"
  elif [[ "${value}" != *"'"* ]]; then
    line="${key}='${value}'"
  elif [[ "${value}" != *[\"\\\$\`]* ]]; then
    line="${key}=\"${value}\""
  else
    die "The value of ${key} has both quote types: use 'appmo env <app>' to edit it"
  fi

  local tmp
  tmp=$(mktemp "${env_file}.XXXXXX")
  printf '%s\n' "${line}" > "${tmp}"
  if ! ( safe_source_env "${tmp}" true ) >/dev/null 2>&1; then
    rm -f "${tmp}"
    die "The value of ${key} is refused: no \$( , backticks, ;, && or || in .env values"
  fi

  touch "${env_file}"
  awk -v key="${key}" -v line="${line}" '
    $0 ~ "^[[:space:]]*" key "=" { if (!done) { print line; done = 1 }; next }
    { print }
    END { if (!done) print line }
  ' "${env_file}" > "${tmp}"
  # cat keeps the inode, mode and owner of the .env (the repo has a symlink to it)
  cat "${tmp}" > "${env_file}"
  rm -f "${tmp}"
}

# -----------------------------------------------------------------------------
# Function: env_unset_value
# Description: Removes every KEY= line from an .env file. Returns 1 if KEY
#   was not set (the file is not changed then).
# -----------------------------------------------------------------------------
env_unset_value() {
  local env_file="$1" key="$2" tmp
  [[ "${key}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "Invalid variable name '${key}'"
  grep -qE "^[[:space:]]*${key}=" "${env_file}" 2>/dev/null || return 1
  tmp=$(mktemp "${env_file}.XXXXXX")
  grep -vE "^[[:space:]]*${key}=" "${env_file}" > "${tmp}" || true
  cat "${tmp}" > "${env_file}"
  rm -f "${tmp}"
}

# -----------------------------------------------------------------------------
# Function: env_set_lines
# Description: Reads KEY=VALUE lines from stdin (blank lines and # comments
#   are skipped) and sets them all in the .env, or none if one is refused.
#   A value is the rest of the line, without one pair of outer quotes.
# -----------------------------------------------------------------------------
env_set_lines() {
  local env_file="$1" input copy line value n=0
  [[ ! -t 0 ]] || die "Give KEY=VALUE lines on stdin, e.g. a here-doc: appmo env <app> set <<'EOF'"
  input=$(cat)
  touch "${env_file}"
  copy=$(mktemp "${env_file}.XXXXXX")
  cat "${env_file}" > "${copy}"
  # A subshell, so that a refused line (die) leaves the .env as it was
  if ! (
    while IFS= read -r line; do
      n=$((n + 1))
      [[ -z "${line//[[:space:]]/}" || "${line}" =~ ^[[:space:]]*# ]] && continue
      # Line number only: a line without = may be a pasted secret
      [[ "${line}" == *=* ]] || die "Line ${n} is not KEY=VALUE"
      value="${line#*=}"
      if [[ "${value}" =~ ^\"(.*)\"$ ]] || [[ "${value}" =~ ^\'(.*)\'$ ]]; then
        value="${BASH_REMATCH[1]}"
      fi
      env_set_value "${copy}" "${line%%=*}" "${value}"
    done <<< "${input}"
  ); then
    rm -f "${copy}"
    die "Nothing was changed"
  fi
  cat "${copy}" > "${env_file}"
  rm -f "${copy}"
  n=$(grep -cvE '^[[:space:]]*(#|$)' <<< "${input}") || true
  log_msg "INFO" "Set ${n} variable(s)"
}

# -----------------------------------------------------------------------------
# Function: cmd_env
# Description: appmo env <app>                 edit the .env in an editor
#              appmo env <app> get KEY         print one value
#              appmo env <app> set KEY VALUE   set one value (KEY=VALUE works
#                too; without a value it is read from stdin, which keeps a
#                secret out of the process list and the sudo log)
#              appmo env <app> set < lines     set many KEY=VALUE lines from
#                stdin, all or none
#              appmo env <app> unset KEY...    remove variables
# The physical .env lives in config dir, repo has symlink to it
# -----------------------------------------------------------------------------
cmd_env() {
  if [[ $# -lt 1 ]]; then
    die "Usage: appmo env <app-name> [get KEY | set [KEY [VALUE]] | unset KEY...]"
  fi

  local app_name="$1"
  require_app_exists "${app_name}"

  if [[ $# -ge 2 ]]; then
    local env_path="${APPS_CONFIG_DIR}/${app_name}/.env"
    if [[ "$2" == "set" || "$2" == "unset" ]]; then
      # Agents run calls in parallel: without the lock, two read-change-write
      # cycles lose one change. Held until appmo exits.
      mkdir -p "${APPS_CONFIG_DIR}/${app_name}"
      local lock_fd
      exec {lock_fd}>>"${APPS_CONFIG_DIR}/${app_name}/.env.lock"
      flock "${lock_fd}"
    fi
    case "$2" in
      get)
        [[ $# -eq 3 ]] || die "Usage: appmo env ${app_name} get KEY"
        env_get_value "${env_path}" "$3" || die "${3} is not set in the .env of ${app_name}"
        ;;
      set)
        [[ $# -ge 2 && $# -le 4 ]] || die "Usage: appmo env ${app_name} set [KEY [VALUE]]"
        if [[ $# -eq 2 ]]; then
          env_set_lines "${env_path}"
          log_msg "INFO" "Run 'appmo restart ${app_name}' to apply."
          return 0
        fi
        local key="$3" value
        if [[ $# -eq 4 || "${key}" == *=* ]]; then
          if [[ $# -eq 4 ]]; then
            value="$4"
          else
            value="${key#*=}"
            key="${key%%=*}"
          fi
          # The audit log hides it, but the sudo log and ps show it
          if [[ "${key^^}" =~ (PASS|SECRET|TOKEN|KEY|PRIVATE|CREDENTIAL|AUTH) ]]; then
            log_msg "WARN" "${key} was given on the command line, so the sudo log has it. Next time: printf '%s' \"\$${key}\" | appmo env ${app_name} set ${key}"
          fi
        elif [[ -t 0 ]]; then
          read -r -s -p "Value for ${key}: " value || die "No value given"
          echo >&2
        else
          value=$(cat)
        fi
        env_set_value "${env_path}" "${key}" "${value}"
        log_msg "INFO" "Set ${key} for ${app_name}. Run 'appmo restart ${app_name}' to apply."
        ;;
      unset)
        [[ $# -ge 3 ]] || die "Usage: appmo env ${app_name} unset KEY..."
        local k
        for k in "${@:3}"; do
          if env_unset_value "${env_path}" "${k}"; then
            log_msg "INFO" "Removed ${k} from ${app_name}"
          else
            log_msg "WARN" "${k} was not set in ${app_name}"
          fi
        done
        log_msg "INFO" "Run 'appmo restart ${app_name}' to apply."
        ;;
      *) die "Usage: appmo env <app-name> [get KEY | set [KEY [VALUE]] | unset KEY...]" ;;
    esac
    return 0
  fi

  # Physical .env is in config directory
  local env_file="${APPS_CONFIG_DIR}/${app_name}/.env"
  local repo_env="${APPS_DATA_DIR}/${app_name}/repo/.env"

  if [[ ! -f "${env_file}" ]]; then
    # Create .env file if it doesn't exist
    mkdir -p "${APPS_CONFIG_DIR}/${app_name}"
    touch "${env_file}"
    log_msg "INFO" "Created new .env file: ${env_file}"
  fi

  # Ensure symlink exists in repo
  if [[ ! -L "${repo_env}" ]]; then
    rm -f "${repo_env}"
    ln -s "${env_file}" "${repo_env}"
  fi

  # Capture file hash before editing to detect changes
  local hash_before=""
  if [[ -f "${env_file}" ]]; then
    hash_before=$(md5sum "${env_file}" 2>/dev/null | awk '{print $1}')
  fi

  # EDITOR or VISUAL, else vim (vi if vim is missing). sudo drops EDITOR, so
  # the default is the usual case.
  local editor="${EDITOR:-${VISUAL:-}}"
  if [[ -z "${editor}" ]]; then
    editor=vi
    command -v vim >/dev/null 2>&1 && editor=vim
  fi
  local -a editor_cmd=("${editor}")
  # Mouse off in vi/vim, so terminal select and paste work (copy secrets in and out)
  case "${editor##*/}" in
    vi|vim|vim.*|nvim) editor_cmd+=(-c 'set mouse=') ;;
  esac

  log_msg "INFO" "Opening ${env_file} with ${editor}"
  "${editor_cmd[@]}" "${env_file}"

  # Check if file was modified
  local hash_after=""
  if [[ -f "${env_file}" ]]; then
    hash_after=$(md5sum "${env_file}" 2>/dev/null | awk '{print $1}')
  fi

  if [[ "${hash_before}" != "${hash_after}" ]]; then
    log_msg "INFO" "Environment file changed"
    # Ask user if they want to restart
    printf "Restart app to apply changes? [Y/n] "
    read -r answer || answer=""
    case "${answer}" in
      [nN]|[nN][oO])
        log_msg "INFO" "Skipping restart. Run 'appmo restart ${app_name}' to apply changes later."
        ;;
      *)
        cmd_restart "${app_name}"
        ;;
    esac
  else
    log_msg "INFO" "No changes detected"
  fi
}

# -----------------------------------------------------------------------------
# Function: cmd_backup
# Description: Creates a backup of an app
# -----------------------------------------------------------------------------
cmd_backup() {
  if [[ $# -lt 1 ]]; then
    die "Usage: appmo backup <app-name>"
  fi

  local app_name="$1"
  require_app_exists "${app_name}"

  log_msg "INFO" "Creating backup for app: ${app_name}"
  local backup_id
  backup_id=$(create_backup "${app_name}")
  log_msg "INFO" "Backup created successfully: ${backup_id}"
}

# -----------------------------------------------------------------------------
# Function: cmd_restore
# Description: Restores an app from a backup
# -----------------------------------------------------------------------------
cmd_restore() {
  if [[ $# -lt 1 ]]; then
    die "Usage: appmo restore <app-name> [backup-id]"
  fi

  local app_name="$1"
  local backup_id="${2:-}"

  require_app_exists "${app_name}"

  # If no backup-id provided, use the most recent
  if [[ -z "${backup_id}" ]]; then
    local backup_base="${BACKUPS_DIR}/${app_name}"
    if [[ ! -d "${backup_base}" ]]; then
      die "No backups found for app '${app_name}'"
    fi
    backup_id=$(ls -t "${backup_base}" | head -1)
    if [[ -z "${backup_id}" ]]; then
      die "No backups found for app '${app_name}'"
    fi
    log_msg "INFO" "Using most recent backup: ${backup_id}"
  fi

  if ! restore_backup "${app_name}" "${backup_id}"; then
    die "Restore failed - check logs for details"
  fi
}

# -----------------------------------------------------------------------------
# Function: cmd_backups
# Description: Lists available backups for an app
# -----------------------------------------------------------------------------
cmd_backups() {
  if [[ $# -lt 1 ]]; then
    die "Usage: appmo backups <app-name>"
  fi

  local app_name="$1"
  require_app_exists "${app_name}"

  list_backups "${app_name}"
}

# -----------------------------------------------------------------------------
# Function: cmd_rollback
# Description: Go back to the version before the last update (the newest
#   backup of another commit), or to a given backup, and pin the app there:
#   autopull would otherwise deploy the bad commit again two minutes later.
#   Code and settings (.env) come from the backup. The state before the
#   rollback is backed up first, so appmo restore can undo it.
# -----------------------------------------------------------------------------
cmd_rollback() {
  if [[ $# -lt 1 ]] || [[ $# -gt 2 ]]; then
    die "Usage: appmo rollback <app-name> [backup-id]"
  fi
  local app_name="$1" backup_id="${2:-}"
  require_app_exists "${app_name}"
  load_app_metadata "${app_name}"

  local repo_dir="${APPS_DATA_DIR}/${app_name}/repo"
  local head=""
  head=$(git -C "${repo_dir}" rev-parse HEAD 2>/dev/null) || head=""

  if [[ -z "${backup_id}" ]]; then
    backup_id=$(rollback_target "${app_name}" "${head}") \
      || die "No backup of an older version of '${app_name}' (see: appmo backups ${app_name})"
  fi
  validate_backup_id "${backup_id}"
  local target_dir="${BACKUPS_DIR}/${app_name}/${backup_id}"
  [[ -d "${target_dir}" ]] || die "Backup '${backup_id}' not found for app '${app_name}' (see: appmo backups ${app_name})"

  # Hold autopull's lock: a run during the restore (which can take minutes)
  # would see the app unpinned at an older commit and deploy the branch again
  mkdir -p "${APPS_DATA_DIR}"
  exec 8>>"${APPS_DATA_DIR}/.autopull.lock"
  if ! flock --wait 900 8; then
    die "autopull has held its lock for 15 minutes; try again later"
  fi

  # Back up the current state, so appmo restore can undo the rollback. Not
  # pruned (pruning could delete the target), and marked, so that a second
  # rollback skips it and goes further back instead of forward again.
  log_msg "INFO" "Backing up the current state first..."
  local safety_id=""
  if ! safety_id=$(create_backup "${app_name}" keep-all) || [[ -z "${safety_id}" ]]; then
    die "Backup of the current state failed, nothing was changed"
  fi
  touch "${BACKUPS_DIR}/${app_name}/${safety_id}/ROLLBACK_SAFETY"

  log_msg "INFO" "Rolling back '${app_name}' to backup ${backup_id}..."
  local restored=true
  restore_backup "${app_name}" "${backup_id}" || restored=false

  # Pin also after a failed restore: autopull must not deploy over it. The
  # restore replaced the config dir, so the pin is written only now.
  local now_head=""
  now_head=$(git -C "${repo_dir}" rev-parse HEAD 2>/dev/null) || now_head=""
  mkdir -p "${APPS_CONFIG_DIR}/${app_name}"
  printf 'COMMIT="%s"\nBACKUP="%s"\nSINCE="%s"\n' "${now_head}" "${backup_id}" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "${APPS_CONFIG_DIR}/${app_name}/pinned"
  if [[ "${restored}" == "false" ]]; then
    notify "${app_name}" "rollback to backup ${backup_id} failed; autopull paused (appmo status ${app_name})"
    die "Rollback failed - check: appmo status ${app_name}. Autopull leaves it alone until appmo unpin ${app_name}; the state before the rollback is backup ${safety_id}"
  fi

  log_msg "INFO" "Rolled back '${app_name}' from ${head:0:8} to ${now_head:0:8} (backup ${backup_id})"
  log_msg "INFO" "Pinned: autopull does not update '${app_name}' until: appmo unpin ${app_name} (or appmo update ${app_name})"
  log_msg "INFO" "Undo the rollback: appmo restore ${app_name} ${safety_id}"
  notify "${app_name}" "rolled back from ${head:0:8} to ${now_head:0:8} (backup ${backup_id}); autopull paused until appmo unpin ${app_name}"
}

# -----------------------------------------------------------------------------
# Function: cmd_unpin
# Description: Remove a rollback pin; the next autopull deploys the branch
# -----------------------------------------------------------------------------
cmd_unpin() {
  [[ $# -eq 1 ]] || die "Usage: appmo unpin <app-name>"
  local app_name="$1"
  require_app_exists "${app_name}"
  local pin_file="${APPS_CONFIG_DIR}/${app_name}/pinned"
  if [[ ! -f "${pin_file}" ]]; then
    log_msg "INFO" "App '${app_name}' is not pinned"
    return 0
  fi
  rm -f "${pin_file}"
  log_msg "INFO" "Unpinned '${app_name}': the next autopull deploys the latest commit of its branch (now: appmo update ${app_name})"
}

# -----------------------------------------------------------------------------
# Function: verify_result
# Description: One result line of appmo backup-verify; a FAIL is counted in
#   the caller's verify_failures
# -----------------------------------------------------------------------------
verify_result() {
  local status="$1" message="$2"
  printf '  %-5s %s\n' "${status}" "${message}"
  if [[ "${status}" == "FAIL" ]]; then
    verify_failures=$((verify_failures + 1))
  fi
}

# -----------------------------------------------------------------------------
# Function: verify_backup
# Description: Check that a backup can be restored, without touching the
#   app: the code archive reads to the end and extracts to an intact git
#   repository (git fsck) of the recorded commit, the settings parse, the
#   unit files have an ExecStart, and the Traefik route is there.
# Returns: 0 if all checks pass, 1 otherwise
# -----------------------------------------------------------------------------
verify_backup() {
  local app_name="$1" backup_id="$2"
  local dir="${BACKUPS_DIR}/${app_name}/${backup_id}"
  local verify_failures=0
  [[ -d "${dir}" ]] || die "Backup '${backup_id}' not found for app '${app_name}' (see: appmo backups ${app_name})"

  echo "Backup ${backup_id} of ${app_name}:"

  # Code
  local recorded=""
  recorded=$(cat "${dir}/COMMIT" 2>/dev/null) || recorded=""
  if [[ ! -f "${dir}/repo.tar.gz" ]]; then
    verify_result FAIL "repo.tar.gz is missing: the backup has no code"
  else
    local entries=""
    if ! entries=$(tar -tzf "${dir}/repo.tar.gz" 2>/dev/null | wc -l) || [[ "${entries}" -eq 0 ]]; then
      verify_result FAIL "repo.tar.gz is damaged or truncated"
    else
      verify_result ok "repo.tar.gz reads to the end (${entries} entries)"
      check_disk_space "${BACKUPS_DIR}" 200
      local work
      work=$(mktemp -d "${BACKUPS_DIR}/.verify.XXXXXX")
      # Expanded now on purpose: work is local to this function
      # shellcheck disable=SC2064
      trap "rm -rf -- '${work}'; cleanup_temp_files" EXIT
      if ! tar -xzf "${dir}/repo.tar.gz" -C "${work}" 2>/dev/null; then
        verify_result FAIL "repo.tar.gz does not extract"
      else
        local head=""
        head=$(git -C "${work}/repo" rev-parse --verify -q HEAD 2>/dev/null) || head=""
        if [[ -z "${head}" ]]; then
          verify_result FAIL "the code in repo.tar.gz is not a git repository with a commit"
        elif ! git -C "${work}/repo" fsck --no-progress --no-dangling >/dev/null 2>&1; then
          verify_result FAIL "git fsck finds damaged objects (commit ${head:0:8})"
        elif [[ -n "${recorded}" ]] && [[ "${recorded}" != "${head}" ]]; then
          verify_result FAIL "COMMIT says ${recorded:0:8}, but the archive has ${head:0:8}"
        else
          verify_result ok "git repository intact, commit ${head:0:8}"
        fi
      fi
      rm -rf -- "${work}"
      trap cleanup_temp_files EXIT
    fi
  fi

  # Settings
  if [[ ! -f "${dir}/config/metadata.conf" ]]; then
    verify_result FAIL "config/metadata.conf is missing"
  elif ! (safe_source_metadata "${dir}/config/metadata.conf") >/dev/null 2>&1; then
    verify_result FAIL "config/metadata.conf does not parse"
  else
    local port=""
    port=$(env_get_value "${dir}/config/.env" PORT 2>/dev/null) || port=""
    if [[ -z "${port}" ]]; then
      verify_result FAIL "config/.env is missing or has no PORT"
    else
      verify_result ok "settings: metadata.conf and .env (PORT=${port})"
    fi
  fi

  # Services
  local f names="" bad=""
  for f in "${dir}"/appmotel-*.service; do
    [[ -f "${f}" ]] || continue
    names+="${names:+, }${f##*/}"
    grep -q '^ExecStart=' "${f}" || bad+="${bad:+, }${f##*/}"
  done
  if [[ -z "${names}" ]]; then
    verify_result FAIL "no systemd unit file in the backup"
  elif [[ -n "${bad}" ]]; then
    verify_result FAIL "no ExecStart in ${bad}"
  else
    verify_result ok "systemd units: ${names}"
  fi

  # Route
  if [[ "${APPMO_ROLE}" == "app" ]]; then
    verify_result skip "Traefik route (appmotel keeps it for isolated apps)"
  elif grep -q 'routers:' "${dir}/${app_name}.yaml" 2>/dev/null; then
    verify_result ok "Traefik route ${app_name}.yaml"
  else
    verify_result FAIL "Traefik route ${app_name}.yaml is missing or empty"
  fi

  if [[ ${verify_failures} -gt 0 ]]; then
    log_msg "ERROR" "Backup ${backup_id} has ${verify_failures} problem(s): appmo restore may not bring '${app_name}' back"
    return 1
  fi
  log_msg "INFO" "Backup ${backup_id} looks restorable"
}

# -----------------------------------------------------------------------------
# Function: cmd_backup_verify
# Description: appmo backup-verify <app> [backup-id] (default: the newest)
# -----------------------------------------------------------------------------
cmd_backup_verify() {
  if [[ $# -lt 1 ]] || [[ $# -gt 2 ]]; then
    die "Usage: appmo backup-verify <app-name> [backup-id]"
  fi
  local app_name="$1" backup_id="${2:-}"
  require_app_exists "${app_name}"
  if [[ -z "${backup_id}" ]]; then
    backup_id=$(ls -1 "${BACKUPS_DIR}/${app_name}" 2>/dev/null | sort -rV | head -n 1) || backup_id=""
    [[ -n "${backup_id}" ]] || die "No backups found for app '${app_name}'"
  fi
  validate_backup_id "${backup_id}"
  verify_backup "${app_name}" "${backup_id}"
}

# -----------------------------------------------------------------------------
# Function: human_bytes
# Description: 1536 -> 1.5K; "-" for a value systemd does not track
# -----------------------------------------------------------------------------
human_bytes() {
  local bytes="$1"
  if ! is_counter "${bytes}"; then
    echo "-"
    return 0
  fi
  awk -v b="${bytes}" 'BEGIN { split("B K M G T", u, " "); i = 1
    while (b >= 1024 && i < 5) { b /= 1024; i++ }
    if (i == 1) printf "%dB\n", b; else printf "%.1f%s\n", b, u[i] }'
}

# -----------------------------------------------------------------------------
# Function: format_cpu_time
# Description: CPUUsageNSec -> 4.2s, 3m07s or 5h02m; "-" if not tracked
# -----------------------------------------------------------------------------
format_cpu_time() {
  local nsec="$1"
  if ! is_counter "${nsec}"; then
    echo "-"
    return 0
  fi
  local secs=$(( nsec / 1000000000 ))
  if (( secs < 60 )); then
    awk -v n="${nsec}" 'BEGIN { printf "%.1fs\n", n / 1e9 }'
  elif (( secs < 3600 )); then
    printf '%dm%02ds\n' $(( secs / 60 )) $(( secs % 60 ))
  else
    printf '%dh%02dm\n' $(( secs / 3600 )) $(( secs % 3600 / 60 ))
  fi
}

# -----------------------------------------------------------------------------
# Function: top_row
# Description: One line of appmo top: summed over the app's units, the
#   state, memory now and the memory limit, CPU time and automatic restarts
#   since they were started; then the disk use of its code and data.
# -----------------------------------------------------------------------------
top_row() {
  local app_name="$1"
  local -a units=()
  get_app_unit_files "${app_name}" units
  local -A props=()
  local unit value total=0 active=0 failed=0 crashing=0
  local mem=0 mem_known=false cpu=0 cpu_known=false restarts=0 limit="-"
  for unit in "${units[@]}"; do
    unit_props "${unit}" props LoadState ActiveState SubState MemoryCurrent MemoryMax CPUUsageNSec NRestarts
    if [[ "${props[LoadState]:-not-found}" == "not-found" ]]; then
      continue
    fi
    total=$((total + 1))
    case "${props[ActiveState]:-}" in
      active) active=$((active + 1)) ;;
      failed) failed=$((failed + 1)) ;;
    esac
    if [[ "${props[SubState]:-}" == auto-restart* ]]; then
      crashing=$((crashing + 1))
    fi
    value="${props[MemoryCurrent]:-}"
    if is_counter "${value}"; then
      mem=$((mem + value))
      mem_known=true
    fi
    value="${props[CPUUsageNSec]:-}"
    if is_counter "${value}"; then
      cpu=$((cpu + value))
      cpu_known=true
    fi
    value="${props[NRestarts]:-}"
    if is_counter "${value}"; then
      restarts=$((restarts + value))
    fi
    if [[ "${limit}" == "-" ]]; then
      limit=$(human_bytes "${props[MemoryMax]:-}")
    fi
  done

  local state
  if [[ ${total} -eq 0 ]]; then
    state="no-units"
  elif [[ ${failed} -gt 0 ]]; then
    state="FAILED"
  elif [[ ${crashing} -gt 0 ]]; then
    state="CRASHING"
  elif [[ ${active} -eq ${total} ]]; then
    state="running"
  elif [[ ${active} -eq 0 ]]; then
    state="stopped"
  else
    state="partial"
  fi

  local mem_text="-" cpu_text="-" disk="-" du_bytes=""
  [[ "${mem_known}" == "false" ]] || mem_text=$(human_bytes "${mem}")
  [[ "${cpu_known}" == "false" ]] || cpu_text=$(format_cpu_time "${cpu}")
  if du_bytes=$(du -s -B1 "${APPS_DATA_DIR}/${app_name}" 2>/dev/null | cut -f1); then
    disk=$(human_bytes "${du_bytes}")
  fi
  printf '%-24s %-9s %8s %8s %9s %8s %8s\n' \
    "${app_name}" "${state}" "${mem_text}" "${limit}" "${cpu_text}" "${restarts}" "${disk}"
}

# -----------------------------------------------------------------------------
# Function: cmd_top
# Description: appmo top [app-name...]: resource use per app (all apps if no
#   name is given). Rows of isolated apps come from their own users.
# -----------------------------------------------------------------------------
cmd_top() {
  local header=true
  local -a apps=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-header) header=false ;;
      -*) die "Usage: appmo top [app-name...]" ;;
      *) apps+=("$1") ;;
    esac
    shift
  done

  if [[ ${#apps[@]} -eq 0 ]]; then
    local dir name
    for dir in "${APPS_CONFIG_DIR}"/*/; do
      name="${dir%/}"
      name="${name##*/}"
      if app_exists "${name}"; then
        apps+=("${name}")
      fi
    done
  fi
  if [[ ${#apps[@]} -eq 0 ]]; then
    log_msg "INFO" "No apps configured yet"
    return 0
  fi

  if [[ "${header}" == "true" ]]; then
    printf '%-24s %-9s %8s %8s %9s %8s %8s\n' APP STATE MEMORY LIMIT CPU-TIME RESTARTS DISK
  fi
  local app
  for app in "${apps[@]}"; do
    require_app_exists "${app}"
    if is_isolated "${app}"; then
      run_appmo_as_app "${app}" top --no-header "${app}" \
        || printf '%-24s %s\n' "${app}" "(could not read it as ${APP_USER_PREFIX}${app})"
      continue
    fi
    top_row "${app}"
  done
}

# -----------------------------------------------------------------------------
# Function: cmd_check
# Description: Check for available updates without deploying
# -----------------------------------------------------------------------------
cmd_check() {
  local filter_app="${1:-}"

  # Check if apps directory exists
  if [[ ! -d "${APPS_CONFIG_DIR}" ]]; then
    echo "No apps configured yet"
    return 0
  fi

  # If specific app requested, verify it exists
  if [[ -n "${filter_app}" ]]; then
    require_app_exists "${filter_app}"
  fi

  local updates_available=0
  local app_count=0

  printf "%-22s %-12s %-10s %s\n" "APP" "STATUS" "LOCAL" "REMOTE"
  printf "%-22s %-12s %-10s %s\n" "---" "------" "-----" "------"

  for app_dir in "${APPS_CONFIG_DIR}"/*; do
    if [[ ! -d "${app_dir}" ]]; then
      continue
    fi

    local app_name
    app_name=$(basename "${app_dir}")

    # If filter specified, skip non-matching apps
    if [[ -n "${filter_app}" ]] && [[ "${app_name}" != "${filter_app}" ]]; then
      continue
    fi

    # Skip directories that only have .env.backup (removed apps)
    if ! app_exists "${app_name}"; then
      continue
    fi

    app_count=$((app_count + 1))

    if is_isolated "${app_name}"; then
      run_appmo_as_app "${app_name}" check "${app_name}" | grep "^${app_name} " || true
      continue
    fi

    local repo_dir="${APPS_DATA_DIR}/${app_name}/repo"

    if [[ ! -d "${repo_dir}" ]]; then
      printf "%-22s %-12s %-10s %s\n" "${app_name}" "NO REPO" "-" "-"
      continue
    fi

    cd "${repo_dir}" || { printf "%-22s %-12s %-10s %s\n" "${app_name}" "CD ERR" "-" "-"; continue; }

    if ! git rev-parse --git-dir > /dev/null 2>&1; then
      printf "%-22s %-12s %-10s %s\n" "${app_name}" "NOT GIT" "-" "-"
      continue
    fi

    # Fetch latest changes (quietly)
    if ! git_with_timeout fetch origin 2>/dev/null; then
      printf "%-22s %-12s %-10s %s\n" "${app_name}" "FETCH ERR" "-" "-"
      continue
    fi

    local local_head
    local remote_head
    if ! local_head=$(git rev-parse HEAD 2>/dev/null); then
      printf "%-22s %-12s %-10s %s\n" "${app_name}" "BAD HEAD" "-" "-"
      continue
    fi

    local tracking_branch
    tracking_branch=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || echo "")

    if [[ -z "${tracking_branch}" ]]; then
      printf "%-22s %-12s %-10s %s\n" "${app_name}" "NO TRACK" "${local_head:0:8}" "-"
      continue
    fi

    if ! remote_head=$(git rev-parse "${tracking_branch}" 2>/dev/null); then
      printf "%-22s %-12s %-10s %s\n" "${app_name}" "BAD TRACK" "${local_head:0:8}" "-"
      continue
    fi

    if [[ "${local_head}" != "${remote_head}" ]]; then
      printf "%-22s %-12s %-10s %s\n" "${app_name}" "UPDATE" "${local_head:0:8}" "${remote_head:0:8}"
      updates_available=$((updates_available + 1))
    else
      printf "%-22s %-12s %-10s %s\n" "${app_name}" "up-to-date" "${local_head:0:8}" "-"
    fi
  done

  echo ""
  if [[ ${app_count} -eq 0 ]]; then
    echo "No apps found"
  elif [[ ${updates_available} -eq 0 ]]; then
    echo "All ${app_count} app(s) are up to date"
  else
    echo "${updates_available} of ${app_count} app(s) have updates available"
    echo "Run 'appmo update <app>' or 'appmo autopull' to deploy"
  fi
}

# -----------------------------------------------------------------------------
# Function: check_app_errors
# Description: Checks recent app logs for errors and files a GitHub issue
# with Claude Code analysis. Runs during each autopull cycle.
# Controlled by AUTO_DEBUG=no in app .env to opt out.
# Deduplication: 24h cooldown file prevents repeated filing for the same app.
# Prerequisites: claude (Claude Code CLI) + gh (GitHub CLI, authenticated)
# -----------------------------------------------------------------------------
check_app_errors() {
  local app_name="$1"
  local app_config_dir="${APPS_CONFIG_DIR}/${app_name}"
  local cooldown_file="${app_config_dir}/.auto-debug-cooldown"
  local metadata_file="${app_config_dir}/metadata.conf"
  local env_file="${app_config_dir}/.env"

  # Respect per-app opt-out
  if [[ -f "${env_file}" ]]; then
    local parsed_env
    parsed_env=$(parse_env_file "${env_file}")
    if echo "${parsed_env}" | grep -q "^AUTO_DEBUG=no$"; then
      return 0
    fi
  fi

  # Enforce 24-hour cooldown to avoid duplicate issues
  if [[ -f "${cooldown_file}" ]]; then
    local last_check now
    last_check=$(cat "${cooldown_file}" 2>/dev/null || echo 0)
    now=$(date +%s)
    if (( now - last_check < 86400 )); then
      return 0
    fi
  fi

  # Collect last 3 minutes of app logs (slight overlap covers cycle timing)
  local recent_logs
  recent_logs=$(XDG_RUNTIME_DIR=/run/user/"$(id -u)" \
    journalctl --user -u "appmotel-${app_name}" \
    --since "3 minutes ago" --no-pager -o short 2>/dev/null || true)

  [[ -z "${recent_logs}" ]] && return 0

  # Detect error patterns across Python, Node.js, Go, and generic frameworks
  local error_lines
  error_lines=$(echo "${recent_logs}" | \
    grep -iE "(ERROR|CRITICAL|EXCEPTION|TRACEBACK|FATAL|PANIC:|UnhandledPromise)" || true)

  [[ -z "${error_lines}" ]] && return 0

  log_msg "WARN" "${app_name}: errors detected in recent logs"

  # Check prerequisites — fail gracefully with actionable messages
  local claude_bin gh_bin
  claude_bin=$(command -v claude 2>/dev/null || true)
  gh_bin=$(command -v gh 2>/dev/null || true)

  if [[ -z "${claude_bin}" ]]; then
    log_msg "INFO" "${app_name}: auto-debug requires Claude Code CLI (https://claude.ai/code)"
    return 0
  fi

  if [[ -z "${gh_bin}" ]]; then
    log_msg "INFO" "${app_name}: auto-debug requires the GitHub CLI (https://cli.github.com)"
    return 0
  fi

  if ! "${gh_bin}" auth status >/dev/null 2>&1; then
    log_msg "INFO" "${app_name}: auto-debug requires 'gh auth login' to file issues"
    return 0
  fi

  # Read repo URL from metadata
  local github_url=""
  if [[ -f "${metadata_file}" ]]; then
    github_url=$(grep "^GITHUB_URL=" "${metadata_file}" | cut -d= -f2- | tr -d '"')
  fi

  if [[ -z "${github_url}" ]]; then
    log_msg "WARN" "${app_name}: auto-debug skipped — no GITHUB_URL in metadata"
    return 0
  fi

  # Derive owner/repo from full GitHub URL (strip protocol, host, .git, /tree/... subfolder)
  local repo_ref
  # Handle both https and SSH clone URLs (cmd_add produces git@ URLs when
  # SSH access exists); gh --repo needs plain owner/repo
  repo_ref=$(echo "${github_url}" | sed 's|https://github.com/||; s|git@github.com:||; s|\.git$||; s|/tree/.*||')

  log_msg "INFO" "${app_name}: sending logs to Claude Code for analysis"

  # Structured prompt — ask for a fixed output format so we can parse it reliably
  local prompt
  prompt="Analyze this error log from a deployed web application.

App name: ${app_name}
Repository: ${github_url}

Recent log output (last 3 minutes):
\`\`\`
${recent_logs}
\`\`\`

Respond using exactly this format (be concise):
TITLE: <one-line summary of the error, max 80 chars>
CAUSE: <one paragraph — most likely root cause>
FIX: <concrete steps to investigate or resolve>"

  local analysis
  analysis=$(echo "${prompt}" | "${claude_bin}" -p 2>/dev/null || true)

  if [[ -z "${analysis}" ]]; then
    log_msg "WARN" "${app_name}: Claude Code returned no output"
    return 0
  fi

  # Parse structured sections from Claude's response.
  # grep exits 1 on no match; without the || the assignment would abort the
  # whole autopull run under errexit+pipefail when a TITLE: line is missing.
  local issue_title cause fix
  issue_title=$(echo "${analysis}" | grep "^TITLE:" | sed 's/^TITLE:[[:space:]]*//' || true)
  cause=$(echo "${analysis}" | awk '/^CAUSE:/{found=1; sub(/^CAUSE:[[:space:]]*/,""); print; next} /^FIX:/{found=0} found{print}')
  fix=$(echo "${analysis}" | awk '/^FIX:/{found=1; sub(/^FIX:[[:space:]]*/,""); print; next} found{print}')

  [[ -z "${issue_title}" ]] && issue_title="Error detected in ${app_name}"

  # File GitHub issue
  local issue_url
  issue_url=$("${gh_bin}" issue create \
    --repo "${repo_ref}" \
    --title "[appmotel] ${issue_title}" \
    --body "## Auto-detected error in \`${app_name}\`

**Server:** $(hostname -f 2>/dev/null || hostname)
**Time:** $(date -u +"%Y-%m-%d %H:%M UTC")

## Error excerpt
\`\`\`
${error_lines}
\`\`\`

## Claude Code analysis

**Likely cause:** ${cause}

**Suggested fix:** ${fix}

<details>
<summary>Full recent logs</summary>

\`\`\`
${recent_logs}
\`\`\`
</details>

---
*Auto-filed by [appmotel](https://github.com/dirkpetersen/appmotel). Disable per-app with \`AUTO_DEBUG=no\` in the app's \`.env\`.*" \
    2>/dev/null || true)

  if [[ -n "${issue_url}" ]]; then
    log_msg "INFO" "${app_name}: filed GitHub issue — ${issue_url}"
    date +%s > "${cooldown_file}"
  else
    log_msg "WARN" "${app_name}: failed to file GitHub issue (check repo access and gh auth)"
  fi
}

# -----------------------------------------------------------------------------
# Function: check_crash_loop
# Description: Report (log ERROR + notify, at most once an hour) a unit of
#   the app that systemd gave up on (RESTART_LIMIT hit) or that restarted
#   CRASH_LOOP_RESTARTS times or more since the previous autopull. The
#   restart counts of the last run are kept in the app's data dir (not in
#   backups). Run by autopull. Never fails.
# -----------------------------------------------------------------------------
check_crash_loop() {
  local app_name="$1"
  local data_dir="${APPS_DATA_DIR}/${app_name}"
  local counts_file="${data_dir}/.restart-counts"
  local stamp="${data_dir}/.crash-loop-reported"
  [[ -d "${data_dir}" ]] || return 0

  local -A previous=() props=()
  local unit count prev looping="" counts=""
  if [[ -f "${counts_file}" ]]; then
    while IFS=' ' read -r unit count; do
      if [[ -n "${unit}" ]] && is_counter "${count}"; then
        previous["${unit}"]="${count}"
      fi
    done < "${counts_file}"
  fi

  local -a units=()
  get_app_unit_files "${app_name}" units
  for unit in "${units[@]}"; do
    unit_props "${unit}" props ActiveState Result NRestarts
    count="${props[NRestarts]:-0}"
    is_counter "${count}" || count=0
    counts+="${unit} ${count}"$'\n'
    prev="${previous[${unit}]:-}"
    # Failed after automatic restarts: the start limit (RESTART_LIMIT) ended
    # them. Result shows the last run then (exit-code), not start-limit-hit.
    if [[ "${props[ActiveState]:-}" == "failed" ]] \
        && { [[ "${props[Result]:-}" == "start-limit-hit" ]] || (( count > 0 )); }; then
      looping+="${looping:+, }${unit%.service} (systemd stopped restarting it)"
    elif [[ -n "${prev}" ]] && (( count - prev >= CRASH_LOOP_RESTARTS )); then
      looping+="${looping:+, }${unit%.service} ($((count - prev)) restarts since the last check)"
    fi
  done
  printf '%s' "${counts}" > "${counts_file}" 2>/dev/null || true

  # The stamp only expires, a quiet run does not clear it: an app that
  # crashes about every 40 s shows 2 and 3 restarts in turn and would be
  # reported every 4 minutes
  [[ -n "${looping}" ]] || return 0
  if [[ -f "${stamp}" ]] && [[ -n "$(find "${stamp}" -mmin -60 2>/dev/null)" ]]; then
    return 0
  fi
  touch "${stamp}" 2>/dev/null || true
  log_msg "ERROR" "${app_name}: crash loop: ${looping}. See: appmo logs ${app_name}"
  notify "${app_name}" "crash loop: ${looping} (appmo logs ${app_name})"
  return 0
}

# -----------------------------------------------------------------------------
# Function: cmd_autopull
# Description: Automatically checks all apps for updates and deploys them
# This is designed to run periodically via systemd timer
# -----------------------------------------------------------------------------
cmd_autopull() {
  local lockfile="${APPS_DATA_DIR}/.autopull.lock"

  # Ensure lock directory exists
  local lockdir
  lockdir=$(dirname "${lockfile}")
  mkdir -p "${lockdir}"

  # Use flock for atomic locking to prevent race conditions
  # Open lockfile on file descriptor 9
  exec 9>"${lockfile}"

  if ! flock --nonblock 9; then
    log_msg "INFO" "Another autopull instance is running, exiting"
    exit 0
  fi

  # Write PID to lockfile for debugging (lock is held by flock, not PID file)
  echo $$ >&9

  # Trap will release lock automatically when fd 9 is closed on exit
  # Keep temp-file cleanup: a bare trap here would overwrite the EXIT trap
  # installed at script start
  trap 'exec 9>&-; cleanup_temp_files' EXIT

  log_msg "INFO" "Starting autopull check"

  # Surface an expiring/expired TLS certificate (once a day) in the journal
  [[ "${APPMO_ROLE}" == "admin" ]] && { check_tls_expiry || true; check_acme_cert; secure_appmotel_files; }

  # Check if apps directory exists
  if [[ ! -d "${APPS_CONFIG_DIR}" ]]; then
    log_msg "INFO" "No apps configured yet"
    exit 0
  fi

  # Get list of all apps
  local app_count=0
  local updated_count=0
  local pinned_count=0

  for app_dir in "${APPS_CONFIG_DIR}"/*; do
    if [[ ! -d "${app_dir}" ]]; then
      continue
    fi

    local app_name
    app_name=$(basename "${app_dir}")

    # Skip directories that only have .env.backup (removed apps)
    if ! app_exists "${app_name}"; then
      continue
    fi

    app_count=$((app_count + 1))

    # An isolated app pulls as its own user; then refresh its route
    if is_isolated "${app_name}"; then
      run_appmo_as_app "${app_name}" autopull || log_msg "WARN" "${app_name}: autopull as ${APP_USER_PREFIX}${app_name} failed"
      sync_isolated_traefik "${app_name}" || true
      continue
    fi

    check_crash_loop "${app_name}" || true

    # A rollback pins the app at its commit: no update until appmo unpin
    if [[ -f "${APPS_CONFIG_DIR}/${app_name}/pinned" ]]; then
      pinned_count=$((pinned_count + 1))
      check_app_errors "${app_name}" || log_msg "WARN" "${app_name}: error scan failed (non-fatal)"
      continue
    fi

    # Check app for updates
    local repo_dir="${APPS_DATA_DIR}/${app_name}/repo"

    if [[ ! -d "${repo_dir}" ]]; then
      log_msg "WARN" "${app_name}: Repository directory not found"
      continue
    fi

    cd "${repo_dir}" || { log_msg "WARN" "${app_name}: Cannot change to repository directory"; continue; }

    # Ensure we're in a git repository
    if ! git rev-parse --git-dir > /dev/null 2>&1; then
      log_msg "WARN" "${app_name}: Not a git repository"
      continue
    fi

    # Fetch latest changes (quietly)
    if ! git_with_timeout fetch origin 2>/dev/null; then
      log_msg "ERROR" "${app_name}: Failed to fetch from origin"
      continue
    fi

    # Get current HEAD and remote HEAD. Guarded so one app with a broken
    # HEAD or deleted upstream ref skips instead of killing the whole run.
    local local_head
    local remote_head
    if ! local_head=$(git rev-parse HEAD 2>/dev/null); then
      log_msg "WARN" "${app_name}: Cannot resolve HEAD"
      continue
    fi

    # Get the tracking branch
    local tracking_branch
    tracking_branch=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || echo "")

    if [[ -z "${tracking_branch}" ]]; then
      log_msg "WARN" "${app_name}: No tracking branch configured"
      continue
    fi

    if ! remote_head=$(git rev-parse "${tracking_branch}" 2>/dev/null); then
      log_msg "WARN" "${app_name}: Cannot resolve tracking ref ${tracking_branch}"
      continue
    fi

    # Check if update is needed
    if [[ "${local_head}" != "${remote_head}" ]]; then
      log_msg "INFO" "${app_name}: Update detected (${local_head:0:8} → ${remote_head:0:8})"

      # Trigger update via cmd_update
      if cmd_update "${app_name}"; then
        log_msg "INFO" "${app_name}: Successfully updated"
        updated_count=$((updated_count + 1))
      else
        log_msg "ERROR" "${app_name}: Update failed"
      fi
    fi

    # Check for runtime errors and auto-file GitHub issues via Claude Code
    check_app_errors "${app_name}" || log_msg "WARN" "${app_name}: error scan failed (non-fatal)"
  done

  local pinned_note=""
  [[ ${pinned_count} -eq 0 ]] || pinned_note=" (${pinned_count} pinned by rollback, not updated)"
  if [[ ${app_count} -eq 0 ]]; then
    log_msg "INFO" "No apps found"
  elif [[ ${updated_count} -eq 0 ]]; then
    log_msg "INFO" "Checked ${app_count} app(s), no updates available${pinned_note}"
  else
    log_msg "INFO" "Checked ${app_count} app(s), updated ${updated_count}${pinned_note}"
  fi
}

# -----------------------------------------------------------------------------
# Function: tls_cert_seconds_left
# Description: Print seconds until the default TLS certificate in
#   tls-config.yaml expires (negative once expired). Returns 1 if there is no
#   such certificate or it cannot be read/parsed.
# -----------------------------------------------------------------------------
tls_cert_seconds_left() {
  local tls_config="${TRAEFIK_DYNAMIC_DIR}/tls-config.yaml"
  [[ -f "${tls_config}" ]] || return 1

  local cert_file
  cert_file=$(grep 'certFile:' "${tls_config}" 2>/dev/null | awk '{print $2}' | head -1) || return 1
  [[ -n "${cert_file}" ]] && [[ -r "${cert_file}" ]] || return 1

  local end_date end_epoch
  end_date=$(openssl x509 -in "${cert_file}" -noout -enddate 2>/dev/null | cut -d= -f2) || return 1
  [[ -n "${end_date}" ]] || return 1
  end_epoch=$(date -d "${end_date}" +%s 2>/dev/null) || return 1

  echo $(( end_epoch - $(date +%s) ))
}

# -----------------------------------------------------------------------------
# Function: format_cert_expiry
# Description: Human-readable expiry for a seconds-left value: "expires in 3
#   day(s)" / "EXPIRED 16 hour(s) ago". Hours are used under 2 days so a cert
#   that expired this morning does not read as "0 days".
# -----------------------------------------------------------------------------
format_cert_expiry() {
  local secs="$1"
  local abs=$(( secs < 0 ? -secs : secs ))
  local amount unit
  if (( abs < 172800 )); then
    amount=$(( abs / 3600 )); unit="hour(s)"
  else
    amount=$(( abs / 86400 )); unit="day(s)"
  fi
  if (( secs <= 0 )); then
    echo "EXPIRED ${amount} ${unit} ago"
  else
    echo "expires in ${amount} ${unit}"
  fi
}

# -----------------------------------------------------------------------------
# Function: check_tls_expiry
# Description: Log a WARN/ERROR when the TLS certificate expires within
#   TLS_EXPIRY_WARN_DAYS (default 14) or has expired. Throttled to once per
#   24h via a stamp file so autopull (every 2 min) does not flood the journal.
#   Never fails: this is a report, not a gate.
# -----------------------------------------------------------------------------
check_tls_expiry() {
  local stamp="${APPS_DATA_DIR}/.tls-expiry-check"
  local warn_days="${TLS_EXPIRY_WARN_DAYS:-14}"

  if [[ -f "${stamp}" ]] && [[ -n "$(find "${stamp}" -mmin -1440 2>/dev/null)" ]]; then
    return 0
  fi

  touch "${stamp}" 2>/dev/null || true

  local secs
  if secs=$(tls_cert_seconds_left); then
    if (( secs <= 0 )); then
      log_msg "ERROR" "TLS certificate $(format_cert_expiry "${secs}") - browsers will reject every app"
      log_msg "ERROR" "Check renewal: sudo certbot renew  (journalctl -u certbot)"
      notify "" "TLS certificate $(format_cert_expiry "${secs}"): browsers reject every app (sudo certbot renew)"
    elif (( secs < warn_days * 86400 )); then
      log_msg "WARN" "TLS certificate $(format_cert_expiry "${secs}") - check certbot renewal"
      notify "" "TLS certificate $(format_cert_expiry "${secs}"), check certbot renewal"
    fi
  fi

  # Traefik renews Let's Encrypt certificates 30 days before they expire, so
  # one inside the warning window means renewal keeps failing
  local source names end now
  now=$(date +%s)
  while IFS=$'\t' read -r source names end; do
    [[ "${source}" == "letsencrypt" ]] || continue
    secs=$(( end - now ))
    if (( secs < warn_days * 86400 )); then
      log_msg "WARN" "Let's Encrypt certificate for ${names} $(format_cert_expiry "${secs}") - Traefik cannot renew it (journalctl -u traefik-appmotel)"
      notify "" "Let's Encrypt certificate for ${names} $(format_cert_expiry "${secs}"), Traefik cannot renew it"
    fi
  done < <(list_tls_certs)
  return 0
}

# -----------------------------------------------------------------------------
# Function: cert_end_epoch
# Description: Expiry (epoch seconds) of the first PEM certificate on stdin
# -----------------------------------------------------------------------------
cert_end_epoch() {
  local end_date
  end_date=$(openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2) || return 1
  [[ -n "${end_date}" ]] || return 1
  date -d "${end_date}" +%s 2>/dev/null
}

# -----------------------------------------------------------------------------
# Function: list_tls_certs
# Description: One line "<source>\t<names>\t<expiry epoch>" per certificate
#   Traefik can serve: source "file" for each certFile in tls-config.yaml,
#   "letsencrypt" for each certificate in acme.json (Traefik keeps them there,
#   base64-encoded PEM; read with python3, which install.sh requires).
# Parameters: $1 = acme.json (default ACME_FILE)
# -----------------------------------------------------------------------------
list_tls_certs() {
  local acme_file="${1:-${ACME_FILE}}"
  local tls_config="${TRAEFIK_DYNAMIC_DIR}/tls-config.yaml"
  command -v openssl >/dev/null 2>&1 || return 0
  local cert_file names end b64

  if [[ -f "${tls_config}" ]]; then
    while IFS= read -r cert_file; do
      [[ -n "${cert_file}" ]] && [[ -r "${cert_file}" ]] || continue
      end=$(cert_end_epoch < "${cert_file}") || continue
      names=$(openssl x509 -in "${cert_file}" -noout -ext subjectAltName 2>/dev/null \
        | grep -o 'DNS:[^,[:space:]]*' | sed 's/^DNS://' | paste -sd, -) || names=""
      printf 'file\t%s\t%s\n' "${names:-${cert_file}}" "${end}"
    done < <(sed -n 's/.*certFile:[[:space:]]*//p' "${tls_config}" 2>/dev/null | tr -d "\"'")
  fi

  if [[ -r "${acme_file}" ]] && command -v python3 >/dev/null 2>&1; then
    while IFS=$'\t' read -r names b64; do
      [[ -n "${b64}" ]] || continue
      end=$(base64 -d <<< "${b64}" 2>/dev/null | cert_end_epoch) || continue
      printf 'letsencrypt\t%s\t%s\n' "${names:--}" "${end}"
    done < <(python3 -I -c '
import json, sys
with open(sys.argv[1]) as f:
    data = json.load(f)
for resolver in data.values():
    if not isinstance(resolver, dict):
        continue
    for cert in resolver.get("Certificates") or []:
        domain = cert.get("domain") or {}
        names = [domain.get("main") or ""] + list(domain.get("sans") or [])
        names = ",".join(n for n in names if n) or "-"
        print(names + "\t" + (cert.get("certificate") or ""))
' "${acme_file}" 2>/dev/null || true)
  fi
}

# -----------------------------------------------------------------------------
# Function: cmd_certs
# Description: appmo certs: every certificate Traefik can serve, soonest
#   expiry first, flagged inside TLS_EXPIRY_WARN_DAYS (default 14)
# -----------------------------------------------------------------------------
cmd_certs() {
  [[ $# -eq 0 ]] || die "Usage: appmo certs"
  local warn_days="${TLS_EXPIRY_WARN_DAYS:-14}"
  [[ "${warn_days}" =~ ^[0-9]+$ ]] || warn_days=14
  local -a rows=()
  mapfile -t rows < <(list_tls_certs | sort -t $'\t' -k3,3n)
  if [[ ${#rows[@]} -eq 0 ]]; then
    log_msg "INFO" "No certificates found: tls-config.yaml names none and acme.json has no Let's Encrypt certificate yet"
    return 0
  fi

  local row source names end secs status now
  now=$(date +%s)
  printf '%-12s %-11s %-28s %s\n' SOURCE EXPIRES STATUS NAMES
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r source names end <<< "${row}"
    secs=$(( end - now ))
    status=$(format_cert_expiry "${secs}")
    if (( secs > 0 )) && (( secs < warn_days * 86400 )); then
      status="WARN ${status}"
    fi
    printf '%-12s %-11s %-28s %s\n' "${source}" "$(date -d "@${end}" +%Y-%m-%d)" "${status}" "${names}"
  done
}

# -----------------------------------------------------------------------------
# Function: check_acme_cert
# Description: With Let's Encrypt on, Traefik may give up on the first order
#   (seen: a 404 "Certificate not found" from Let's Encrypt right after
#   issue) and serve its default certificate until it restarts. If it still
#   does so 10 minutes after Traefik started, restart Traefik, at most once
#   an hour (Let's Encrypt allows 5 failed validations per host and hour).
#   Run by autopull. Never fails.
# -----------------------------------------------------------------------------
check_acme_cert() {
  [[ "${USE_LETSENCRYPT:-no}" == "yes" && -n "${BASE_DOMAIN:-}" ]] || return 0
  command -v openssl >/dev/null 2>&1 || return 0
  local stamp="${APPS_DATA_DIR}/.acme-restart"
  if [[ -f "${stamp}" ]] && [[ -n "$(find "${stamp}" -mmin -60 2>/dev/null)" ]]; then
    return 0
  fi

  # An app with a route: Traefik asks for certificates only for routers
  local app="" f
  for f in "${TRAEFIK_DYNAMIC_DIR}"/*.yaml; do
    [[ -f "${f}" ]] || continue
    case "${f##*/}" in tls-config.yaml|default-transport.yaml|redirect-domains.yaml) continue ;; esac
    app="${f##*/}"; app="${app%.yaml}"
    break
  done
  [[ -n "${app}" ]] || return 0

  local started now
  started=$(systemctl show traefik-appmotel -p ActiveEnterTimestamp --value 2>/dev/null) || return 0
  started=$(date -d "${started}" +%s 2>/dev/null) || return 0
  now=$(date +%s)
  (( now - started > 600 )) || return 0

  local subject
  subject=$(echo | timeout 10 openssl s_client -connect "${APPMOTEL_BIND_IP:-127.0.0.1}:443" \
    -servername "${app}.${BASE_DOMAIN}" 2>/dev/null | openssl x509 -noout -subject 2>/dev/null) || return 0
  [[ "${subject}" == *"TRAEFIK DEFAULT CERT"* ]] || return 0

  touch "${stamp}" 2>/dev/null || true
  log_msg "WARN" "Traefik still serves its default certificate for ${app}.${BASE_DOMAIN}: restarting Traefik to retry Let's Encrypt"
  sudo -n systemctl restart traefik-appmotel 2>/dev/null \
    || log_msg "WARN" "Could not restart Traefik (sudo systemctl restart traefik-appmotel)"
  return 0
}

# -----------------------------------------------------------------------------
# Function: fix_cert_permissions
# Description: Check TLS cert readability and fix permissions if needed.
#   Parses tls-config.yaml to find referenced cert/key files, tests if they
#   are readable, and runs the sudo helper to fix permissions if not.
# -----------------------------------------------------------------------------
fix_cert_permissions() {
  local tls_config="${TRAEFIK_DYNAMIC_DIR}/tls-config.yaml"
  if [[ ! -f "${tls_config}" ]]; then
    return
  fi

  # Extract the key file path from tls-config.yaml
  local key_file
  key_file=$(grep 'keyFile:' "${tls_config}" 2>/dev/null | awk '{print $2}') || return
  if [[ -z "${key_file}" ]]; then
    return
  fi

  # Test if the key file is readable by the current user
  if [[ -r "${key_file}" ]]; then
    log_msg "INFO" "TLS certificates are readable"
    return
  fi

  log_msg "WARN" "TLS key not readable: ${key_file}"

  # Try to fix using the helper script
  if [[ -x /usr/local/bin/appmotel-fix-certs ]]; then
    log_msg "INFO" "Fixing certificate permissions..."
    if sudo /usr/local/bin/appmotel-fix-certs; then
      # Verify the fix worked
      if [[ -r "${key_file}" ]]; then
        log_msg "INFO" "Certificate permissions fixed successfully"
      else
        log_msg "ERROR" "Permissions fixed but key still not readable (check ssl-cert group membership)"
      fi
    else
      log_msg "ERROR" "Failed to fix certificate permissions"
      log_msg "ERROR" "Run as root: /usr/local/bin/appmotel-fix-certs"
    fi
  else
    log_msg "ERROR" "Fix-certs helper not found. Re-run: sudo bash install.sh"
  fi
}

# -----------------------------------------------------------------------------
# Function: update_app_domains
# Description: Propagate BASE_DOMAIN changes to all app Traefik routing configs.
#   Scans dynamic configs for Host rules with a stale domain and replaces them
#   with the current BASE_DOMAIN from .env. Also sets up permanent redirects
#   from REDIRECT_BASE_DOMAIN if configured.
# -----------------------------------------------------------------------------
update_app_domains() {
  local current_domain="${BASE_DOMAIN:-}"
  if [[ -z "${current_domain}" ]]; then
    log_msg "WARN" "BASE_DOMAIN not set, skipping domain propagation"
    return
  fi

  local redirect_domain="${REDIRECT_BASE_DOMAIN:-}"

  local updated_count=0
  local redirect_count=0
  local config_file
  for config_file in "${TRAEFIK_DYNAMIC_DIR}"/*.yaml; do
    [[ -f "${config_file}" ]] || continue
    local filename
    filename=$(basename "${config_file}")
    # Skip non-app configs (tls-config, default-transport, redirect-domains, etc.)
    if [[ "${filename}" == "tls-config.yaml" ]] || \
       [[ "${filename}" == "default-transport.yaml" ]] || \
       [[ "${filename}" == "redirect-domains.yaml" ]]; then
      continue
    fi

    # Extract existing domain from the primary router Host rule
    local old_host
    old_host=$(grep -oP 'Host\(`[^.]+\.\K[^`]+' "${config_file}" 2>/dev/null | head -1) || continue
    if [[ -n "${old_host}" ]] && [[ "${old_host}" != "${current_domain}" ]]; then
      # Only update the primary router Host rule, not redirect routers
      sed -i "0,/Host(\`[^.]*\.${old_host}\`)/{s/${old_host}/${current_domain}/}" "${config_file}"
      log_msg "INFO" "Updated domain in ${filename}: ${old_host} -> ${current_domain}"
      updated_count=$((updated_count + 1))
    fi
  done

  if [[ ${updated_count} -gt 0 ]]; then
    log_msg "INFO" "Updated domain in ${updated_count} app config(s)"
  else
    log_msg "INFO" "All app configs already use ${current_domain}"
  fi

  # Set up redirect routers from REDIRECT_BASE_DOMAIN -> BASE_DOMAIN
  if [[ -n "${redirect_domain}" ]] && [[ "${redirect_domain}" != "${current_domain}" ]]; then
    setup_domain_redirects "${redirect_domain}" "${current_domain}"
  fi
}

# -----------------------------------------------------------------------------
# Function: setup_domain_redirects
# Description: Create a single Traefik dynamic config that redirects all app
#   subdomains from the old domain to the new domain using 301 permanent
#   redirects. Uses a regex redirect so one config handles all apps.
# Parameters: $1 = old domain (redirect from), $2 = new domain (redirect to)
# -----------------------------------------------------------------------------
setup_domain_redirects() {
  local old_domain="$1"
  local new_domain="$2"
  local redirect_config="${TRAEFIK_DYNAMIC_DIR}/redirect-domains.yaml"

  # Build YAML with proper escaping:
  # - HostRegexp needs Go regex inside backticks (dots unescaped is fine for domains)
  # - redirectRegex needs escaped dots but YAML double-quoted strings treat \ as escape
  #   so we use \\. which YAML interprets as literal \.
  cat > "${redirect_config}" <<REOF
# Auto-generated: Permanent redirects from ${old_domain} -> ${new_domain}
# Managed by: appmo self-update (REDIRECT_BASE_DOMAIN setting)
http:
  routers:
    domain-redirect:
      rule: "HostRegexp(\`.+.${old_domain}\`)"
      entryPoints:
        - websecure
      middlewares:
        - domain-redirect
      service: noop@internal
      tls: {}
      priority: 1

  middlewares:
    domain-redirect:
      redirectRegex:
        regex: "^https://([^.]+).${old_domain}/(.*)"
        replacement: "https://\${1}.${new_domain}/\${2}"
        permanent: true
REOF

  log_msg "INFO" "Redirect config created: *.${old_domain} -> *.${new_domain} (301)"
}

# -----------------------------------------------------------------------------
# Function: cmd_skill
# Description: Install the Appmotel Claude Code skill into the calling user's
# ~/.claude/skills/appmotel/ directory. Downloads the latest skill files from
# GitHub. Safe to run as any system user; does not require appmotel permissions.
# Usage: appmo skill
# -----------------------------------------------------------------------------
cmd_skill() {
  local target_home="${HOME}"
  local target_user="${USER:-$(id -un)}"

  # When invoked as appmotel via sudo (sudo -u appmotel appmo skill), install
  # into the real caller's home instead of appmotel's.
  if [[ "${target_user}" == "${APPMOTEL_USER}" && -n "${SUDO_USER:-}" ]]; then
    target_user="${SUDO_USER}"
    target_home=$(getent passwd "${SUDO_USER}" | cut -d: -f6)
    [[ -n "${target_home}" ]] || die "Cannot determine home directory for user: ${SUDO_USER}"
  fi

  local target_dir="${target_home}/.claude/skills/appmotel"
  local github_base="https://raw.githubusercontent.com/dirkpetersen/appmotel/main/.claude/skills/appmotel"
  local skill_files=(SKILL.md automation.md security.md testing.md troubleshooting.md)

  log_msg "INFO" "Installing Appmotel skill for user '${target_user}' -> ${target_dir}"

  mkdir -p "${target_dir}"
  local failed=0
  for skill_file in "${skill_files[@]}"; do
    if curl -fsSL "${github_base}/${skill_file}" -o "${target_dir}/${skill_file}"; then
      log_msg "INFO" "  [ok] ${skill_file}"
    else
      log_msg "WARN" "  [fail] ${skill_file}"
      failed=$(( failed + 1 ))
    fi
  done

  if (( failed > 0 )); then
    log_msg "WARN" "${failed} file(s) failed to download. Check your network connection."
  else
    log_msg "INFO" "Appmotel skill installed. Restart Claude Code to load it."
  fi
}

# -----------------------------------------------------------------------------
# Function: cmd_self_update
# Description: Update all appmotel components (appmo CLI, Traefik, configs)
# Downloads and runs the latest install.sh in user mode for full parity
# with a fresh install. Components updated:
#   - appmo CLI binary and shell completion
#   - Traefik binary (latest release)
#   - Traefik static configuration (picks up new settings)
#   - Autopull systemd units
#   - Propagates BASE_DOMAIN changes to all app routing configs
# Note: Traefik service restart requires sudo and is prompted separately.
# -----------------------------------------------------------------------------
cmd_self_update() {
  local github_base="https://raw.githubusercontent.com/dirkpetersen/appmotel/main"
  local install_url="${github_base}/install.sh?$(date +%s)"

  log_msg "INFO" "Updating appmotel components..."
  secure_appmotel_files

  # Download latest install.sh to temp file
  local tmp_install
  tmp_install=$(create_temp_file "install-update")
  if ! curl -fsSL "${install_url}" -o "${tmp_install}"; then
    die "Failed to download latest install.sh from GitHub"
  fi

  # Run user-level installation (same code path as fresh install)
  # install.sh detects non-root and runs run_as_appmotel_user() which updates:
  #   download_traefik, generate_traefik_config, install_appmo_cli,
  #   install_autopull, setup_path
  log_msg "INFO" "Running latest install.sh (user-level)..."
  if bash "${tmp_install}"; then
    log_msg "INFO" "All appmotel components updated successfully"
  else
    die "Self-update failed during install.sh execution"
  fi

  # Re-source .env to pick up any BASE_DOMAIN changes
  if [[ -f "${APPMOTEL_ENV_FILE}" ]]; then
    local _saved_ifs="${IFS}"
    IFS=$' \t\n'
    # shellcheck source=/dev/null
    source "${APPMOTEL_ENV_FILE}"
    IFS="${_saved_ifs}"
  fi

  # Propagate BASE_DOMAIN to all app Traefik routing configs
  update_app_domains

  # Rebuild app routes, so TLS changes (e.g. LETSENCRYPT_MODE) reach them
  local app_conf app_name port
  for app_conf in "${APPS_CONFIG_DIR}"/*/; do
    app_name=$(basename "${app_conf}")
    app_exists "${app_name}" || continue
    if is_isolated "${app_name}"; then
      sync_isolated_traefik "${app_name}" || true
    elif port=$(get_port_from_env "${app_name}"); then
      create_traefik_config "${app_name}" "${port}" "${BASE_DOMAIN:-apps.example.edu}" "${app_conf}.env" || true
    fi
  done

  # Check and fix TLS certificate permissions
  fix_cert_permissions

  # Restart Traefik to pick up binary/config/cert changes
  log_msg "INFO" "Restarting Traefik service..."
  if sudo systemctl restart traefik-appmotel 2>/dev/null; then
    log_msg "INFO" "Traefik restarted successfully"
  else
    log_msg "WARN" "Could not restart Traefik automatically"
    log_msg "WARN" "Run manually: sudo systemctl restart traefik-appmotel"
  fi
}

# -----------------------------------------------------------------------------
# Function: secure_appmotel_files
# Description: The appmotel home is world-traversable (751) for the appmo
# symlink, and app paths are well known, so app .env files, AWS keys,
# certs and tool state must be closed by mode, not only by obscurity. Isolated app
# users depend on this. Same code in install.sh and bin/appmo.
# -----------------------------------------------------------------------------
secure_appmotel_files() {
  # Close everything in the home except ~/.local/bin (needed by the appmo
  # symlink); tools such as Claude Code (auto-debug) create 644 files in 755
  # dirs, so naming single dirs is not enough. Also run by autopull.
  find "${APPMOTEL_HOME}" -mindepth 1 -maxdepth 1 ! -name .local -exec chmod go-rwx {} + 2>/dev/null || true
  if [[ -d "${APPMOTEL_HOME}/.local" ]]; then
    chmod 755 "${APPMOTEL_HOME}/.local"
    find "${APPMOTEL_HOME}/.local" -mindepth 1 -maxdepth 1 ! -name bin -exec chmod go-rwx {} + 2>/dev/null || true
  fi
  if [[ -d "${APPMOTEL_HOME}/.config/appmotel" ]]; then
    find "${APPMOTEL_HOME}/.config/appmotel" -type f \( -name '.env' -o -name '.env.*' \) -exec chmod 600 {} +
  fi
  return 0
}

# -----------------------------------------------------------------------------
# Function: refresh_app_list
# Description: Writes the app names to ~/.local/bin/.appmo-apps (mode 644),
#   the only folder of appmotel that others may read, so that tab completion
#   works for members of appmotel-users. App names are not secret (they are
#   host names). Run after add/isolate/remove and by every autopull.
# -----------------------------------------------------------------------------
refresh_app_list() {
  [[ "${APPMO_ROLE}" == "admin" && -d "${APPMOTEL_HOME}/.local/bin" ]] || return 0
  local list="${APPMOTEL_HOME}/.local/bin/.appmo-apps" tmp
  tmp=$(mktemp "${list}.XXXXXX") || return 0
  # Only folders of real apps (install.sh also makes other folders here)
  find "${APPS_CONFIG_DIR}" -mindepth 2 -maxdepth 2 \( -name metadata.conf -o -name isolated.conf \) \
    -printf '%h\n' 2>/dev/null | sed 's|.*/||' | sort -u > "${tmp}" || true
  chmod 644 "${tmp}"
  mv -f "${tmp}" "${list}"
}

# -----------------------------------------------------------------------------
# Function: main
# Description: Main CLI dispatcher
# -----------------------------------------------------------------------------
main() {
  if [[ $# -eq 0 ]]; then
    usage
  fi

  local command="$1"
  shift

  # Commands for an isolated app run as its user; then appmotel rebuilds the
  # Traefik route, as the app user may have changed PORT or rate limits
  if [[ $# -ge 1 ]] && is_isolated "$1"; then
    case "${command}" in
      remove|rm)
        remove_isolated "$1"
        refresh_app_list
        return
        ;;
      status|start|stop|restart|update|check|logs|env|exec|backup|restore|backups|rollback|unpin|backup-verify)
        local rc=0
        run_appmo_as_app "$1" "${command}" "$@" || rc=$?
        case "${command}" in
          start|restart|update|env|restore|rollback) sync_isolated_traefik "$1" || true ;;
        esac
        return "${rc}"
        ;;
    esac
  fi

  if [[ "${APPMO_ROLE}" == "app" ]]; then
    case "${command}" in
      self-update|isolate|certs) die "'appmo ${command}' must be run by appmotel or an operator" ;;
    esac
  fi

  case "${command}" in
    add) cmd_add "$@" ;;
    isolate) cmd_isolate "$@" ;;
    remove|rm) cmd_remove "$@" ;;
    list|ls) cmd_list "$@" ;;
    status) cmd_status "$@" ;;
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    restart) cmd_restart "$@" ;;
    update) cmd_update "$@" ;;
    check) cmd_check "$@" ;;
    autopull) cmd_autopull "$@" ;;
    logs) cmd_logs "$@" ;;
    env) cmd_env "$@" ;;
    exec) cmd_exec "$@" ;;
    backup) cmd_backup "$@" ;;
    restore) cmd_restore "$@" ;;
    backups) cmd_backups "$@" ;;
    backup-verify) cmd_backup_verify "$@" ;;
    rollback) cmd_rollback "$@" ;;
    unpin) cmd_unpin "$@" ;;
    top) cmd_top "$@" ;;
    certs) cmd_certs "$@" ;;
    self-update) cmd_self_update "$@" ;;
    skill) cmd_skill "$@" ;;
    -h|--help|help) usage ;;
    *) die "Unknown command: ${command}. Use 'appmo --help' for usage." ;;
  esac

  case "${command}" in
    add|isolate|remove|rm|autopull|self-update) refresh_app_list ;;
  esac
}

main "$@"
